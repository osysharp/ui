  }
}

/// Somewhere else to go.
[Route("/desk/quote")] [Layout(DeskShell)] [Authorize(IsFramer)] [Render(CSR)] [Title("Quote")]
component DeskQuotePage() {
  render { Stack(gap: 4, p: 6) { PageHead("Quote"); Text("Prices by the metre."); } }
}
