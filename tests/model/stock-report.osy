// THE STOCK REPORT — two pages that read the server on the way in, so each has a moment when it is still loading:
// one loads in `on mount` (a server function, the way a report is read), one through a `live var`. Each draws its
// SHAPE meanwhile — the kit's `SkeletonCard` with the card's real title, and a `LoadingNote` — and fills in when the
// read lands (`tests/loading.test.osy` holds the server to look at the moment in between).

/// What the stock report says: how many mouldings, on how many shelves.
public sealed class StockSummary {
  public int Mouldings;
  public int Shelves;
}

/// The stock in two numbers — a server read, as a report is.
StockSummary StockReport() {
  return new StockSummary {
    Mouldings = Moulding.Count(),
    Shelves = Moulding.Select(m => m.Shelf).Distinct().Count()
  };
}

/// The report, loaded in `on mount` — its skeleton shows while that first read is out.
[Route("/stock/report")] [Authorize(IsFramer)] [Render(CSR)] [Title("Stock report")]
component StockReportPage() {
  StockSummary summary = new StockSummary();
  on mount { summary = StockReport(); }

  skeleton {
    Stack(gap: 3, p: 6) {
      PageTitle("Stock report");
      LoadingNote();
      SkeletonCard("Shelves", lines: 2);
    }
  }
  render {
    Stack(gap: 3, p: 6) {
      PageTitle("Stock report");
      Card("Shelves") {
        Stack(gap: 3) {
          Text($"{summary.Mouldings} mouldings");
          Text($"on {summary.Shelves} shelves");
        }
      }
    }
  }
}

/// The shelves, read through a `live var` — its skeleton shows while the rows are on their way.
[Route("/stock/shelves")] [Authorize(IsFramer)] [Render(CSR)] [Title("Shelves")]
component ShelvesPage() {
  live var mouldings = Moulding.OrderBy(m => m.Shelf).ToList();

  skeleton {
    Stack(gap: 3, p: 6) {
      PageTitle("Shelves");
      LoadingNote("Reading the shelves…");
      SkeletonCard("On the shelves", lines: 3);
    }
  }
  render {
    Stack(gap: 3, p: 6) {
      PageTitle("Shelves");
      Card("On the shelves") {
        Stack(gap: 3) { foreach (var m in mouldings) { Text(m.Moniker); } }
      }
    }
  }
}

/// The mouldings on the books — a server read the stockroom's frame below asks as a live call.
List<Moulding> OnTheBooks() { return Moulding.ToList(); }

/// The stockroom's frame: a layout that reads the server itself — a live list and a live server call, with no
/// `skeleton { }` — so its Outlet, and the page in it, wait until both land (FM-41, FM-70). Under a held server that is
/// the screen `Ui.Visit` returns on (FM-95).
[Layout]
[Authorize(IsFramer)]
component StockroomFrame() {
  live var shelved = Moulding.ToList();
  live var books = OnTheBooks();
  render {
    Stack(gap: 3, p: 6) {
      Text("Stockroom");
      Text($"{books.Count()} on the books, {shelved.Count()} shelved");
      Outlet();
    }
  }
}

/// A page in that frame.
[Route("/stock/counter")] [Authorize(IsFramer)] [Render(CSR)] [Layout(StockroomFrame)] [Title("Counter")]
component StockCounterPage() {
  render { Text("The counter is open"); }
}

/// The report again, read through a `live var` that CALLS the server function — asked once, and again when a moulding
/// changes. Its skeleton shows while that answer is out (FM-111: a held server keeps it back like any server call).
[Route("/stock/live-report")] [Authorize(IsFramer)] [Render(CSR)] [Title("Live stock report")]
component LiveStockReportPage() {
  live var summary = StockReport();

  skeleton {
    Stack(gap: 3, p: 6) {
      PageTitle("Live stock report");
      LoadingNote("Counting the stock…");
    }
  }
  render {
    Stack(gap: 3, p: 6) {
      PageTitle("Live stock report");
      Text($"{summary.Mouldings} mouldings counted");
    }
  }
}
