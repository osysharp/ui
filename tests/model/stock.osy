// THE WORKSHOP'S STOCK — more mouldings and suppliers than one answer to a page carries. A page's read is served about
// 2 MB of rows an answer, and a moulding carries its whole profile sheet, so a long stock list is a WINDOW: the stock
// table pages (`DataGrid` draws "Load more" itself), the stock list pages through `LoadMoreButton`, and a purchase
// picks its supplier with a `SearchPicker` the database answers as the framer types.

/// A moulding profile the workshop stocks, with its full specification sheet.
entity Moulding {
  [Required, MaxLength(120)] string Moniker;
  int Shelf;
  [MaxLength(9000)] string Specification = "";
  security { allow read, create when IsFramer; }
}

/// Somebody the workshop buys from.
entity Supplier {
  [Required, MaxLength(120)] string Name;
  [MaxLength(9000)] string Terms = "";
  security { allow read, create when IsFramer; }
}

/// The stock as a table — every moulding, shelf by shelf.
[Route("/stock")] [Authorize(IsFramer)] [Render(CSR)] [Title("Stock")]
component StockPage() {
  live var mouldings = Moulding.OrderBy(m => m.Shelf).ToList();
  render {
    Stack(gap: 3, p: 6) {
      PageTitle("Stock");
      DataGrid("Mouldings", rows: mouldings,
               columns: [ new GridColumn<Moulding> { Name = "Moniker", Label = "Moniker", Value = m => m.Moniker } ]);
    }
  }
}

/// The stock by shelf, in the order the page reads it: no column can be sorted by, so the order is the page's.
[Route("/stock/by-shelf")] [Authorize(IsFramer)] [Render(CSR)] [Title("Stock by shelf")]
component StockByShelfPage() {
  live var mouldings = Moulding.OrderBy(m => m.Shelf).ToList();
  render {
    Stack(gap: 3, p: 6) {
      PageTitle("Stock by shelf");
      DataGrid("Mouldings by shelf", rows: mouldings,
               columns: [ new GridColumn<Moulding> { Name = "Moniker", Label = "Moniker", Value = m => m.Moniker, Sortable = false },
                          new GridColumn<Moulding> { Name = "Shelf", Label = "Shelf", Value = m => m.Shelf.ToString(), Sortable = false } ]);
    }
  }
}

/// The stock opening on its highest shelf: the Shelf column says `Sort = UiSort.Descending`, so the rows ARRIVE in that
/// order — whatever order the page read them in, and although Shelf is not the first column.
[Route("/stock/top-shelf-first")] [Authorize(IsFramer)] [Render(CSR)] [Title("Stock, top shelf first")]
component StockTopShelfFirstPage() {
  live var mouldings = Moulding.OrderBy(m => m.Moniker).ToList();
  render {
    Stack(gap: 3, p: 6) {
      PageTitle("Stock, top shelf first");
      DataGrid("Mouldings, top shelf first", rows: mouldings,
               columns: [ new GridColumn<Moulding> { Name = "Moniker", Label = "Moniker", Value = m => m.Moniker },
                          new GridColumn<Moulding> { Name = "Shelf", Label = "Shelf", Value = m => m.Shelf.ToString(),
                                                     Number = m => m.Shelf, Kind = GridColumnKind.Number,
                                                     Sort = UiSort.Descending } ]);
    }
  }
}

/// A column that FORMATS a number ("84") says which number it holds (`Number =`), and the reader's sort orders by that —
/// not by the spelling, which puts 84 before 9. The rows arrive by name, so only the click can put them in numeric order.
[Route("/stock/by-count")] [Authorize(IsFramer)] [Render(CSR)] [Title("Stock by count")]
component StockByCountPage() {
  live var mouldings = Moulding.OrderBy(m => m.Moniker).ToList();
  render {
    Stack(gap: 3, p: 6) {
      PageTitle("Stock by count");
      DataGrid("Mouldings by count", rows: mouldings,
               columns: [ new GridColumn<Moulding> { Name = "Moniker", Label = "Moniker", Value = m => m.Moniker },
                          new GridColumn<Moulding> { Name = "Shelf", Label = "Shelf", Value = m => $"{m.Shelf:N0}",
                                                     Number = m => m.Shelf } ]);
    }
  }
}

/// The same stock as a plain list, paged by the button under it.
[Route("/stock/list")] [Authorize(IsFramer)] [Render(CSR)] [Title("Stock list")]
component StockListPage() {
  live var mouldings = Moulding.OrderBy(m => m.Shelf).ToList();
  render {
    Stack(gap: 1, p: 6) {
      PageTitle("Stock list");
      foreach (var m in mouldings) { Text(m.Moniker); }
      LoadMoreButton(mouldings, label: "More mouldings");
    }
  }
}

/// DES-BOUNDED-READS-5 — the same stock as `Rows`: a page of 50, the next one as the reader scrolls (or presses "Load
/// more"), each read just past the last row held. Over ten thousand mouldings its first paint reads one page: 4
/// statements (the page of 50 mouldings and the lookups that sign the framer in: the person twice and their role grant)
/// and 54 rows (50 + the one row past the page that says more lie past it + 3 sign-in rows). No COUNT of the set: it used
/// to take a fifth statement on every page (DES-BOUNDED-READS-4). The budget allows one more of each, for a cold platform.
[Route("/stock/rows")] [Authorize(IsFramer)] [Render(CSR)] [Title("Stock rows")]
[PageBudget(Statements = 5, Rows = 55, Seed = TenThousandMouldings, As = Pia)]
component StockRowsPage() {
  live var mouldings = Moulding.OrderBy(m => m.Moniker);
  render {
    Stack(gap: 1, p: 6) {
      PageTitle("Stock rows");
      Rows(mouldings, label: "Mouldings") { m => Text(m.Moniker); }
    }
  }
}

/// DES-BOUNDED-READS-5b — `Rows` handed the query itself, not a `live var` holding it: it pages the same way.
[Route("/stock/rows-inline")] [Authorize(IsFramer)] [Render(CSR)] [Title("Stock rows inline")]
[PageBudget(Statements = 5, Rows = 55, Seed = TenThousandMouldings, As = Pia)]
component StockRowsInlinePage() {
  render {
    Stack(gap: 1, p: 6) {
      PageTitle("Stock rows inline");
      Rows(Moulding.OrderBy(m => m.Moniker), label: "Mouldings") { m => Text(m.Moniker); }
    }
  }
}

/// A purchase: the supplier is found by typing, not by scrolling every supplier the workshop has ever used.
[Route("/purchase")] [Authorize(IsFramer)] [Render(CSR)] [Title("Purchase")]
component PurchasePage() {
  string find = "";
  Supplier? supplier = null;
  live var matches = Supplier.Where(s => s.Name.Contains(find)).OrderBy(s => s.Name).Take(20).ToList();
  render {
    Stack(gap: 3, p: 6) {
      PageTitle("Purchase");
      SearchPicker("Supplier", value: supplier, search: find, options: matches) { s => Text(s.Name); }
      if (supplier != null) { Text("Buying from " + supplier.Name); }
    }
  }
}
