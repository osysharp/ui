[Composable, Part]
component WorkbenchExplorer(NavItem section, string current, Action onNavigated) {
  action Go(string to) { Navigation.Go(to); onNavigated(); }
  render { WorkbenchExplorerGuarded(section, current, onNavigated, Go) { Slot; } }
}
