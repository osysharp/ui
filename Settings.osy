// Ui — THE SETTINGS AREA (`using Osysharp.Ui;`): one layout and navigation for an app's admin and configuration pages, explicit save and discard on the page's unit of
// work (with undo through its savepoints), "who changed this and when", and sections a person may see but not change.
//
// ⭐ SO EVERY APP'S ADMIN LOOKS AND BEHAVES ALIKE: the nav is a column of the area's sections, grouped, with the current
//   one lit; a section is a page of `SettingsSection`s — a heading and a line on the left, its controls on the right; and
//   nothing is saved until the person says so, from a bar that appears only when there is something to save.
//
// ⚑ THE AREA SITS INSIDE THE APP'S OWN SHELL — it is a page region, not a shell. `SettingsFrame` puts it inside the
//   app's design of `WorkspaceShell` (Slots.osy), so the app's top bar, its sidebar and its account menu stay where they
//   are on every settings page, the kits' included:
//     component MyShell() : WorkspaceShell { render { AppShell(chrome) { Slot; } } }
//
// ⭐ KITS ANNOUNCE THEIR SECTIONS. A kit with something an admin configures implements
//   `ISettingsProvider` and ships the pages its links open, under `[Layout(SettingsFrame)]`. `SettingsArea()` with no list
//   gathers every provider in the app — the app's own and every kit's — so adding a kit adds its settings, and the whole
//   app's configuration reads as one place. Nobody wires a provider: it is DISCOVERED (`App.Implementations<T>()`).
//   An app MOVES a section — a kit's included — to a group and place of its own with `ISettingsPlacement`, and passes
//   its own list (`SettingsArea(MyLinks())`) to hide sections or build the nav itself — the escape hatch.
//
// ⚑ THE APP DESIGNS `WorkspaceShell` ONCE and every kit's settings page sits in the app's shell with no wiring; it may
//   still take `SettingsFrame` over by name (a component of the same name, the rule an app's own `Card` follows over the
//   kit's) when its settings want a frame of their own.

namespace Osysharp.Ui;

/// A contract a kit (or the app) implements to ANNOUNCE its settings sections — discovered, never wired: `SettingsArea()`
/// with no list shows every provider's sections, grouped. Each link opens a page the provider ships (or the app's own,
/// taking it over by name), and that page carries its own `[Authorize]` — a link's `Shown` only keeps the nav honest.
/// need: a kit announces its settings pages, every kit's settings in one place, settings registry, plug a settings section into the app's settings
/// e.g. `class MailSettings : ISettingsProvider { public SettingsLink[] Sections() { return [new SettingsLink { Label = "Mail", To = "/settings/mail", Group = "Mail", Shown = ManagesMail }]; } }`
public interface ISettingsProvider {
  /// The sections this provider offers the reader, each with `Shown` set from the provider's own policy.
  SettingsLink[] Sections();
}

/// Every section every `ISettingsProvider` in the app announces, the ones this reader is shown, grouped and ordered: a
/// group sits where its lowest `Order` puts it (ties by the group's name), and within a group by `Order`, then by label.
/// What `SettingsArea()` shows — and where an app starts when it wants the kits' sections in a list of its own.
public List<SettingsLink> AnnouncedSettings() {
  List<SettingsLink> all = [];
  foreach (var provider in App.Implementations<ISettingsProvider>()) {
    foreach (var link in provider.Sections()) {
      if (link.Shown) { all.Add(link); }
    }
  }
  // Where the app says a section sits (`ISettingsPlacement`), before anything is grouped or ordered — so a kit's
  // section moved into one of the app's groups is ordered among that group's own.
  foreach (var placing in App.Implementations<ISettingsPlacement>()) {
    foreach (var place in placing.Placements()) {
      foreach (var link in all) {
        if (link.To != place.To) { continue; }
        if (place.Group != null) { link.Group = place.Group!; }
        if (place.Order != null) { link.Order = place.Order!.Value; }
      }
    }
  }
  List<SettingsLink> ordered = [];
  // A section with NO group comes first, before every heading. Placed by its `Order` like a group, it landed after
  // whichever headed group sorted before it and read as one of that group's — in Harbour, "Time and date", "Feedback"
  // and "Knowledge base" sat under "You", the heading of a person's own preferences.
  foreach (var group in all.Select(s => s.Group).Distinct().OrderBy(g => g).ToList()
                           .OrderBy(g => all.Where(s => s.Group == g).Min(s => s.Order)).ToList()
                           .OrderBy(g => g == "" ? 0 : 1).ToList()) {
    foreach (var link in all.Where(s => s.Group == group).OrderBy(s => s.Label).ToList().OrderBy(s => s.Order).ToList()) {
      ordered.Add(link);
    }
  }
  return ordered;
}

/// A contract an APP implements to say WHERE a section sits in its settings area — the group it is listed under and
/// its place there — whoever announced it: a kit's `ISettingsProvider`, a kit's declared `[Settings]` row, or the app's
/// own. Discovered like a provider, never wired, and applied by `AnnouncedSettings()`, so the nav, the overview and a
/// list an app builds from the announced sections all agree. A section it does not name stays where its provider put it.
/// It moves a link and nothing else: who is shown it (`Shown`) and who may open its page stay the provider's.
/// need: move a kit's settings link to another group, put a package's settings section under my own heading, reorder the settings nav, rename the group a kit's settings page is listed under
/// e.g. `class DeskPlacement : ISettingsPlacement { public SettingsPlacement[] Placements() { return [new SettingsPlacement { To = "/settings/access", Group = "Security", Order = 40 }]; } }`
public interface ISettingsPlacement {
  /// Each section this app places, named by its route.
  SettingsPlacement[] Placements();
}

/// Where one settings section sits (`ISettingsPlacement`): the section, by its route, and the group and order it takes.
/// A value left out keeps what the section's provider said.
public sealed class SettingsPlacement {
  /// The section's route — the `To` its provider announced it with (`/settings/access`).
  public string To = "";
  /// The group it is listed under; `""` lists it before every heading. Left out, the provider's group stays.
  public string? Group = null;
  /// Its place in a gathered area, as `SettingsLink.Order`. Left out, the provider's order stays.
  public int? Order = null;
}

/// What a declared settings page (`[Settings]`) reads of its row beside the values, in ONE call: the fields its
/// organisation locks, who last changed each group ("Changed by Ada · 3 min ago"), and on a scoped section who last set
/// each field.
public sealed class SettingsRowFacts {
  public List<string> Locked = [];
  public List<string> Changed = [];
  public List<string> SetBy = [];
}

/// A contract a provider implements BESIDE `ISettingsProvider` to say what is set in its sections ("2 overrides") —
/// asked only by a nav that shows counts (`SettingsArea(nav: SettingsNavLook.List)`), so a count that costs a read is
/// never paid on a page that does not say it. Each link names its section by `To` and carries its `Count` ("" says
/// nothing). A declared section kept per scope (`[Settings(Scope = …)]`) implements it for you.
/// need: a count beside a settings section's link, how many overrides a section has, a badge in the settings nav
/// e.g. `class MailCounts : ISettingsCounts { public SettingsLink[] Counts() { return [new SettingsLink { Label = "Mail", To = "/settings/mail", Count = "3 rules" }]; } }`
public interface ISettingsCounts {
  /// Each of this provider's sections' counts, by route.
  SettingsLink[] Counts();
}

/// What every `ISettingsCounts` in the app says is set in its sections — each link's `To` and `Count`, the empty ones
/// left out. What `SettingsArea(nav: SettingsNavLook.List)` says beside each section.
public List<SettingsLink> AnnouncedCounts() {
  List<SettingsLink> all = [];
  foreach (var provider in App.Implementations<ISettingsCounts>()) {
    foreach (var link in provider.Counts()) {
      if (link.Count != "") { all.Add(link); }
    }
  }
  return all;
}

/// Where an organisation's policy reaches into an app's settings — implemented by the org layer's package, never by an
/// app or a kit. Discovered like a settings provider: with none in the app, no setting is the
/// organisation's. `setting` is the key `osy model` lists for an `[OrgPolicy]` field — "Osysharp.Privacy.PrivacySetup.ReviewPlans"
/// — the one name an organisation's rule uses for the setting across every app, so it is data here, not a reference.
/// A kit or an app never writes that key: it asks `SetByOrganization<T>(x => x.Field)`, which the compiler turns into it.
public interface IOrgPolicySource {
  /// Whether the organisation sets `setting` for this app, so the app may not change it (`OrgPolicyMode.Lock`).
  bool Sets(string setting);
}

/// Whether a setting is set by the reader's organisation — named by its MEMBER, `SetByOrganization<PrivacySetup>(p =>
/// p.ReviewPlans)`, so a renamed field is a compile error rather than a setting that silently stops being governed. The
/// field must be marked `[OrgPolicy]`. Its section then says "Set by your organization" and its controls are not the
/// app's to change (`SettingsSection(…, setByOrganization: true)`). ⚑ THE SEAM, NOT THE POLICY: it asks every
/// `IOrgPolicySource`, and until the org layer supplies one it answers false for every setting. A `[Settings]` section
/// asks it for each of its `[OrgPolicy(OrgPolicyMode.Lock)]` fields on its own.
/// need: is this setting locked by the organisation, a setting the organisation controls
/// e.g. `bool locked = SetByOrganization<ReviewSettings>(s => s.PublishAtOnce);`
public bool SetByOrganization(string setting) {
  return App.Implementations<IOrgPolicySource>().Any(s => s.Sets(setting));
}

/// Where a `[Settings]` section learns who last changed it — implemented by the compiler in an app that keeps a change
/// trail (`use Osysharp.Observability;`), never by hand. With none, a section shows no "Changed by" line, because nothing
/// recorded who changed it.
public interface ISettingsHistory {
  /// The latest change a PERSON made to any of `fields` of the `settings` row `id` (an entity's full name), or null.
  SettingsChange? LastChange(string settings, Guid id, string[] fields);
}

/// One change to a settings row — who made it and when.
public sealed class SettingsChange {
  public string By = "";
  public DateTime At;
}

/// "Changed by Ada Lindqvist · 3 min ago" for the latest change to `fields` of the settings row `id`, or "" when the app
/// keeps no change trail or nobody has changed them.
public string SettingsChangedLine(string settings, Guid id, string[] fields, DateTime now) {
  foreach (var history in App.Implementations<ISettingsHistory>()) {
    var change = history.LastChange(settings, id, fields);
    if (change != null) { return ChangedBy(change.By, change.At, now); }
  }
  return "";
}

/// "by Ada Lindqvist · 3 min ago" — who last set ONE field of the settings row `id`, for a provenance line ("Set here
/// by …"); "" when the app keeps no change trail or nobody has changed it.
public string SettingSetBy(string settings, Guid id, string field, DateTime now) {
  foreach (var history in App.Implementations<ISettingsHistory>()) {
    var change = history.LastChange(settings, id, [field]);
    if (change != null) { return $"by {(change.By != "" ? change.By : "the system")} · {TimeAgo(change.At, now)}"; }
  }
  return "";
}

/// The route of the section `path` is in — the LONGEST section route that is `path` or a prefix of it, so a page under
/// `/settings/privacy/holds` lights "Legal holds" and not "Data retention" at `/settings/privacy` as well. "" when none.
public string CurrentSettingsSection(List<SettingsLink> sections, string path) {
  var best = "";
  foreach (var s in sections) {
    if (s.To == "" || s.To.Length <= best.Length) { continue; }
    if (path == s.To || path.StartsWith(s.To + "/")) { best = s.To; }
  }
  return best;
}

/// One entry in a settings area's navigation — a section of the app's settings.
public sealed class SettingsLink {
  /// What the reader sees, and the accessible name of the row.
  public string Label;
  /// The section's route — `/settings/people`.
  public string To = "";
  /// The group it is listed under ("Your team", "The desk") — entries of one group sit together, under its name.
  public string Group = "";
  public Icons Icon = Icons.Gear;
  /// A line under the label, for the area's own index on a phone — "Who works here, and what each may do".
  public string Hint = "";
  /// Whether this reader is shown it at all — the app's own policy, as a value: `Shown = IsAdmin`. A section a person
  /// may not open is left out of the nav (the page is still gated by its own `[Authorize]`; this only keeps the nav honest).
  public bool Shown = true;
  /// Where it sits in a gathered area (`SettingsArea()`): lower first, within its group — and a group sits where its
  /// lowest entry puts it. Kits leave gaps (10, 20, …) so an app's own sections can go between them.
  public int Order = 100;
  /// What is set there, said beside it in a `SettingsArea(nav: SettingsNavLook.List)` ("2 overrides") — empty says nothing.
  /// A count that costs a read belongs in an `ISettingsCounts` instead, which only a nav that shows it asks; a
  /// `[Settings(Scope = …)]` section counts the scopes that set their own values there.
  public string Count = "";
}

/// The settings area: the sections on the left (grouped, the current one lit), the section's page on the right. On a
/// phone the nav is the area's first screen — the area's own route (`home`) — and each section is a screen of its own,
/// with a way back. Fill the default slot with the section's page (`Outlet` in a layout).
/// With NO list it gathers every `ISettingsProvider` in the app (`AnnouncedSettings()`) — each kit's sections and the
/// app's own; pass a list to choose them yourself.
/// The nav is `Length.SettingsNavW` wide on a wide screen, its current row `Colors.SettingsNavCurrent` (`osy docs ui-settings#look`).
/// ⭐ THE APP'S OWN PARTS GO IN ITS SLOTS: `slot home` is the area's home on a wide screen IN PLACE OF the kit's
///   overview (`SettingsOverview`, which is what an unfilled one draws); `slot head` sits above every page (and the
///   home). `nav: SettingsNavLook.List` draws the sections as the editing parts' section list (`SectionGroup`,
///   `SectionLink`) rather than rows with icons. To put the area in a frame of its own, an app's `[Layout]` hands its
///   `Outlet` to a component of its own that draws the area: `WorkshopFrame { Outlet; }` (`osy docs ui-settings#frame`).
/// In a test the nav is a named region, "<title> sections": `Ui.Click("People", within: "Settings sections")`.
/// need: an admin area, a settings page with sections in a sidebar, configuration pages that share one navigation, my own settings home page, a banner above every settings page
/// e.g. `SettingsArea() { Outlet; }` · `SettingsArea([new SettingsLink { Label = "People", To = "/settings/people", Group = "Team", Shown = IsAdmin }]) { Outlet; }`
/// e.g. `SettingsArea(nav: SettingsNavLook.List) { slot home { MySettingsHome(); } Outlet; }`
[Composable]
component SettingsArea(SettingsLink[]? sections = null, string title = "Settings", string home = "/settings",
                       SettingsNavLook nav = SettingsNavLook.Rows) {
  // The announced sections, read once the area mounts — a layout's area mounts once and stays while its pages change.
  List<SettingsLink> announced = [];
  // What the sections' `ISettingsCounts` say — read only by the nav that shows counts, so the rows nav pays nothing.
  List<SettingsLink> counted = [];
  bool gathered = false;
  on mount {
    if (sections == null) { announced = AnnouncedSettings(); }
    if (nav == SettingsNavLook.List) { counted = AnnouncedCounts(); }
    gathered = true;
  }
  live var shown = sections != null ? sections.Where(s => s.Shown).ToList() : announced;
  live var path = Navigation.CurrentPath ?? "";
  live var atHome = path == home || path == home + "/";
  live var currentTo = CurrentSettingsSection(shown, path);

  /// Is `link` the section being looked at — see `CurrentSettingsSection`.
  bool Current(SettingsLink link) { return link.To != "" && link.To == currentTo; }

  /// What is said beside `link` in the list nav: its own `Count`, else what an `ISettingsCounts` says of its route.
  string CountOf(SettingsLink link) {
    if (link.Count != "") { return link.Count; }
    foreach (var c in counted) {
      if (c.To == link.To) { return c.Count; }
    }
    return "";
  }

  render {
    Row(align: Align.Stretch, gap: 0, h: "100%", minH: "0", w: "100%") {
      if (atHome || Layout.AtLeast(Tablet)) {
        Stack(gap: 1, w: Layout.AtLeast(Tablet) ? Length.SettingsNavW : "100%", shrink: 0, p: 3, borderRW: 1, border: Colors.Border,
              overflowY: Overflow.Auto, bg: Colors.Surface, role: UiRole.Navigation, label: title + " sections") {
          Text(title, fontWeight: FontWeight.Semibold, fontSize: FontSize.Subhead, px: 2, py: 2);
          // Nothing to set up — no provider in the app announces a section this reader is shown: said, never a blank column.
          if (gathered && shown.Count == 0) {
            Stack(gap: 2, px: 2, py: 4, label: "Nothing to set up") {
              Icon(Icons.Gear, size: 20, color: Colors.TextMuted);
              Text("Nothing to set up", fontWeight: FontWeight.Medium);
              Text("Sections appear here as the app and its kits offer settings you may change.", fontSize: FontSize.Caption,
                   color: Colors.TextMuted);
            }
          }
          foreach (var group in shown.Select(s => s.Group).Distinct().ToList()) {
            if (nav == SettingsNavLook.List) {
              if (group != "") { SectionGroup(group); }
              foreach (var s in shown.Where(x => x.Group == group).ToList()) {
                SectionLink(s.Label, s.To, count: CountOf(s), current: Current(s));
              }
            } else {
              if (group != "") {
                Text(group, fontSize: FontSize.Caption, color: Colors.TextMuted, fontWeight: FontWeight.Medium, px: 2, pt: 3, pb: 1);
              }
              foreach (var s in shown.Where(x => x.Group == group).ToList()) {
                SettingsNavRow(s, Current(s), atHome && !Layout.AtLeast(Tablet));
              }
            }
          }
        }
      }
      if (!atHome || Layout.AtLeast(Tablet)) {
        Stack(gap: 0, grow: 1, minW: "0", minH: "0", h: "100%", overflowY: Overflow.Auto, bg: Colors.Bg) {
          if (!Layout.AtLeast(Tablet)) {
            Row(px: 4, pt: 3) { TextLink("All settings", to: home, tone: Tone.Default); }
          }
          Slot("head");
          // THE AREA'S HOME IS AN OVERVIEW, not a title over an empty page: every
          // section the reader may open, by group, each with what it is for — unless the app fills `slot home` with a
          // home of its own. The app's own page at `home` follows it — a page with nothing to add renders nothing.
          if (atHome && gathered) { Slot("home") { SettingsOverview(shown, title); } }
          Slot;
        }
      } else {
        // A PHONE AT THE AREA'S HOME shows the index alone — and still holds the page's place: in a layout the default
        // slot is the `Outlet`, and the router mounts the child route into it, so a render path without one fails the
        // whole page ("renders no Outlet"). The area's own page has nothing to add here, so the column takes no width.
        Stack(gap: 0, w: "0px", shrink: 0, overflowY: Overflow.Hidden) { Slot; }
      }
    }
  }
}

/// How a settings area draws its sections down the side (`SettingsArea(nav: …)`).
public enum SettingsNavLook {
  /// Each section a row with its icon, the current one lit (`Colors.SettingsNavCurrent`); on a phone's index, its hint under it.
  Rows,
  /// The editing parts' section list: each group in small capitals (`SectionGroup`), each section a `SectionLink`, the
  /// current one on the accent's tint.
  List
}

/// The frame every settings page sits in — a kit's settings pages name it (`[Layout(SettingsFrame)]`), and so do the
/// app's. It is the settings area inside the app's working shell — `WorkspaceShell` (Slots.osy), which an app designs once
/// for every kit page — so an app with a shell of its own has its settings in it with nothing more to write. ⚑ AN APP
/// MAY STILL TAKE IT OVER, by declaring a `[Layout] component SettingsFrame()` of its own, when its settings stand in a
/// different frame from its other pages.
/// In a test it is the frame around the page, so scope to the page's own regions: `Ui.Click("Save", within: "Workshop")`.
/// need: a layout for settings pages, put the app's shell around every kit's settings page
/// e.g. `[Route("/settings/workshop")] [Layout(SettingsFrame)] component WorkshopSettings() { … }`
/// e.g. `component MyShell() : WorkspaceShell { render { AppShell(chrome) { Slot; } } }` (every settings page then stands in it)
/// ⚑ ON ITS OWN IT IS THE WINDOW'S HEIGHT. The area fills its parent (`h: "100%"`), and an app's shell gives it one; the
///   bare shell gives it the window — otherwise the sections column ended where the page's content ended, a short page
///   leaving the nav hanging halfway down. The page scrolls inside the area, beside the nav.
[Layout]
component SettingsFrame() {
  render { WorkspaceShell { SettingsArea() { Outlet; } } }
}

/// The settings area's home on a wide screen: every section the reader may open, grouped, each a row with its icon,
/// its name and what it is for — the map of what can be changed, where a title over an empty page used to be. Drawn
/// by `SettingsArea` at its `home`; on a phone the nav itself is the home and carries the same hints.
/// In a test it is a named region: `Assert.Visible("Queues", within: "All settings")`.
/// need: an overview of every settings section, a settings home page, the index of an admin area
/// e.g. `SettingsOverview(AnnouncedSettings())`
[Composable]
component SettingsOverview(List<SettingsLink> sections, string title = "Settings") {
  render {
    Stack(gap: 6, py: 5, px: Space.SettingsPageX, w: "100%", maxW: Length.SettingsPageW, label: "All settings") {
      Stack(gap: 1) {
        PageTitle(title);
        Text(sections.Count == 0 ? "Nothing here is yours to change yet."
               : "Everything you can change, by area. Nothing on a settings page is saved until you press Save.",
             color: Colors.TextMuted, maxW: "680px");
      }
      foreach (var group in sections.Select(s => s.Group).Distinct().ToList()) {
        Stack(gap: 2, label: group == "" ? "Other settings" : group) {
          if (group != "") { SectionLabel(group); }
          Stack(gap: 0, rounded: Radius.Lg, borderW: 1, border: Colors.Border, bg: Colors.Surface, overflow: Overflow.Hidden) {
            foreach (var s in sections.Where(x => x.Group == group).ToList()) {
              SettingsOverviewRow(s);
            }
          }
        }
      }
    }
  }
}

/// One section on the settings home — the whole row is the link.
[Composable, Part]
component SettingsOverviewRow(SettingsLink link) {
  variants {
    base { Display = Display.Flex; Px = 4; Py = 3; Gap = 3; Color = Colors.OnSurface; TextDecoration = TextDecoration.None;
           BorderBW = 1; Border = Colors.Border; Transition = Motion.Fast;
           Hover { Bg = Colors.Muted; } }
  }
  render {
    Link(link.To, label: link.Label) {
      Row(gap: 3, align: Align.Center, w: "100%") {
        Box(w: "32px", h: "32px", rounded: Radius.Md, bg: Colors.Sunken, shrink: 0, display: Display.Flex,
            align: Align.Center, justify: Justify.Center) { Icon(link.Icon, size: 16, color: Colors.TextSecondary); }
        Stack(gap: 0, minW: "0", grow: 1) {
          Text(link.Label, fontWeight: FontWeight.Medium);
          if (link.Hint != "") { Text(link.Hint, fontSize: FontSize.Caption, color: Colors.TextMuted); }
        }
        Icon(Icons.ChevronRight, size: 14, color: Colors.TextMuted);
      }
    }
  }
}

/// One row of the settings nav — a link, lit when it is the section being looked at; with its hint on a phone's index.
[Composable, Part]
component SettingsNavRow(SettingsLink link, bool current, bool withHint) {
  variants {
    base { Display = Display.Flex; Rounded = Radius.Md; Px = 2; Py = 2; Color = Colors.OnSurface; Gap = 2;
           TextDecoration = TextDecoration.None;
           Hover { Bg = Colors.Muted; } }
    current { Bg = Colors.SettingsNavCurrent; Color = Colors.OnSettingsNavCurrent; FontWeight = FontWeight.Semibold;
              Hover { Bg = Colors.SettingsNavCurrent; } }
  }
  render {
    Link(link.To, label: link.Label, current: current) {
      Row(gap: 2, align: withHint ? Align.Start : Align.Center, w: "100%") {
        if (current) { Icon(link.Icon, color: Colors.Primary); } else { Icon(link.Icon, color: Colors.TextMuted); }
        Stack(gap: 0, minW: "0") {
          Text(link.Label);
          if (withHint && link.Hint != "") { Text(link.Hint, fontSize: FontSize.Caption, color: Colors.TextMuted); }
        }
      }
    }
  }
}

/// A settings page — its title and a line saying what it is for, then its sections, in a readable column. Put a
/// `SaveBar` at the end of a page whose sections edit rows.
/// As wide as `Length.SettingsPageW` at most, its sides `Space.SettingsPageX` — the theme's (`osy docs ui-settings#look`).
/// In a test its title is ordinary text: `Assert.Visible("Business hours")`.
/// need: a page of the settings area, a configuration page with a heading and sections
/// e.g. `SettingsPage("Business hours", description: "When the SLA clocks run.") { SettingsSection(…) { … } }`
[Composable]
component SettingsPage(string title, string description = "") {
  render {
    // Named "<title> page" — the page's own body, as tall as what is on it (a test measures the area against it).
    Stack(gap: 6, pt: 5, px: Space.SettingsPageX, w: "100%", maxW: Length.SettingsPageW, pb: 8, label: title + " page") {
      // The title and its line — no rule under them: each section below draws its own, so a rule here would double it.
      Stack(gap: 1, label: title) {
        PageTitle(title);
        if (description != "") { Text(description, color: Colors.TextMuted, maxW: "680px"); }
      }
      Stack(gap: 6) { Slot; }
    }
  }
}

/// One section of a settings page: what it is (its title and a line) on the left, its controls on the right — stacked on
/// a phone. `locked` shows the controls but says they are not this reader's to change (`lockedBecause`) — give each
/// control `disabled:` or `canEdit:` from the same policy; the rows themselves are refused by their own rules either way.
/// `changed` is the "who changed this and when" line (`ChangedBy`). `setByOrganization` says the reader's organisation
/// sets it (`SetByOrganization(key)`, for a setting marked `[OrgPolicy(OrgPolicyMode.Lock)]`) — the section reads "Set by
/// your organization", and its controls take `disabled:` from the same value.
/// ⚑ RULED ON THE FLOOR, A CARD WHEN THE THEME SAYS SO: its label column is `Length.SettingsLabelW`, and its ground, edge,
///   corners and padding are `Colors.SettingsSectionBg`/`SettingsSectionLine`, `Length.SettingsSectionEdge`,
///   `Radius.SettingsSection` and `Space.SettingsSectionX`/`Top`/`Bottom` (`osy docs ui-settings#look`).
/// In a test it is a named region: `Ui.Click("Add a status", within: "Statuses")`.
/// need: a group of settings with a title and a description, a settings card, a locked section an admin may change, a setting the organization controls
/// e.g. `SettingsSection("Statuses", description: "What a ticket can be waiting on.", locked: !IsAdmin, lockedBecause: "Only admins change statuses.") { … }`
/// `columns: 2` lays its fields on the form grid — equal halves, each field filling its own (`NumberField(fill: true)`),
/// so a pair (at least / at most) and the fields under it line up; `3` for thirds.
/// e.g. `SettingsSection("Slots", columns: 2) { NumberField("At least", value: r.Min, fill: true); NumberField("At most", value: r.Max, fill: true); }`
[Composable]
component SettingsSection(string title, string description = "", bool locked = false, string lockedBecause = "",
                          string changed = "", bool setByOrganization = false, int columns = 0) {
  render {
    // Ruled on the floor — a line above, nothing at the sides or foot; a theme makes it a card (`osy docs ui-settings#look`).
    Row(gap: 6, align: Align.Start, wrap: Wrapping.Wrap, label: title, role: UiRole.Region,
        pt: Space.SettingsSectionTop, pb: Space.SettingsSectionBottom, px: Space.SettingsSectionX,
        borderTW: 1, borderRW: Length.SettingsSectionEdge, borderBW: Length.SettingsSectionEdge, borderLW: Length.SettingsSectionEdge,
        border: Colors.SettingsSectionLine, rounded: Radius.SettingsSection, bg: Colors.SettingsSectionBg) {
      Stack(gap: 1, w: Layout.AtLeast(Tablet) ? Length.SettingsLabelW : "100%", shrink: 0) {
        Text(title, fontWeight: FontWeight.Semibold);
        if (description != "") { Text(description, fontSize: FontSize.Caption, color: Colors.TextMuted); }
        // The organisation's word outranks the app's own lock, so it is the one line said.
        if (setByOrganization) {
          Row(gap: 1, align: Align.Center, pt: 1, label: "Set by your organization") {
            Icon(Icons.Building, color: Colors.TextMuted);
            Text("Set by your organization", fontSize: FontSize.Caption, color: Colors.TextMuted, fontWeight: FontWeight.Medium);
          }
        } else if (locked) {
          Row(gap: 1, align: Align.Center, pt: 1) {
            Icon(Icons.Lock, color: Colors.TextMuted);
            Text(lockedBecause != "" ? lockedBecause : "You can see this, but not change it.", fontSize: FontSize.Caption,
                 color: Colors.TextMuted);
          }
        }
        if (changed != "") { Text(changed, fontSize: FontSize.Caption, color: Colors.TextMuted, pt: 1); }
      }
      // `basis:` — the content STARTS at a sensible width and grows into the rest, so a wide control inside it (a full-
      // width input) never pushes the whole column under the title on a screen that has room for both.
      // ⭐ `columns:` PUTS ITS FIELDS ON THE FORM GRID (KIT-FORM-GRID): n equal columns a `Space.FormGutter` apart, each
      //   field filling its own, so the same logical column holds the same width and left edge down the section — pairs
      //   as halves, three peers as thirds. One column on a phone. 0 (the default) stacks them, as it always did.
      if (columns > 0) {
        Box(display: Display.Grid, cols: Layout.AtLeast(Tablet) ? FormGridCols(columns) : FormGridCols(1), gap: Space.FormGutter,
            grow: 1, minW: "0", basis: "360px", w: Layout.AtLeast(Tablet) ? "auto" : "100%") { Slot; }
      } else {
        Stack(gap: 3, grow: 1, minW: "0", basis: "360px", w: Layout.AtLeast(Tablet) ? "auto" : "100%") { Slot; }
      }
    }
  }
}

/// One setting in a `SettingsSection` — its control (the slot), the line saying what it does, and, when the reader's
/// organisation sets it while the rest of the section is the app's, "Set by your organization" under it. What a
/// `[Settings]` section draws for each field; reach for it on a page of your own so a hand-made row reads the same.
/// `provenance` says WHERE ITS VALUE COMES FROM, under the rest ("Default: 4", "Set here by Ada · 3 min ago", "From
/// base: 6", "Locked by your organization"), drawn as `from:` says (a `SettingFrom`, as `ScopedSetting` draws it), with
/// `action` beside it ("Reset", "Set here") pressing `onAction`. `label` names the row as a group, for a reader and a test.
/// In a test drive the control inside it by its label (`Ui.Click("Publish new reviews at once")`), and read the line under it as text:
/// `Assert.Visible("Default: 4", within: "Batch size")` when the row has a `label`.
/// e.g. `SettingRow(hint: "Staff can still hide one.") { Switch("Publish new reviews at once", value: rules.PublishAtOnce); }`
/// e.g. `SettingRow(label: "Batch size", provenance: "From base: 6", from: SettingFrom.Inherited, action: "Set here", onAction: SetHere) { NumberField("Batch size", value: site.BatchSize); }`
[Composable]
component SettingRow(string hint = "", bool setByOrganization = false, string label = "", string provenance = "",
                     SettingFrom from = SettingFrom.Default, string action = "", Action? onAction = null) {
  render {
    if (label != "") {
      Stack(gap: 1, minW: "0", role: UiRole.Group, label: label) {
        Slot;
        SettingRowNotes(hint, setByOrganization, provenance, from, action, onAction);
      }
    } else {
      Stack(gap: 1, minW: "0") {
        Slot;
        SettingRowNotes(hint, setByOrganization, provenance, from, action, onAction);
      }
    }
  }
}

/// What a `SettingRow` says under its control: what it does, the organisation's mark, and where its value comes from.
[Composable][Part]
component SettingRowNotes(string hint, bool setByOrganization, string provenance, SettingFrom from, string action, Action? onAction) {
  render {
    if (hint != "") { Text(hint, fontSize: FontSize.Caption, color: Colors.TextMuted); }
    if (setByOrganization) {
      Row(gap: 1, align: Align.Center) {
        Icon(Icons.Building, color: Colors.TextMuted);
        Text("Set by your organization", fontSize: FontSize.Caption, color: Colors.TextMuted, fontWeight: FontWeight.Medium);
      }
    }
    if (provenance != "") { ProvenanceLine(provenance, from: from, action: action, onAction: onAction); }
  }
}

/// A SETTING NOBODY EDITS HERE — a fact read off the row ("Measured load", "38 %"): its label over its value on the
/// closed ground a locked value has. What a `[Setting(ReadOnly = true)]` field draws.
/// In a test it is the group named by its label: `Assert.Visible("38 %", within: "Measured load")`.
/// e.g. `SettingFact("Measured load", "38 %")`
[Composable]
component SettingFact(string label, string value) {
  render {
    Stack(gap: 1, minW: "0", role: UiRole.Group, label: label) {
      Text(label, fontSize: FontSize.Label, fontWeight: FontWeight.LabelWeight, color: Colors.LabelInk);
      Row { SettingValue(value, locked: true); }
    }
  }
}

/// TECHNICAL DETAILS OF A SETTINGS PAGE — the keys its settings are known by elsewhere (an organisation's rule, an
/// export, a support ticket), one per line in the key face, and Copy, which puts them all on the clipboard. What
/// `[Settings(Keys = true)]` draws under the fields.
/// In a test it is the region "Technical details": `Assert.Visible("Pace.BatchSize", within: "Technical details")`.
/// e.g. `SettingsKeys(["Shop.Pace.BatchSize", "Shop.Pace.Paused"])`
[Composable]
component SettingsKeys(string[] keys, string title = "Technical details", string copy = "Copy") {
  action CopyKeys() { Clipboard.Copy(string.Join("\n", keys)); }
  render {
    SettingsSection(title, description: "The keys these settings are known by.") {
      Stack(gap: 1) { foreach (var key in keys) { Text(key, fontFamily: Font.Mono, fontSize: FontSize.Caption); } }
      Row { WordAction(copy, CopyKeys); }
    }
  }
}

/// Short settings side by side — account numbers, counts, durations — in as many columns as the section has room for,
/// one on a phone. What a `[Settings]` section puts two or more short fields in.
/// `columns:` FIXES the count (KIT-FORM-GRID): n equal columns a `Space.FormGutter` apart, whatever the width, so the
/// same logical column keeps its x and width from one grid to the next — a form's grid. One on a phone. 0 (the default)
/// fits as many 180px columns as there is room for.
/// In a test there is nothing to drive — fill the fields inside it by their labels: `Ui.Fill("Bank", "…")`.
/// e.g. `SettingsGrid { Field("Bank", value: a.Bank); Field("Receivables", value: a.Receivables); }`
/// e.g. `SettingsGrid(columns: 2) { NumberField("Never below", value: r.Min, fill: true); NumberField("Never above", value: r.Max, fill: true); }`
[Composable]
component SettingsGrid(int columns = 0) {
  render {
    if (columns > 0) {
      Box(display: Display.Grid, cols: Layout.AtLeast(Tablet) ? FormGridCols(columns) : FormGridCols(1), gap: Space.FormGutter, w: "100%") { Slot; }
    } else {
      Box(display: Display.Grid, cols: "repeat(auto-fill, minmax(180px, 1fr))", gap: 4, w: "100%") { Slot; }
    }
  }
}

/// The columns of the form grid: n equal ones that never grow past their share for a long word (`minmax(0, 1fr)`).
public string FormGridCols(int n) {
  return $"repeat({n}, minmax(0, 1fr))";
}

/// Save and discard for a settings page — a bar that appears only while the page holds unsaved changes
/// (`Navigation.IsDirty`), saying so, with Undo (back to the last savepoint — `UnitOfWork.Mark("Rename a status")`
/// before an edit makes one; its label is the button's), Discard (every unsaved change), and Save. Mod+S saves,
/// Mod+Z undoes. `saved` is said once a save lands.
/// `blockedBy` HOLDS A SAVE BACK: the sentence saying why the page cannot be saved as it stands ("Say why it is kept that
/// long.") — while it is not empty the bar says it and Save does nothing. Compute it from the page's own values, so it
/// changes as the person types. `onSave` runs as Save is pressed, before the commit — a derived value to set. ⚠ It is
/// FIRED, NOT AWAITED (a component's callback never is), so it cannot stop the save: a sentence it throws is lost and
/// the save goes ahead. A check belongs in `blockedBy`. `onSaved` runs once a save has landed — to re-read what the page
/// shows about it ("Changed by …").
/// `saveWith` SAVES THROUGH A FUNCTION instead of committing the page: Save calls it (and waits), and it answers "" when
/// it saved or the sentence the bar shows when it did not. It does the whole save — hands the page's values to whatever
/// writes them, and puts the page's own edits back (`UnitOfWork.Discard()`) — so the bar commits nothing itself. It
/// answers rather than throws: a `[Settings(Writer = …)]` section's page passes the one the kit writes for it.
/// ⭐ A SAVE THE MODEL'S RULES WOULD REFUSE IS HELD, NOT SENT: the edits stay, every field in the way is shown at its
///   control (`Validation.Reveal()`), and the bar says "2 fields need attention." (`Validation.All`).
/// ⚑ A REFUSED SAVE SAYS WHY AND KEEPS THE EDITS: the bar stays up reading "Not saved — <the reason>", the person's
///   values are still in their fields, and each field the server named shows its sentence under it.
/// In a test: `Ui.Click("Save")`, `Ui.Click("Discard")`, and `Assert.Visible("Unsaved changes")` while there are some.
/// need: an explicit save and discard bar, save changes to settings, unsaved changes warning, undo an edit before saving, refuse to save until a field is filled, why a save was refused
/// e.g. `SaveBar(saved: "Statuses saved.")` · `SaveBar(saved: "Saved.", blockedBy: reason == "" ? "Say why." : "")` ·
/// `SaveBar(saved: "Pace saved.", saveWith: SavePaceFromPage)`
[Composable]
component SaveBar(Action onSave = null, string saved = "Saved.", string blockedBy = "", Action onSaved = null,
                  Func<string> saveWith = null) {
  string problem = "";
  bool justSaved = false;
  live var dirty = Navigation.IsDirty;
  live var canUndo = UnitOfWork.CanUndo();
  live var undoLabel = UnitOfWork.UndoLabel();

  action Save() {
    problem = "";
    justSaved = false;
    // Mod+S reaches here even while the button is disabled — the shortcut is the bar's, not the button's.
    if (blockedBy != "") { return; }
    // HELD, NOT SENT: a save the model's own rules would refuse never leaves the page — the edits stay, every
    // field in the way is shown at its control, and the sentence says how many. (Sent, it would only come back refused:
    // a refused page save keeps its edits too, but the person would wait a round trip to learn what the page knew.)
    if (Validation.All.Count > 0) {
      Validation.Reveal();
      problem = Validation.All.Count == 1 ? "1 field needs attention." : Validation.All.Count.ToString() + " fields need attention.";
      return;
    }
    // Saved by a function of the page's, not by this bar: outside the `try` below, so what it puts back is the page's
    // own edits (a `try` is a savepoint, and a discard inside one reaches only what the savepoint holds).
    if (saveWith != null) {
      var why = saveWith();
      if (why != "") { problem = "Not saved — " + why; return; }
      justSaved = true;
      if (onSaved != null) { onSaved(); }
      return;
    }
    try {
      if (onSave != null) { onSave(); }
      UnitOfWork.Commit();
      justSaved = true;
      if (onSaved != null) { onSaved(); }
    }
    // A lost race is the platform's to show: the conflict notice gives the person both values and Keep theirs /
    // Apply mine. Caught here it would read only "Not saved — …" with nothing to choose (`osy docs ui-conflict-notice`).
    catch (ConflictException) { throw; }
    // A refused save KEEPS the page's edits: the bar stays up with the reason in it, and each field
    // the server named shows its own sentence under it (`Validation.MessageFor`).
    catch (Exception ex) { problem = "Not saved — " + ex.Message; }
  }
  action Discard() { problem = ""; justSaved = false; UnitOfWork.Discard(); }
  action Undo() { problem = ""; UnitOfWork.Undo(); }

  render {
    Stack(gap: 0, position: Position.Sticky, bottom: "0", z: ZIndex.Sticky) {
      if (dirty) {
        Row(gap: 3, align: Align.Center, wrap: Wrapping.Wrap, px: 4, py: 3, bg: Colors.Elevated, rounded: Radius.Lg,
            shadow: Shadow.Floating, borderW: 1, border: Colors.Border, role: UiRole.Region, label: "Unsaved changes",
            animation: SaveBarRise) {
          Lamp(lit: true, tone: Tone.Primary);
          Text("Unsaved changes", fontWeight: FontWeight.Medium);
          if (blockedBy != "") { Text(blockedBy, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert); }
          else if (problem != "") { Text(problem, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert); }
          Spacer();
          if (canUndo) {
            Button(undoLabel != "" ? "Undo " + undoLabel.ToLower() : "Undo", onPress: Undo, tone: Tone.Ghost, size: Size.Sm,
                   shortcut: "Mod+Z");
          }
          Button("Discard", onPress: Discard, tone: Tone.Ghost, size: Size.Sm);
          Button("Save", onPress: Save, tone: Tone.Primary, size: Size.Sm, shortcut: "Mod+S", showShortcut: true,
                 disabled: blockedBy != "");
        }
      } else if (problem != "") {
        // Nothing left to save (a function the save ran discarded what it carried, or the person discarded since) —
        // but the reason is still owed. The page's own ground behind it: the bar stays at the foot of the window.
        Row(gap: 2, align: Align.Center, px: 4, py: 3, bg: Colors.Bg, label: "Not saved") {
          Icon(Icons.Warning, color: Colors.Danger);
          Text(problem, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert);
        }
      } else if (justSaved && saved != "") {
        Row(gap: 2, align: Align.Center, px: 4, py: 3, bg: Colors.Bg) {
          Icon(Icons.Check, color: Colors.Success);
          Text(saved, color: Colors.TextMuted, fontSize: FontSize.Caption, role: UiRole.Status);
        }
      }
    }
  }
}

/// THE REVIEW BEFORE A SETTINGS SAVE — the `ImpactDialog` an `EditingBanner`'s "Review and save" opens: each change in
/// words (`changes`, "Batch size: 4 → 6"), when it applies (`applies`), why it is made (`why`, asked when `askWhy`,
/// and Save held while it is empty when `whyRequired`), what holds the save back (`verdict`), why the last save was
/// refused (`problem`), and a Save that names what it saves (`saveLabel`, "Save batch size 6"). "Back to editing" and
/// closing it keep every change. What a `[Settings(Save = Review)]` section draws; reach for it on a page of your own
/// so a hand-made review reads the same.
/// In a test it is the dialog named by `title`: `Assert.Dialog("1 change to release pace")`, `Ui.Fill("Why", "…")`.
/// need: review settings before saving, ask why a setting changed, say when a change applies, a save that names what it saves
/// e.g. `SettingsReview("1 change to release pace", ["Batch size: 4 → 6"], "Save batch size 6", onSave: Save, onBack: Back, why: reason, askWhy: true, whyRequired: true, applies: "From the next batch.")`
[Composable]
component SettingsReview(string title, List<string> changes, string saveLabel, Action onSave, Action onBack,
                         Binding<string> why, bool askWhy = false, bool whyRequired = false, string applies = "",
                         string verdict = "", string problem = "", bool canSave = true, string overline = "Review and save",
                         string back = "Back to editing") {
  render {
    ImpactDialog(title, onDismiss: onBack, overline: overline) {
      Bullets(label: "What changes") { foreach (var line in changes) { Bullet(line); } }
      if (applies != "") {
        Stack(gap: 1, label: "When it applies") {
          Text("When it applies", fontSize: FontSize.Label, fontWeight: FontWeight.Semibold, color: Colors.MetaText);
          Text(applies);
        }
      }
      if (askWhy) {
        TextAreaField("Why", value: why,
                      hint: whyRequired ? "Required. It is kept with the change." : "Optional. It is kept with the change.");
      }
      if (verdict != "") { Text(verdict, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert); }
      if (problem != "") { Text(problem, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert); }
      slot actions {
        Button(back, onPress: onBack, tone: Tone.Ghost);
        Button(saveLabel, onPress: onSave, tone: Tone.Primary, disabled: !canSave);
      }
    }
  }
}

/// What the last settings save came to, under a page that saves through a review: why it was refused (`problem`), or
/// that it landed (`saved`). Nothing when both are empty.
/// e.g. `SettingsSaveNote(problem: problem, saved: justSaved ? "Pace saved." : "")`
[Composable]
component SettingsSaveNote(string problem = "", string saved = "") {
  render {
    if (problem != "") {
      Row(gap: 2, align: Align.Center, label: "Not saved") {
        Icon(Icons.Warning, color: Colors.Danger);
        Text(problem, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert);
      }
    } else if (saved != "") {
      Row(gap: 2, align: Align.Center) {
        Icon(Icons.Check, color: Colors.Success);
        Text(saved, color: Colors.TextMuted, fontSize: FontSize.Caption, role: UiRole.Status);
      }
    }
  }
}

animation SaveBarRise {Duration = "200ms"; from { Opacity = 0; TranslateY = "8px"; } to { Opacity = 1; TranslateY = "0"; } }

/// "Changed by Ada Lindqvist · 3 min ago" — who last changed something and when, for a `SettingsSection`'s `changed:`
/// line or anywhere a page says who last touched a row. Fed from the row's own history — `<Entity>.Changes(id)` (which
/// needs `using Osysharp.Observability;`) answers newest first, so its first entry is the one: `ChangedBy(c.By, c.At, now)`.
/// `by` empty reads "the system"; no `at` answers "". `now` is the page's clock.
/// e.g. `var last = TicketStatus.Changes(s.Id).FirstOrDefault();  SettingsSection("Statuses", changed: last == null ? "" : ChangedBy(last.By, last.At, now))`
public string ChangedBy(string by, DateTime? at, DateTime now) {
  if (at == null) { return ""; }
  return $"Changed by {(by != "" ? by : "the system")} · {TimeAgo(at.Value, now)}";
}

/// A moment in words, from `now` — "just now", "4 min ago", "3 h ago", "yesterday", "12 Mar".
public string TimeAgo(DateTime at, DateTime now) {
  var gone = now - at;
  if (gone.TotalSeconds < 60) { return "just now"; }
  if (gone.TotalMinutes < 60) { return Convert.ToInt(Math.Truncate(gone.TotalMinutes)) + " min ago"; }
  if (gone.TotalHours < 24) { return Convert.ToInt(Math.Truncate(gone.TotalHours)) + " h ago"; }
  if (gone.TotalHours < 48) { return "yesterday"; }
  return at.ToString("d MMM");
}
