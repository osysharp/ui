// Ui — ThemeToggle, the kit's light/dark switch (`using Osysharp.Ui;`).

namespace Osysharp.Ui;

/// A one-tap light/dark switch. `glyph` is the button FACE (an emoji by default so the kit needs no app icon; pass
/// your own text, or fork this file to render an `Icon`); `label` is what a screen reader announces. Clicking flips
/// `data-theme` between light and dark and persists the choice, so it survives navigation and return visits.
/// In a test it is pressed by its accessible name: `Ui.Click("Switch to dark mode")`.
/// need: let the user switch between light and dark
/// e.g. `ThemeToggle()` · `ThemeToggle(glyph: "☾", label: "Appearance")`
[Composable]
[AllowAnonymous]
component ThemeToggle(string glyph = "🌓", string label = "Toggle theme") {
  action Flip() { Theme.Toggle(); }

  variants {
    base {
      Px = 3; Py = 2; Rounded = Radius.Md; Border = Colors.Border; Bg = Colors.Surface; Color = Colors.OnSurface;
      // ⚑ A FOCUS RING A KEYBOARD USER CAN SEE (OSY-022). It had none of its own, so focus was the browser's default
      //   hairline — measured 0.67px by an outside tester — on a control that sits in every page's header. And a
      //   target a finger can hit: the emoji face alone made it as small as the glyph's line.
      MinW = Length.TouchDense; MinH = Length.TouchDense; Display = Display.InlineFlex;
      Focus { OutlineW = 2; OutlineColor = Colors.Focus; OutlineOffset = "2px"; OutlineStyle = OutlineStyle.Solid; }
    }
  }

  render {
    Pressable(glyph, onClick: Flip, label: label, align: Align.Center, justify: Justify.Center);
  }
}
