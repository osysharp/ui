// Ui — Skeleton, the stand-in a component holds while its first read is in flight (`using Osysharp.Ui;`).

namespace Osysharp.Ui;

/// The shapes a stand-in block comes in — sized to match what each stands in for.
public enum SkeletonShape { Line, HalfLine, Control, Circle, Block }

/// The kit's shimmer — a band of light sweeping across the block, over a gentle pulse.
///
/// The band is the part that reads as "still loading": an opacity pulse of a light grey on a light surface alone moves a
/// handful of shades, and on a light board it read as hung, not loading. The band lives in
/// the animation itself (an image three times the block's width, a light stripe in its middle third, swept across by its
/// position), so every `Animation = KitShimmer` gets it with no second style. Under `prefers-reduced-motion` the platform
/// drops the travel (`background-position` moves something) and keeps the pulse: at rest the stripe sits outside the block,
/// so what remains is a quiet fade, not nothing.
animation KitShimmer {
  Duration = "1.6s";
  Easing = EaseInOut;
  Repeat = Infinite;
  0%   { BgImage = "linear-gradient(90deg, transparent 40%, color-mix(in srgb, var(--colors-bg, #fff) 80%, transparent) 50%, transparent 60%)"; BgSize = "300% 100%"; BgPosition = "100% 0"; Opacity = "0.55"; }
  50%  { BgImage = "linear-gradient(90deg, transparent 40%, color-mix(in srgb, var(--colors-bg, #fff) 80%, transparent) 50%, transparent 60%)"; BgSize = "300% 100%"; Opacity = "1"; }
  100% { BgImage = "linear-gradient(90deg, transparent 40%, color-mix(in srgb, var(--colors-bg, #fff) 80%, transparent) 50%, transparent 60%)"; BgSize = "300% 100%"; BgPosition = "0% 0"; Opacity = "0.55"; }
}

/// One shimmering placeholder block. `Skeleton()` is a full-width text line; `Skeleton(shape: SkeletonShape.Circle)` stands in
/// for an avatar, `Skeleton(shape: SkeletonShape.Control)` for a button or input.
/// In a test it is a loading state — assert the real content once it has arrived, not the placeholder.
/// need: a grey placeholder while data loads, a shimmering block before content arrives
[Composable]
component Skeleton(SkeletonShape shape = SkeletonShape.Line) {
  variants {
    base { Bg = Colors.Muted; Rounded = Radius.Sm; Animation = KitShimmer; }
    shape {
      Line     { W = "100%";  H = Length.TextLine; }
      HalfLine { W = "60%";   H = Length.TextLine; }
      Control  { W = "100%";  H = Length.ControlMd; Rounded = Radius.Md; }
      Circle   { W = Length.AvatarMd; H = Length.AvatarMd; Rounded = Radius.Circle; }
      Block    { W = "100%";  H = "120px"; Rounded = Radius.Md; }
    }
  }

  render { Box(); }
}

/// A paragraph-shaped stand-in — three rows at the loaded text's line height, the last one short.
/// In a test it is a loading state — assert the real content once it has arrived, not the placeholder.
/// e.g. `SkeletonText()`
[Composable]
component SkeletonText() {
  render {
    Stack(gap: 2) {
      Skeleton();
      Skeleton();
      Skeleton(shape: SkeletonShape.HalfLine);
    }
  }
}

/// "Is it still coming?" — the fade a late notice arrives with, 200ms. Used by `LoadingNote`.
animation KitLateFade {
  Duration = "200ms";
  Easing = EaseOut;
  from { Opacity = 0; }
  to   { Opacity = 1; }
}

/// A quiet "Loading…" for a stand-in — put it in a `skeleton { }` beside the placeholders. It is a status message, so a
/// screen reader says it; on screen it stays invisible until the wait has gone on long enough to notice (the skeleton
/// itself shows ~150 ms after the page opens, and this fades in ~150 ms after that), so a fast read never flashes it.
/// The placeholders say WHAT is coming; this says THAT it is coming, to someone who cannot see shapes.
/// In a test it is a loading state — assert the real content once it has arrived; `Ui.HoldServer()` holds the page here.
/// need: a loading message while data loads, tell a screen reader the page is still loading
/// e.g. `skeleton { Stack(gap: 3) { LoadingNote(); SkeletonText(); } }`
[Composable]
component LoadingNote(string text = "Loading…") {
  render {
    Row(role: UiRole.Status, align: Align.Center, animation: KitLateFade, animationDelay: "150ms") {
      Text(text, fontSize: FontSize.Label, color: Colors.TextMuted);
    }
  }
}

/// A card's outline while what it holds is on the way — the same frame as `Card`, at its padding and border, so nothing
/// moves when the content lands. Give it the card's `title` when the page knows it before its data (drawn for real, in
/// the same place); `lines` is how many placeholder rows it holds, the last one short.
/// In a test it is a loading state — assert the real content once it has arrived; `Ui.HoldServer()` holds the page here.
/// need: a placeholder card while a section loads, a card outline before its content arrives
/// e.g. `skeleton { Stack(gap: 4) { SkeletonCard("Components", lines: 5); SkeletonCard("Releases"); } }`
[Composable]
component SkeletonCard(string title = "", int lines = 3) {
  render {
    Card(title) {
      Stack(gap: 3) {
        foreach (var i in Enumerable.Range(0, lines)) {
          if (i == lines - 1 && lines > 1) { Skeleton(shape: SkeletonShape.HalfLine); } else { Skeleton(); }
        }
      }
    }
  }
}
