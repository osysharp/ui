  accessibleName "{label} time" => "وقت {label}";
  /// TimePicker · a heading
  /// shown through TimeColumn.heading
  /// beside: "mm"
  /// also in TimeStrip
  heading "hh" => "ساعة";
  /// TimePicker · a heading
  /// shown through TimeColumn.heading
  /// beside: "hh"
  /// also in TimeStrip
  heading "mm" => "دقيقة";
  /// TimePicker · text on the page
  text "Done" => "تم";

  // ── TimeStrip ──
  /// TimeStrip · a control's name for screen readers
  accessibleName "Change the time" => "تغيير الوقت";

  // ── WeekdayRow ──
  /// WeekdayRow · text on the page
  text "F" key "weekday-initial-friday" => "ج";
  /// WeekdayRow · text on the page
  text "M" key "weekday-initial-monday" => "ن";
  /// WeekdayRow · text on the page
  text "S" key "weekday-initial-saturday" => "س";
  /// WeekdayRow · text on the page
  text "S" key "weekday-initial-sunday" => "ح";
  /// WeekdayRow · text on the page
  text "T" key "weekday-initial-tuesday" => "ث";
  /// WeekdayRow · text on the page
  text "T" key "weekday-initial-thursday" => "خ";
  /// WeekdayRow · text on the page
  text "W" key "weekday-initial-wednesday" => "ر";
}
