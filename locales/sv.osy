// sv (Svenska): the words of Osysharp.Ui, translated.
// Written and kept in step with the source by `osy translate`: a new text arrives as `=> null`, a text
// whose source changed keeps its old translation in a `was` clause. The words are yours to edit.
// Source language: en.

translations sv {
  // ── CalendarPanel ──
  /// CalendarPanel · a control's name for screen readers
  /// placeholders: {label} = label (string)
  accessibleName "{label} calendar" => "{label}, kalender";

  // ── CatalogueColumn ──
  /// CatalogueColumn · a control's name for screen readers
  /// beside: "Site header"
  accessibleName "Departments" => "Avdelningar";
  /// CatalogueColumn · a control's name for screen readers
  /// beside: "Departments"
  /// also in EditorialHeader
  /// also in MarqueeFrame
  /// also in SplitWordmark
  accessibleName "Site header" => "Sidhuvud";

  // ── CatalogueFrame ──
  /// CatalogueFrame · a control's name for screen readers
  /// beside: "primary", "footer"
  /// also in EditorialFrame
  /// also in MarqueeFrame
  accessibleName "Page" => "Sida";

  // ── CommandMenu ──
  /// CommandMenu · a control's name for screen readers
  accessibleName "Commands" => "Kommandon";
  /// CommandMenu · placeholder text inside an empty field · at most ~34 characters
  /// shown through CommandMenu.placeholder
  placeholder "Type a command or search" => "Skriv ett kommando eller sök";
  /// CommandMenu · text on the page
  /// placeholders: {query} = query (string)
  text "Nothing matches “{query}”" => "Inget matchar ”{query}”";

  // ── DataGrid ──
  /// DataGrid · a control's name for screen readers
  accessibleName "Column chooser" => "Välj kolumner";
  /// DataGrid · a control's name for screen readers
  accessibleName "Filter row" => "Filterrad";
  /// DataGrid · a control's name for screen readers
  /// placeholders: {h.Label} = h.Label (string)
  accessibleName "Filter {h.Label}" => "Filtrera {h.Label}";
  /// DataGrid · a button's label · at most ~13 characters
  /// shown through Button.label
  button "Columns" => "Kolumner";
  /// DataGrid · a button's label · at most ~12 characters
  /// shown through Button.label
  button "Export" => "Exportera";
  /// DataGrid · a label (a field, a list item, a menu entry) · at most ~12 characters
  /// shown through Field.label
  label "Search" => "Sök";
  /// DataGrid · placeholder text inside an empty field · at most ~26 characters
  /// shown through Field.placeholder
  placeholder "Search all columns" => "Sök i alla kolumner";
  /// DataGrid · placeholder text inside an empty field · at most ~15 characters
  placeholder "contains…" => "innehåller…";
  /// DataGrid · text on the page
  text "No rows match the filter." => "Inga rader matchar filtret.";

  // ── DatePicker ──
  /// DatePicker · a control's name for screen readers
  /// placeholders: {label} = label (string)
  accessibleName "Clear {label}" => "Rensa {label}";
  /// DatePicker · placeholder text inside an empty field · at most ~17 characters
  /// shown through DatePicker.placeholder
  placeholder "Pick a date" => "Välj ett datum";
  /// DatePicker · text on the page
  /// also in DataGrid
  text "Clear" => "Rensa";

  // ── Done ──
  /// Done · a label (a field, a list item, a menu entry) · at most ~11 characters
  /// shown through Done.label
  label "Saved" => "Sparat";

  // ── DurationField ──
  /// DurationField · a control's name for screen readers
  /// beside: "How many", "Done"
  accessibleName "Unit" => "Enhet";
  /// DurationField · a control's name for screen readers
  /// placeholders: {label} = label (string)
  accessibleName "{label} duration" => "{label}, tidslängd";
  /// DurationField · a button's label · at most ~10 characters
  /// shown through Button.label
  button "Done" => "Klar";
  /// DurationField · a label (a field, a list item, a menu entry) · at most ~14 characters
  /// shown through NumberField.label
  /// beside: "Unit", "Done"
  label "How many" => "Hur många";

  // ── DurationWords ──
  /// DurationWords · text on the page
  /// shown through DurationWords()
  text "1 day" => "1 dag";
  /// DurationWords · text on the page
  /// shown through DurationWords()
  text "1 hour" => "1 timme";
  /// DurationWords · text on the page
  /// shown through DurationWords()
  text "1 minute" => "1 minut";
  /// DurationWords · text on the page
  /// shown through DurationWords()
  text "No time" => "Ingen tid";
  /// DurationWords · text on the page
  /// placeholders: {n} = n (int) — {n} is a count: give one text per plural form
  /// shown through DurationWords()
  text "{n} days" => { one: "{n} dag", other: "{n} dagar" };
  /// DurationWords · text on the page
  /// placeholders: {n} = n (int) — {n} is a count: give one text per plural form
  /// shown through DurationWords()
  text "{n} hours" => { one: "{n} timme", other: "{n} timmar" };
  /// DurationWords · text on the page
  /// placeholders: {n} = n (int) — {n} is a count: give one text per plural form
  /// shown through DurationWords()
  text "{n} minutes" => { one: "{n} minut", other: "{n} minuter" };

