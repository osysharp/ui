// Ui — Field, the kit's labelled text input (`using Osysharp.Ui;`).

namespace Osysharp.Ui;

/// A labelled text input. `Field("Name", value: draft.Name)` — `value` is a two-way binding, so typing updates
/// the bound field directly. A save refused for this field — held for a rule the model declares, or refused by the
/// server — shows its message under it BY ITSELF, with no code in the page (`Validation.MessageFor`). Pass `error` only
/// for a check of the page's own: it marks the field invalid, shows that message, and wins. Pass `hint` for help text
/// (the error replaces the hint while it is present, so the row never grows). Pass `type` for the kinds of text a
/// browser knows about — `"password"` masks what is typed, `"email"`/`"tel"` change the keyboard a phone shows.
/// `autoFocus: true` gives it the keyboard as it appears — the next thing to type in a step that just opened.
/// In a test it is filled by its label: `Ui.Fill("Email", "ada@example.com")`.
/// ⚠ FOR A NUMBER, REACH FOR `NumberField` (whole) or `DecimalField` (money, a measurement, a rate) — they bind a
/// number DIRECTLY, and their range reaches the input itself. `type:` is the browser's input type, not a value
/// type, so `type: "number"`
/// here still binds a `string` and leaves you parsing it by hand on submit.
/// `value` takes an assignable field of your component, a field of an ENTITY row, or a `Binding<T>` you were
/// handed — a field of a `class` value is refused, because there is no row to write the edit through.
/// need: a labelled text input, type a short string, a single-line text box, capture a name or a title
[Composable]
component Field(
    string label,
    Binding<string> value,
    string placeholder = "",
    string hint = "",
    string error = "",
    string type = "text",
    // ⭐ ENTER SUBMITS. A labelled text field is where a person types one thing and presses Return — a search box,
    //   an "add card" row, a login. The ATOM has always had `onEnter:`, so an author who wanted it had to abandon
    //   the control and drop to `Input(...)`, losing the label, the hint and the error row with it. Measured on
    //   `demo/kanban`, the sample `osy docs sample kanban` serves: it writes a bare `Input(value:, label:,
    //   placeholder:, onEnter:)` for exactly this reason, and every reader of that sample learns the atom.
    Action onEnter = null,
    bool disabled = false,
    // `autoFocus:` — take the keyboard when it BECOMES true (and as it appears, when it starts true): the field a step
    //   of a form wants typed next, such as the code a confirmation asks for after the change it confirms.
    bool autoFocus = false)
{
  variants {
    // ⭐ `W`/`MinW`, SO A FIELD TAKES ITS SHARE OF A ROW. Without them a `Field` in a `Row` is sized by the browser's
    //   user-agent default for `<input>` — 20 characters, ~201px — which is a 1995 default, not a design-system one,
    //   and it is the ONLY control in this kit that got its width from outside the theme.
    // ⚠ THE FAILURE IS SILENT AND NO TEXT ASSERTION CAN SEE IT. Measured 2026-09-04 on a generated app:
    //   `Row(gap: 3) { Field("Station", …); Field("Operator", placeholder: "who runs it — can be blank"); }` in a 670px
    //   row gave each field 201px and left 256px of the row EMPTY, and the second placeholder — 203px of text in a
    //   175px content box — rendered as "who runs it — can be bl" and stopped. An `<input>` reports
    //   `scrollWidth === clientWidth` whatever its placeholder does, so `Assert.FitsOn` said it fitted; the DOM
    //   `placeholder` attribute still reads the whole sentence, so every text assertion passed too.
    // ⛔ `W`, NOT `Grow`, and the difference is a regression rather than a preference. `Grow = 1` produces the
    //   IDENTICAL width in every row (measured: 329px either way, and a neighbouring Button unsquashed at 185px in
    //   both) — and in a COLUMN with spare height it also absorbs that height, which pushed the next control in a
    //   `Stack(h: "300px")` to the floor of the card. `W` is a purely inline-axis statement, so it cannot.
    // ⚑ Four of the five `Field`-in-a-`Row` sites in this repo had already hand-written this wrapper —
    //   `Box(grow: 1, minW: "0") { Field(…) }` in `demo/ember`, `Box(grow: 1)` in `demo/wf-order-saga`,
    //   `Box(w: "60%")` in `admin` — which is the demand signal for putting it on the control instead.
    base { Gap = Space.FieldGap; W = "100%"; MinW = 0; }
  }

  // A REFUSED SAVE'S MESSAGE LANDS HERE BY ITSELF (field-messages-in-kit): the sentence the model's rules — or the
  // server — gave for the field this control edits, once the person has left it or tried to save. `error:` still wins
  // when the page passes one, so a page with its own check keeps its own words.
  live var shownError = error != "" ? error : Validation.MessageFor(value);

  render {
    Stack(gap: 1) {
      if (label != "") { Text(label, labelFor: box, fontSize: FontSize.Label, fontWeight: FontWeight.LabelWeight, color: Colors.LabelInk); }
      // ⭐ THE HONEST FLOOR when the box genuinely cannot hold the text — a phone, or a placeholder that is a
      //   sentence. `Ellipsis` renders "who wrote it — can be…", which SAYS there is more; the default `clip` cuts
      //   mid-word and leaves nothing on screen to say so. Degrading gracefully means the reader gets less, not that
      //   they get something that looks complete and is not.
      Input(value: value, id: box, describedBy: note, placeholder: placeholder, disabled: disabled, type: type,
            label: label, invalid: shownError != "", onEnter: onEnter, autoFocus: autoFocus, textOverflow: TextOverflow.Ellipsis);
      if (shownError != "" || hint != "") {
        Text(shownError != "" ? shownError : hint, id: note, fontSize: FontSize.Caption,
             color: shownError != "" ? Colors.Danger : Colors.TextMuted);
      }
    }
  }
}


/// A labelled MULTI-LINE text input — the one to reach for when the answer is a paragraph rather than a line: a
/// reason, a note, a description. `TextAreaField("Why do you need it?", value: draft.Reason, rows: 4)`. Everything
/// `Field` does it does — `value` is a two-way binding, `error` marks it invalid and shows the message, `hint` is
/// help text and the error replaces it while present — and `rows` sets how tall it starts; it grows no further on
/// its own, so pick the height the answer usually needs.
/// In a test it is filled by its label, exactly like a `Field`: `Ui.Fill("Why do you need it?", "Proofing.")`.
[Composable]
/// ⚠ NAMED FOR THE KIT'S CONVENTION, NOT FOR THE TAG. Its siblings are `NumberField` and `DecimalField`, and a
/// control called `TextArea` would SHADOW the atom of that name — measured while adding this: the wrapper then
/// resolved its own inner `TextArea(…)` to ITSELF and failed with "'TextArea' has no parameter 'id'". `osy kit
/// Textarea` finds the atom, and the atom's entry names this control.
/// need: a multi-line text box, type a long note or a description, a paragraph of free text
component TextAreaField(
    string label,
    Binding<string> value,
    string placeholder = "",
    string hint = "",
    string error = "",
    int rows = 3,
    bool disabled = false)
{
  variants {
    // The same inline-axis statement `Field` makes, for the same reason: a `<textarea>` also carries a user-agent
    // intrinsic width (`cols`), so this control in a `Row` was sized by the browser rather than by the layout.
    base { Gap = Space.FieldGap; W = "100%"; MinW = 0; }
  }

  // A REFUSED SAVE'S MESSAGE LANDS HERE BY ITSELF (field-messages-in-kit): the sentence the model's rules — or the
  // server — gave for the field this control edits, once the person has left it or tried to save. `error:` still wins
  // when the page passes one, so a page with its own check keeps its own words.
  live var shownError = error != "" ? error : Validation.MessageFor(value);

  render {
    Stack(gap: 1) {
      if (label != "") { Text(label, labelFor: box, fontSize: FontSize.Label, fontWeight: FontWeight.LabelWeight, color: Colors.LabelInk); }
      TextArea(value: value, id: box, describedBy: note, placeholder: placeholder, disabled: disabled,
               rows: rows, label: label, invalid: shownError != "");
      if (shownError != "" || hint != "") {
        Text(shownError != "" ? shownError : hint, id: note, fontSize: FontSize.Caption,
             color: shownError != "" ? Colors.Danger : Colors.TextMuted);
      }
    }
  }
}

/// The input for ONE PARAMETER OF AN `[Action]`, as its kind takes it — what an editor shows when a person sets up a
/// step that runs one of the app's actions later (an automation's step, a macro's). `choices` is what the parameter
/// offers (`Actions.Choices`, or its enum's members): with any, it is a dropdown; otherwise yes or no, a whole number, a
/// number, a date, a date and time, a time of day, a length of time, an id, details written as JSON (a `Structure`) or
/// a JSON list (a `Sequence`). `value` is the text an `ActionValue` stores — check it with `Actions.Check` before
/// keeping it, which reads it exactly as the run will.
/// In a test it is filled by its label: `Ui.Fill("Due", "2026-11-02")`.
/// need: an input for an action's parameter, set up a step that runs an action, a value for a tool or a macro
/// e.g. `ActionArgumentField(p, choices, value: draft.Value)`
[Composable]
component ActionArgumentField(ActionParameter p, List<ActionChoice> choices, Binding<string> value) {
  string Words(string k) {
    var c = choices.FirstOrDefault(x => x.Key == k);
    return c == null ? k : c!.Label;
  }
  string Hint(string takes) {
    if (!p.Optional) { return takes; }
    return takes == "" ? "May be left empty." : takes + " May be left empty.";
  }
  render {
    if (choices.Count > 0) {
      Dropdown(p.Label, value: value, options: choices.Select(c => c.Key).ToArray()) { k => Text(Words(k)); }
    } else if (p.Kind == ActionParameterKind.YesNo) {
      Dropdown(p.Label, value: value, options: ["true", "false"]) { k => Text(k == "true" ? "Yes" : "No"); }
    } else if (p.Kind == ActionParameterKind.Number) {
      Field(p.Label, value: value, type: "number", hint: Hint("A whole number."));
    } else if (p.Kind == ActionParameterKind.Decimal) {
      Field(p.Label, value: value, type: "number", hint: Hint("A number — 2.5 for two and a half."));
    } else if (p.Kind == ActionParameterKind.Date) {
      Field(p.Label, value: value, type: "date", hint: Hint(""));
    } else if (p.Kind == ActionParameterKind.DateAndTime) {
      Field(p.Label, value: value, type: "datetime-local", hint: Hint(""));
    } else if (p.Kind == ActionParameterKind.TimeOfDay) {
      Field(p.Label, value: value, type: "time", hint: Hint(""));
    } else if (p.Kind == ActionParameterKind.Duration) {
      Field(p.Label, value: value, placeholder: "1:30:00", hint: Hint("Hours, minutes and seconds — 1:30:00 is an hour and a half."));
    } else if (p.Kind == ActionParameterKind.Structure) {
      TextAreaField(p.Label, value: value, rows: 4, placeholder: "{ \"name\": \"value\" }", hint: Hint("Its details, written as JSON."));
    } else if (p.Kind == ActionParameterKind.Sequence) {
      TextAreaField(p.Label, value: value, rows: 3, placeholder: "[\"first\", \"second\"]", hint: Hint("Several values, written as a JSON list."));
    } else {
      Field(p.Label, value: value, hint: Hint(""));
    }
  }
}

/// A labelled NATIVE select — the browser's own `<select>`, its keyboard and its screen reader, with the KIT'S chevron
/// — over a short closed list. `SelectField("Severity", value: rule.Severity)` binds an ENUM and offers its members,
/// worded by their labels; pass `options:` for a subset or for any other values (`options: ["Main", "Preview"]` over a
/// `string`). `value` is a two-way binding: choosing an option writes it straight into the bound field, then runs
/// `onChange` if you pass one (a filter that reloads, a setting that saves).
/// `size: Size.Sm` is the compact one a toolbar filter wants. Its geometry is theme tokens — `Length.SelectH`/`SelectHSm`,
/// `Space.SelectX`/`SelectY` (+ `Sm`), `Radius.Md` — so a design that states its select sets them once. The chevron is
/// the kit's, not the browser's, so every dropdown in an app wears the same one: `Colors.SelectChevronInk`, with
/// `Length.SelectChevronRoom` kept clear for it at the box's right.
/// `showLabel: false` keeps the label as the select's NAME (a screen reader, `Ui.Select(label, …)`) but draws no
/// caption — for a select in a row that already says its name. `setting: true` is the face a setting's choice wears
/// (`SettingChoice`): its height, type, corners and locked look are the `Setting*` tokens, `size: Size.Lg` the phone's.
/// `Dropdown` is the styled list (rows with content, a tick on the current one); this is the plain control.
/// ⭐ A CHOICE THAT SAYS WHAT EACH OPTION MEANS: pass `detail:` and it opens the kit's own list (an ARIA listbox) whose
/// options each show their words over a line saying what they mean — "Business" over "$199 a month, 25 applications".
/// Closed, the box shows the chosen one's words, at the same size and with the same chevron. `words:` says what an
/// option is called when it is not an enum member — a row (`options: plans, words: p => p.Name`); without it an
/// option is worded by its `[Label]`. The keyboard is the listbox's: ↓/↑ (or Enter, Space) open it on the chosen option, ↓/↑ move,
/// Home/End go to the ends, a letter (or a quick run of them, within half a second) goes to the next option whose words
/// start with it, Enter or Space chooses, Escape or Tab closes it without choosing, and the keyboard is back
/// on the box after either. A screen reader hears each option by its words, then what it means.
/// In a test it is chosen by its label: `Ui.Select("Severity", Severity.Should)` (or by an option's words), read back
/// with `Assert.Value("Severity", …)`, and moved with the keyboard like any select (`Ui.Press("ArrowDown")`).
/// The listed one (`detail:`/`words:`) is chosen by the option itself — `Ui.Select("Plan", plan)` — and read back by
/// what it shows (`Assert.Visible("Business", within: "Plan")`).
/// need: a native select box, a plain select element, pick one of a short fixed list in a form or a toolbar filter,
/// a dropdown that says what each option means, choose a plan and see what each includes, a rich select with two lines
/// e.g. `SelectField("Severity", value: rule.Severity)` · `SelectField("Show", value: show, options: ["All", "Changed"], size: Size.Sm)`
///   · `SelectField("Plan", value: org.Plan, options: plans, words: p => p.Name, detail: p => p.Includes)`
[Composable]
component SelectField<T>(
    string label,
    Binding<T> value,
    T[] options = T.Members,
    string hint = "",
    string error = "",
    bool disabled = false,
    Size size = Size.Md,
    Action? onChange = null,
    bool showLabel = true,
    bool setting = false,
    Func<T, string>? detail = null,
    // ⭐ WITHOUT `words:` AN OPTION IS SHOWN AS ITSELF — `Text(m)`, which words an enum member by its `[Label]` and any
    //   other value as it is. Never `m.Label`: a word read off `T` would make every call bind an enum
    //   (OsySharpGenericComponentCheck), refusing the strings and rows the plain face has always taken.
    Func<T, string>? words = null)
{
  variants {
    // The same inline-axis statement `Field` makes: a `<select>` otherwise takes its width from its longest option.
    base { Gap = Space.FieldGap; W = "100%"; MinW = 0; }
  }

  live var shownError = error != "" ? error : Validation.MessageFor(value);

  // THE LISTED FACE's state (`detail:`/`words:`): whether the list is open, which option the keyboard is on, and
  // whether the box takes the keyboard back — set when the list closes by a key or a choice, never when the person
  // moved elsewhere (a click outside, Tab past the box), so the box cannot pull focus back from where they went.
  bool open = false;
  int at = 0;
  bool back = false;

  int IndexOf(T m) {
    int i = 0;
    int found = 0;
    foreach (var o in options) {
      if (o == m) { found = i; }
      i = i + 1;
    }
    return found;
  }

  action Open() {
    if (disabled || options.Count == 0) { return; }
    at = IndexOf(value);
    back = false;
    open = true;
  }
  action Toggle() { if (open) { Close(); } else { Open(); } }
  // Closed by a key: the keyboard goes back to the box it opened from.
  action Close() { open = false; back = true; }
  // Closed because the person went elsewhere: the keyboard stays where they took it.
  action Dismiss() { open = false; }
  action Choose(T m) {
    value = m;
    open = false;
    back = true;
    if (onChange != null) { onChange(); }
  }
  action ChooseAt() {
    int i = 0;
    T picked = value;
    foreach (var m in options) {
      if (i == at) { picked = m; }
      i = i + 1;
    }
    Choose(picked);
  }
  action Arrive(int i) { at = i; }
  action BoxKey(string key) { Open(); }
  action ListKey(string key) {
    if (key == "Down") { at = Math.Min(at + 1, options.Count - 1); }
    else if (key == "Up") { at = Math.Max(at - 1, 0); }
    else if (key == "Home") { at = 0; }
    else if (key == "End") { at = options.Count - 1; }
    else if (key == "Enter" || key == "Space") { ChooseAt(); }
    else if (key == "Tab") { Close(); }
  }

  render {
    Stack(gap: 1) {
      if (detail != null) {
        if (label != "" && showLabel) { Text(label, labelFor: trigger, fontSize: FontSize.Label, fontWeight: FontWeight.LabelWeight, color: Colors.LabelInk); }
        // ⭐ THE SAME BOX, A LIST UNDER IT. The trigger wears exactly the native face's geometry and chevron, so a form
        //   that mixes the two faces lines up; it is a `combobox` naming its list's state (`aria-expanded`), and owns
        //   the keys that open it (a `<button>`'s own Enter/Space would toggle it, so they are claimed and open it).
        Box(position: Position.Relative, w: "100%", minW: "0", onBlurWithin: open ? Dismiss : null) {
          Pressable(onClick: Toggle, role: UiRole.ComboBox, expanded: open, label: label, id: trigger, describedBy: note,
                    disabled: disabled, invalid: shownError != "", autoFocus: back,
                    keys: [Down, Up, Enter, Space], onKeyDown: BoxKey,
                    display: Display.Flex, align: Align.Center, w: "100%", textAlign: TextAlign.Left,
                    h: setting ? (size == Size.Lg ? Length.SettingControlHTouch : Length.SettingControlH) : "auto",
                    minH: setting ? "0" : (size == Size.Sm ? Length.SelectHSm : Length.SelectH),
                    pl: setting ? "10px" : (size == Size.Sm ? Space.SelectXSm : Space.SelectX), pr: Length.SelectChevronRoom,
                    py: setting ? "0" : (size == Size.Sm ? Space.SelectYSm : Space.SelectY),
                    fontFamily: setting ? Font.Sans : "inherit",
                    fontSize: setting ? (size == Size.Lg ? FontSize.SettingControlFontTouch : FontSize.SettingControlFont) : FontSize.Body,
                    fontWeight: setting ? FontWeight.Medium : "inherit",
                    rounded: setting ? Radius.SettingControl : Radius.Md, borderW: 1,
                    border: shownError != "" ? Colors.BorderDanger : (setting ? Colors.ControlBorder : Colors.Border),
                    bg: setting && disabled ? Colors.SettingLockedBg : Colors.Surface,
                    color: setting ? (disabled ? Colors.ProvenanceInk : Colors.OnSurface) : Colors.OnSurface,
                    cursor: disabled ? Cursor.NotAllowed : Cursor.Pointer) {
            Box(minW: "0", whiteSpace: WhiteSpace.Nowrap, overflow: Overflow.Hidden, textOverflow: TextOverflow.Ellipsis) {
              if (value != null && $"{value}" != "") {
                if (words != null) { Text(words(value)); } else { Text(value); }
              }
            }
          }
          Row(position: Position.Absolute, top: "0", right: "0", bottom: "0", align: Align.Center,
              pr: setting ? "10px" : (size == Size.Sm ? Space.SelectXSm : Space.SelectX), pointerEvents: PointerEvents.None) {
            Icon(Icons.ChevronDown, size: 12, color: Colors.SelectChevronInk);
          }
          if (open) {
            Backdrop(Dismiss);
            // The list is named BY the box (`labelledBy`), never with the box's own `label:` — two elements answering to
            // one name made the kit's `Dropdown` refuse its own control as ambiguous (see its panel). It owns the keys
            // that move in it, Escape while it is open, and Tab — which closes it rather than walking its options.
            Stack(role: UiRole.ListBox, labelledBy: trigger, keys: [Up, Down, Home, End, Enter, Space, Tab], onKeyDown: ListKey,
                  onEscape: Close, position: Position.Absolute, z: ZIndex.Popover, mt: 1, w: "100%", minW: Length.MenuW,
                  maxH: Length.OptionListMaxH, overflowY: Overflow.Auto, bg: Colors.Elevated, borderW: 1, border: Colors.Border,
                  rounded: Radius.Md, shadow: Shadow.Floating, p: 1, gap: "2px") {
              foreach (var m in options) {
                SelectOption(detail: detail(m), chosen: m == value, active: IndexOf(m) == at,
                             onPick: () => Choose(m), onArrive: () => Arrive(IndexOf(m))) {
                  if (words != null) { Text(words(m)); } else { Text(m); }
                }
              }
            }
          }
        }
      } else {
      if (label != "" && showLabel) { Text(label, labelFor: box, fontSize: FontSize.Label, fontWeight: FontWeight.LabelWeight, color: Colors.LabelInk); }
      // ⭐ ONE CHEVRON FOR EVERY DROPDOWN. `appearance: None` takes the browser's arrow away and the kit's is laid over
      //   the right padding the box keeps clear (`Length.SelectChevronRoom`), passing clicks through — so the select
      //   stays the one element the label names, and the whole box stays the click target.
      Box(position: Position.Relative, w: "100%", minW: "0") {
        // One element, two faces: the field's (the theme's select tokens; the base stylesheet's font, line and ground,
        // restated because a style prop is inline)
        // and a setting row's (`setting: true` — the `Setting*` tokens; `size: Size.Lg` is its phone height and type).
        Select(value: value, onChange: onChange, id: box, describedBy: note, disabled: disabled, label: label,
               invalid: shownError != "", appearance: Appearance.None, w: "100%",
               h: setting ? (size == Size.Lg ? Length.SettingControlHTouch : Length.SettingControlH) : "auto",
               minH: setting ? "0" : (size == Size.Sm ? Length.SelectHSm : Length.SelectH),
               pl: setting ? "10px" : (size == Size.Sm ? Space.SelectXSm : Space.SelectX), pr: Length.SelectChevronRoom,
               py: setting ? "0" : (size == Size.Sm ? Space.SelectYSm : Space.SelectY),
               fontFamily: setting ? Font.Sans : "inherit",
               fontSize: setting ? (size == Size.Lg ? FontSize.SettingControlFontTouch : FontSize.SettingControlFont) : FontSize.Body,
               fontWeight: setting ? FontWeight.Medium : "inherit",
               rounded: setting ? Radius.SettingControl : Radius.Md, borderW: 1,
               // Inline wins over the stylesheet, so the refused look (`aria-invalid`'s danger line) is said here too.
               border: shownError != "" ? Colors.BorderDanger : (setting ? Colors.ControlBorder : Colors.Border),
               bg: setting && disabled ? Colors.SettingLockedBg : Colors.Surface,
               color: setting ? (disabled ? Colors.ProvenanceInk : Colors.OnSurface) : "inherit",
               cursor: disabled ? Cursor.NotAllowed : Cursor.Pointer) {
          foreach (var m in options) { Option(m, value: m); }
        }
        Row(position: Position.Absolute, top: "0", right: "0", bottom: "0", align: Align.Center,
            pr: setting ? "10px" : (size == Size.Sm ? Space.SelectXSm : Space.SelectX), pointerEvents: PointerEvents.None) {
          Icon(Icons.ChevronDown, size: 12, color: Colors.SelectChevronInk);
        }
      }
      }
      if (shownError != "" || hint != "") {
        Text(shownError != "" ? shownError : hint, id: note, fontSize: FontSize.Caption,
             color: shownError != "" ? Colors.Danger : Colors.TextMuted);
      }
    }
  }
}

/// One option of a listed `SelectField`: its words (what it holds), and under them what it means; a tick on the chosen
/// one. It is the keyboard's stop while the list is open (the list moves the keyboard between its options, so a screen
/// reader hears each by its words — its name — then what it means — its description — and whether it is chosen); the
/// list's own keys decide where it goes next.
[Composable][Part]
component SelectOption(string detail = "", bool chosen = false, bool active = false, Action? onPick = null,
                       Action? onArrive = null) {
  variants {
    base { Rounded = Radius.Sm; Px = Space.OptionX; Py = Space.OptionY; Cursor = Cursor.Pointer;
           Hover { Bg = Colors.OptionHoverBg; }
           Focus { Bg = Colors.OptionHoverBg; OutlineW = 2; OutlineColor = Colors.Focus; OutlineOffset = "-2px"; OutlineStyle = OutlineStyle.Solid; } }
    chosen { Bg = Colors.OptionChosenBg; Hover { Bg = Colors.OptionChosenBg; } Focus { Bg = Colors.OptionChosenBg; } }
  }
  render {
    Row(role: UiRole.Option, selected: chosen, labelledBy: name, describedBy: meaning, onClick: onPick,
        onFocus: onArrive, autoFocus: active, align: Align.Start, gap: 2) {
      Stack(gap: Space.OptionLineGap, grow: 1, minW: "0") {
        Box(id: name, fontSize: FontSize.Body, fontWeight: FontWeight.Medium, color: Colors.OnSurface) { Slot; }
        if (detail != "") { Text(detail, id: meaning, fontSize: FontSize.Caption, color: Colors.OptionDetailInk); }
      }
      if (chosen) { Icon(Icons.Check, size: 14, color: Colors.Primary.Text); }
    }
  }
}
