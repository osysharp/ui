// Ui — how a page's UNIT OF WORK is shown: the three ways an app says "you have changes; keep them or not"
// (`using Osysharp.Ui;`). All three read and drive the SAME unit of work — the route's, which every edit on the page
// already joins — so switching from one to another is one line, never a change to how the page edits.
//
//   SaveBar      (Settings.osy) a bar that rises at the foot of the page while there are changes: Undo, Discard, Save.
//                For a page of many edits a person reviews before keeping — settings, a ledger, a long form.
//   SaveActions  the same three, INLINE — beside a record's title or in a drawer's head, where the eye already is.
//                For a record edited in place, a panel, a dense console.
//   AutoSave     no Save at all: the changes are kept by themselves a moment after the last one, and until then the
//                person can take them back. For notes, a CRM record, anything edited in passing.

namespace Osysharp.Ui;

/// Save and discard INLINE — "● Edited · Undo · Discard · Save", for a record's head (`PageHead`'s slot) or a drawer's,
/// shown only while the page holds unsaved changes (`Navigation.IsDirty`); once a save lands it says `saved` quietly in
/// the same place. Undo steps back to the last savepoint (`UnitOfWork.Mark("…")` before an edit makes one, and names the
/// button), Discard drops every unsaved change, Save commits them. Mod+S saves and Mod+Z undoes, from anywhere on the page.
/// `blockedBy` holds a save back with the sentence saying why, exactly as `SaveBar`'s; `onSaved` runs once a save lands.
/// A save the model's rules would refuse is HELD, not sent: the edits stay and each field in the way is shown.
/// A refused save says why ("Not saved — …") in the same place, and keeps the edits so they can be fixed and saved.
/// In a test: `Ui.Click("Save")`, `Ui.Click("Discard")`, and `Assert.Visible("Edited")` while there are changes.
/// need: save and cancel buttons beside the title, inline save, a dirty marker on a record, save in a side panel, discard changes in place
/// e.g. `PageHead(account.Name) { SaveActions(saved: "Saved."); }`
[Composable]
component SaveActions(string saved = "Saved", string blockedBy = "", Action onSaved = null) {
  string problem = "";
  bool justSaved = false;
  live var dirty = Navigation.IsDirty;
  live var canUndo = UnitOfWork.CanUndo();
  live var undoLabel = UnitOfWork.UndoLabel();

  action Save() {
    problem = "";
    justSaved = false;
    if (blockedBy != "") { return; }
    // HELD, NOT SENT: a save the model's own rules would refuse never leaves the page — the edits stay, every
    // field in the way is shown at its control, and the sentence says how many. (Sent, it would only come back refused:
    // a refused page save keeps its edits too, but the person would wait a round trip to learn what the page knew.)
    if (Validation.All.Count > 0) {
      Validation.Reveal();
      problem = Validation.All.Count == 1 ? "1 field needs attention." : Validation.All.Count.ToString() + " fields need attention.";
      return;
    }
    try {
      UnitOfWork.Commit();
      justSaved = true;
      if (onSaved != null) { onSaved(); }
    }
    // A lost race is the platform's to show: the conflict notice gives the person both values and Keep theirs /
    // Apply mine. Caught here it would read only "Not saved — …" with nothing to choose (`osy docs ui-conflict-notice`).
    catch (ConflictException) { throw; }
    // A refused save KEEPS the page's edits, so the reason shows beside them, still editable; each
    // field the server named shows its own sentence under it (`Validation.MessageFor`).
    catch (Exception ex) { problem = "Not saved — " + ex.Message; }
  }
  action Discard() { problem = ""; justSaved = false; UnitOfWork.Discard(); }
  action Undo() { problem = ""; UnitOfWork.Undo(); }

  render {
    Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap, label: "Changes") {
      if (dirty) {
        Row(gap: 1, align: Align.Center) {
          Lamp(lit: true, tone: Tone.Warning);
          Text("Edited", fontSize: FontSize.Caption, fontWeight: FontWeight.Medium, color: Colors.TextSecondary,
               role: UiRole.Status);
        }
        if (blockedBy != "") { Text(blockedBy, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert); }
        else if (problem != "") { Text(problem, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert); }
        if (canUndo) {
          IconButton(undoLabel != "" ? "Undo " + undoLabel.ToLower() : "Undo", Undo, size: Size.Sm, shortcut: "Mod+Z") {
            Icon(Icons.History, size: 15);
          }
        }
        Button("Discard", onPress: Discard, tone: Tone.Ghost, size: Size.Sm);
        Button("Save", onPress: Save, tone: Tone.Primary, size: Size.Sm, shortcut: "Mod+S", disabled: blockedBy != "");
      } else if (problem != "") {
        Text(problem, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert);
      } else if (justSaved && saved != "") {
        Row(gap: 1, align: Align.Center) {
          Icon(Icons.Check, size: 14, color: Colors.Success);
          Text(saved, color: Colors.TextMuted, fontSize: FontSize.Caption, role: UiRole.Status);
        }
      }
    }
  }
}

/// NO SAVE BUTTON — the page's changes are kept by themselves once the person has PAUSED for `after` seconds (every
/// edit restarts the count, read from `UnitOfWork.EditCount()`, so nothing is saved mid-word), and until then the
/// person can take them back: "Saving in 2 s · Undo", then "All changes saved". Undo steps back to the last savepoint
/// when there is one (`UnitOfWork.Mark`, or the step the platform marks for each edit) and otherwise drops the changes
/// waiting to be kept — an undo that is TRUE: what has been kept is kept, and the window to change your mind is the one
/// before it is. A save the model's rules would refuse is HELD — the changes stay, the fields in the way are shown, and
/// it tries again once the person has edited and paused; one the server refuses says why, with Retry.
/// Put it where a person glances to know their work is safe — a record's head, a panel's foot.
/// In a test: make an edit, `Assert.Visible("Saving in")`, then `Ui.Tick()` once per second of `after` and
/// `Assert.Visible("All changes saved")`; or `Ui.Click("Undo")` inside the window.
/// need: auto-save, save as you type, keep changes without a save button, undo an automatic save, saved indicator
/// e.g. `PageHead(contact.Name) { AutoSave(after: 2); }`
[Composable]
component AutoSave(int after = 2, string saved = "All changes saved") {
  string problem = "";
  bool everSaved = false;
  int waited = 0;
  int seenEdits = -1;   // the edit count the last tick saw — a different one means the person is still editing
  live var dirty = Navigation.IsDirty;
  live var canUndo = UnitOfWork.CanUndo();

  action Keep() {
    problem = "";
    // HELD, NOT SENT: a save the model's own rules would refuse never leaves the page — the edits stay, every
    // field in the way is shown at its control, and the sentence says how many. (Sent, it would only come back refused:
    // a refused page save keeps its edits too, but the person would wait a round trip to learn what the page knew.)
    if (Validation.All.Count > 0) {
      Validation.Reveal();
      problem = Validation.All.Count == 1 ? "1 field needs attention." : Validation.All.Count.ToString() + " fields need attention.";
      waited = 0;
      return;
    }
    try {
      UnitOfWork.Commit();
      everSaved = true;
      waited = 0;
    }
    catch (ConflictException) { waited = 0; throw; }   // the conflict notice is the platform's — see SaveActions.Save
    catch (Exception ex) { problem = ex.Message; waited = 0; }
  }
  action TakeBack() {
    problem = "";
    waited = 0;
    if (UnitOfWork.CanUndo()) { UnitOfWork.Undo(); } else { UnitOfWork.Discard(); }
  }

  // One tick a second: while there are changes (and the last attempt was not refused), count the QUIET seconds — an
  // edit since the last tick starts the count again — and at `after` of them, keep the changes.
  on every (TimeSpan.FromSeconds(1)) {
    var edits = UnitOfWork.EditCount();
    if (!dirty) { waited = 0; seenEdits = edits; }
    // A new edit after a held or refused save is the person fixing it: the count starts over and it is tried again.
    else if (edits != seenEdits) { seenEdits = edits; problem = ""; waited = 1; if (waited >= after) { Keep(); } }
    else if (problem == "") {
      waited = waited + 1;
      if (waited >= after) { Keep(); }
    }
  }

  render {
    Row(gap: 2, align: Align.Center, label: "Saving") {
      if (problem != "") {
        Icon(Icons.Warning, size: 14, color: Colors.Danger);
        Text("Not saved — " + problem, color: Colors.Danger, fontSize: FontSize.Caption, role: UiRole.Alert);
        Button("Retry", onPress: Keep, tone: Tone.Ghost, size: Size.Sm);
      } else if (dirty) {
        Lamp(lit: true, live: true, tone: Tone.Primary);
        Text("Saving in " + (after - waited < 1 ? 1 : after - waited).ToString() + " s", fontSize: FontSize.Caption,
             color: Colors.TextSecondary, role: UiRole.Status);
        Button("Undo", onPress: TakeBack, tone: Tone.Ghost, size: Size.Sm, shortcut: "Mod+Z");
      } else if (everSaved) {
        Icon(Icons.Check, size: 14, color: Colors.Success);
        Text(saved, color: Colors.TextMuted, fontSize: FontSize.Caption, role: UiRole.Status);
      }
    }
  }
}

/// THE THREE ANSWERS TO "this page has unsaved changes" — Keep editing, Save and leave, Discard and leave — raised by
/// a shell when the reader asks to go somewhere else (`SidebarShell`'s rail, `FocusedShell`'s exit). One prompt for the
/// whole kit, so every shell asks in the same words and with the same safety rules.
///
/// ⭐ SAVE IS OFFERED ONLY WHEN THE PAGE SAYS IT CAN BE SAVED — `canSave` is `Navigation.CanSave(path)`, the page's own
///    `derived canSave` guard (true when it declares none), snapshotted by the action that raises the prompt.
/// ⚠ KEEP EDITING IS THE DISMISS, so Escape and a backdrop click do it too: the safe answer is the one reached by doing
///   nothing. THE DESTRUCTIVE ANSWER IS LAST AND TONED `Danger` — Discard drops the page's unit of work for real.
/// ⚠ A REFUSED SAVE KEEPS THE PROMPT UP with the server's words in `error`; a prompt that closed on a failed save
///   would look exactly like one that worked.
/// need: warn before leaving a page with unsaved changes, ask save or discard before navigating away, leave guard
/// In a test: `Assert.Dialog("Leave without saving?")`, then `Ui.Click("Keep editing")`.
/// e.g. `if (leaving != "") { LeavePrompt(canSave, error, SaveAndLeave, DiscardAndLeave, KeepEditing); }`
[Composable]
component LeavePrompt(bool canSave, string error, Action onSave, Action onDiscard, Action onKeep,
                      string subtitle = "This page has changes that have not been saved yet.",
                      string saveLabel = "Save and leave", string discardLabel = "Discard and leave") {
  render {
    Dialog("Leave without saving?", onDismiss: onKeep, subtitle: subtitle) {
      if (error != "") { Alert(error, title: "That could not be saved", tone: Tone.Danger); }
      slot actions {
        Button("Keep editing", onPress: onKeep, tone: Tone.Ghost);
        if (canSave) { Button(saveLabel, onPress: onSave, tone: Tone.Primary); }
        Button(discardLabel, onPress: onDiscard, tone: Tone.Danger);
      }
    }
  }
}
