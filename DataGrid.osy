// M127 — the DataGrid as ORDINARY OSY#, replacing the foreign `control DataGrid<T>` and its 56KB bundled shim.

// The `Osysharp.Ui` kit namespace — its public types enter scope only via `using Osysharp.Ui;`.
namespace Osysharp.Ui;

/// What KIND of value a column holds. It decides which operators the column's filter offers — a `Number`
/// column has no use for "contains", and a `Text` column has none for "greater than".
public enum GridColumnKind { Text, Number, Date }

/// How a filter compares a cell against what was typed. Which of these a column offers follows from its
/// `Kind`, so a filter row never presents an operator that cannot mean anything for that column.
public enum GridOp { Contains, Equals, StartsWith, GreaterThan, LessThan, IsEmpty, IsNotEmpty }

/// ONE COLUMN'S FILTER — which column, how to compare, and what to compare against. A `GridFilter[]` is the
/// grid's whole filter model, and it is the same shape whether a person typed it into the filter row or the
/// page computed it: pass one in `filters:` to constrain the grid from outside, and read the user's own back
/// Both are ANDed, so a page can pin a constraint the grid cannot widen.
public sealed class GridFilter {
  /// The `Name` of the column this applies to. A filter naming no column is ignored rather than refused —
  /// a saved view outliving a renamed column must not take the page down.
  public string Column;
  /// How to compare. `Contains` by default, which is what a filter box does when someone just types.
  public GridOp Op = GridOp.Contains;
  /// What to compare against, as typed. Empty means the filter is dormant — which is what an empty filter
  /// box has to mean, or typing and then clearing it would hide every row.
  public string Value = "";
}

/// One column — what to call it, and how to read it off a row. `Value` is a selector over T, checked against the
/// row type; it may compute (`f => Text.ByteSize(f.Size)`) as well as name a field.
public sealed class GridColumn<T> {
  /// This column's IDENTITY, and its slot name: `slot <Name> { row => … }` overrides its cell with a template —
  /// use it to render a badge or a control in place of a string.
  public string Name;
  /// The header text. May be empty — see `Name`.
  public string Label;
  /// How to read this column's text off a row. It may also read the PAGE's own state (C-41): a selector captures
  /// its enclosing scope by value, so `u => wardens.Any(g => g.User == u) ? "Warden" : "Ringer"` is an ordinary column
  /// even though the answer lives in another of the page's queries.
  public Func<T, string> Value;
  /// "left" (default) | "right" | "center".
  public string? Align;
  /// This column's width in px, and what a resize DRAG writes.
  public int Width = 200;
  /// This column ABSORBS the leftover width. Set it on the column people scan. Only one column should claim it;
  /// if several do, they split it evenly.
  public bool Fill;
  /// Card view: this column is the card's HEADING. Defaults to the first column when no column claims it.
  public bool Title;
  /// Card view: this column is the card's muted SUBTITLE under the heading.
  public bool Secondary;
  /// Can this column be sorted by? Default yes.
  public bool Sortable = true;
  /// What kind of value this column holds — it chooses the operators its filter offers.
  public GridColumnKind Kind = GridColumnKind.Text;
  /// The NUMBER this column really holds, when `Value` formats it for a reader (`"120 000 kr"`).
  /// ⭐ IT DRIVES BOTH SORTING AND FILTERING: without it the column is ordered and compared as TEXT, which
  /// puts 100 before 9. Give it and `> 100000` means what it says and the column sorts as a quantity.
  /// It is also what a group band can SUM.
  public Func<T, decimal>? Number;
  /// The DATE this column really holds, for the same reasons — ordering and `> 2027-01-01` both need the
  /// date, not its spelling.
  public Func<T, DateTime>? Date;
  /// Can this column be filtered? Default yes. Set it false for a column whose cell is a control or a
  /// badge rendered through a `slot`, where filtering the underlying text would puzzle rather than help.
  public bool Filterable = true;
  /// GROUP the rows by this column: one collapsible band per distinct value, carrying its row count and
  /// the total of every `Number` column. The FIRST column claiming it wins — two groupings at once is a
  /// pivot table, which is a different control.
  public bool Group;
}

/// One GROUP BAND of a grouped grid: the value the rows share, and the rows themselves.
///
/// ⚑ IT HOLDS ITS ROWS, and that is the whole point. The bands were a `List<string>` of keys while a generic
/// component's member could not return `T[]` (P-27) — so every row loop re-tested `KeyOf(r) == band` and the
/// count and totals each re-walked the view. It also made a grouped grid untestable at the text tier: a `foreach`
/// over STRINGS stamps each string as a rendered item, so `Assert.Items` counted BANDS and `Assert.Before` could
/// not reach a row. A class instance stamps nothing, so what gets counted is the rows.
public sealed class GridBand<T> {
  /// The grouping column's value for every row in this band. May be empty — an empty grouping value is a real
  /// group, and the band renders it as "(none)" rather than as a blank nobody can tell from a fault.
  public string Key;
  /// This band's rows, in the order the view already sorts them — grouping reorders nothing WITHIN a band.
  public T[] Rows;
}

/// A sortable, resizable, templatable table that becomes a card list on a narrow screen.
/// ⭐ COLUMNS WIDER THAN THE SPACE SCROLL SIDEWAYS rather than being cut off, and the header row and the filter row
/// scroll WITH the data, so a column never labels the wrong values. Your `Width` numbers decide when that starts;
/// nothing is dropped, the search box and `Columns` stay put above the scrolling table, and the page itself never
/// scrolls sideways.
/// In a test read a cell by its row and column: `Assert.Cell(order, "Total", "120.00")`, and count rows with `Assert.Items(...)`.
/// need: show many rows in columns, a sortable table of records, a list with headers
/// e.g. `DataGrid(rows: orders, columns: [ new GridColumn<Order> { Name = "Ref", Label = "Clapper", Value = o => o.Reference } ], rowSelected: Open)`
// ⛔ `label` IS REQUIRED, and it is the one parameter here that cannot have a sensible default. This control
//    renders `role="grid"`, and a grid with no accessible name is INVALID ARIA — a screen reader announces
//    nothing, and `Ui.Within("…")` cannot reach it, so no UI test can drive what it holds either. `= ""` was not a
//    default, it was the absence of a name, and ten of the eleven call sites in this repo took it.
//
// ⚑ Caught by `KitCatalogTests`, which had been red for exactly this and which nothing in a normal loop runs.
//    Moved ahead of the defaulted parameters because a required one must come first; every call site names its
//    arguments, so nothing reorders.
// ⚠ AND `label` COMES FIRST, like every other captioned control in this kit. An author who has just written
//    `Field("Serial number", value: x)` writes the next one the same way; a control that disagrees answers a
//    rather than a control. (Also gated.)
[Composable] component DataGrid<T>(string label, T[] rows, GridColumn<T>[] columns,
                                   Action<T>? rowSelected = null,
                                   bool filterable = false, GridFilter[] filters = [],
                                   Action<string>? onExport = null,
                                   string view = "", Action<string>? onViewChange = null,
                                   bool selectable = false, Action<T[]>? onSelectionChange = null,
                                   string sortColumn = "", bool sortDescending = false) {
  // `label:` NAMES THE GRID — for a screen reader, and for a test.
  //
  // ⚠ ADDED BECAUSE THE CONTROL'S OWN DOCUMENTATION WAS FALSE. Its summary says "in a test … count rows with
  //   `Assert.Items(...)`", and `Assert.Items` locates a list the way everything else is located: by what a person
  //   would call it. This grid gave its row region a ROLE and no NAME, so there was nothing to locate and the
  //   assertion failed with "there is no list 'rows' on this screen" — for the recipe the control itself prints.
  //   Measured writing the grid's own behavioural test, which is the only reason it was ever noticed.
  //
  //   Empty by default, so nothing about an existing call changes; a grid with two of it on one page is exactly
  //   when you need the name anyway.
  // THE ORDER THE ROWS ARRIVE IN — `sortColumn:` names the column (by its `Name`) and `sortDescending:` the direction,
  // so an incident list opens newest first and a ledger by amount. The reader re-sorts from there; a name that matches
  // no column falls back to the first, as a saved view naming a renamed column does.
  GridColumn<T> sortBy = InitialSort();
  bool descending = sortDescending;

  GridColumn<T> InitialSort() {
    foreach (var c in columns) { if (c.Name == sortColumn) { return c; } }
    return columns[0];
  }

  // ── THE READER'S VIEW ───────────────────────────────────────────────────────────────────────
  //
  // ⚑ NAMES, NOT COLUMNS — and this is now a CHOICE rather than a constraint. It was written when a generic
  //   component's member could not return `GridColumn<T>[]` (P-27, fixed): an ordered/filtered column LIST was
  //   simply not expressible, so names were the only shape available. It stays because it is independently the
  //   right one for P-09 — a saved view is these three lists and a sort, which is exactly what survives a
  //   recompile, where a list of column OBJECTS would not.
  //
  // ⚠ AND IT NEVER MUTATES `columns`. That array belongs to the CALLER: reordering it would reorder every
  //   other grid sharing it, and a reader's choice would leak into the page's own model.
  List<string> order = NamesOf();
  List<string> hidden = [];
  string groupBy = InitialGroup();

  List<string> NamesOf() {
    var names = new List<string>();
    foreach (var c in columns) { names.Add(c.Name); }
    return names;
  }

  /// The column a `Group = true` DECLARED, which the reader may then change or clear.
  string InitialGroup() {
    foreach (var c in columns) { if (c.Group) { return c.Name; } }
    return "";
  }

  bool Shown(string name) { return !hidden.Contains(name); }

  /// THE TABLE'S OWN WIDTH — every shown column's declared width plus the horizontal padding each row carries
  /// (`px: 3`, so 12px a side). It is the `minW` of the region the header row, the filter row and the data rows
  /// all live in, and it is what makes those three ONE horizontal scroll context: they cannot slide apart,
  /// because they are the same box.
  ///
  /// ⛔ WITHOUT IT A ROW'S BOX STOPS AT THE CONTAINER'S EDGE while its cells carry on past it — `FixedCell` sets
  ///    `Shrink = 0`, which is right (a column keeps the width its author asked for) and is exactly why the excess
  ///    has to go somewhere. Measured 2026-09-08 on `demo/shell-arrangements` at `/r/incidents`: seven columns
  ///    summing to 1,090px in a 958px column, so the seventh header read `Sta…`, the last filter input was cut
  ///    through its middle, and the Started column rendered as `2 (`, `Ye`, `08`, `09`. Nothing scrolled — the
  ///    content was simply painted past its container and occluded by whatever was next to it. The same grid
  ///    clipped identically in `SidebarShell` and `TabbedShell` (scrollWidth 1923 in all three), so it was never
  ///    the shell: it was this control never bounding its own rows.
  ///
  /// ⚑ A `Fill` column contributes its DECLARED `Width` here, not its content. `Fill` means "absorb whatever is
  ///   left over" and `Width` is then its floor — so a grid that fits its container today is untouched (the
  ///   minimum is not binding and the fill column still absorbs), and a grid too wide for its container scrolls
  ///   to exactly the width its author asked for rather than to the length of its longest string.
  int TableW() {
    var total = selectable ? 60 : 24;   // the pick column is 36px
    foreach (var c in columns) { if (Shown(c.Name)) { total = total + c.Width; } }
    return total;
  }

  /// Move a column one place left or right in the reader's order. A whole new list — writing an element in
  /// place leaves the signal on the same reference and nothing re-renders.
  action MoveColumn(string name, int delta) {
    var from = order.IndexOf(name);
    var to = from + delta;
    if (from < 0 || to < 0 || to >= order.Count) { return; }
    var next = new List<string>();
    for (int i = 0; i < order.Count; i = i + 1) {
      if (i == from) { next.Add(order[to]); }
      else if (i == to) { next.Add(order[from]); }
      else { next.Add(order[i]); }
    }
    order = next;
    Changed();
  }

  action ToggleColumn(string name) {
    var next = new List<string>();
    bool wasShown = Shown(name);
    foreach (var n in hidden) { if (n != name) { next.Add(n); } }
    if (wasShown) { next.Add(name); }
    hidden = next;
    Changed();
  }

  /// Group by this column, or clear the grouping when it is already the one grouping.
  action GroupByColumn(string name) { groupBy = groupBy == name ? "" : name; Changed(); }

  action SortByColumn(GridColumn<T> c) {
    if (sortBy == c) { descending = !descending; } else { sortBy = c; descending = false; }
    Changed();
  }

  // ⭐ SORT BY WHAT THE COLUMN HOLDS, not by how it is spelled. This read `rows.OrderBy(sortBy.Value)`,
  //    and `Value` is a `Func<T,string>` — so a money column ordered "100" before "9" and a date column
  //    ordered by its formatting. Nothing reported it: the grid sorted, visibly, into the wrong order.
  //
  //    A ternary rather than one selector chosen up front, because only the taken branch is evaluated —
  //    which is what makes a NULL selector safe to name here. A helper returning the ordered rows reads
  //    better and is now legal (P-27); it is left as a `live var` because that is what keeps it CURRENT,
  //    which a plain helper would not be.
  live var sorted =
      sortBy.Number != null
        ? (descending ? rows.OrderByDescending(sortBy.Number) : rows.OrderBy(sortBy.Number))
        : (sortBy.Date != null
            ? (descending ? rows.OrderByDescending(sortBy.Date) : rows.OrderBy(sortBy.Date))
            : (descending ? rows.OrderByDescending(sortBy.Value) : rows.OrderBy(sortBy.Value)));

  // ── P-06 · FILTERING ────────────────────────────────────────────────────────────────────────
  //
  // ── the per-column filter row (krav 2.1.24) ─────────────────────────────────────────────────
  //
  // ⚑ THIS COULD NOT BE WRITTEN UNTIL P-24, and the note that used to sit here explained why: a bound box per
  //   column is a FIELD per column, and `columns` is a prop. Two shapes were tried and both failed — a binding
  //   into a `List<GridFilter>` element compiled and was INERT, and a child pushing its own text up on
  //   `on change` killed the client in a remount loop. `Input(value: typed[i])` binds an ELEMENT of this
  //   component's own list, which is a write path that exists.
  //
  // ⚠ REPLACE, NEVER MUTATE. `SetFilter` builds a whole new list: writing an element in place leaves the signal
  //   on the same reference, so nothing re-renders and the box goes inert again.
  List<string> typed = Blanks();

  List<string> Blanks() {
    var seeded = new List<string>();
    foreach (var c in columns) { seeded.Add(""); }
    return seeded;
  }

  /// The QUICK FILTER — one box, every column. It is what the narrow arm shows (a filter row of boxes does
  /// not fit a phone, and one box per column on a card list would be six boxes above two cards), and it is
  /// offered on the table too because "find the row that says Ada" is the commonest thing anybody wants.
  string search = "";

  bool MatchesSearch(T r) {
    if (search.Trim() == "") { return true; }
    var needle = search.Trim().ToLower();
    foreach (var c in columns) { if (c.Value(r).ToLower().Contains(needle)) { return true; } }
    return false;
  }

  /// THE OPERATOR, from a leading `>`, `<`, `=` or `^` in the value — the spreadsheet idiom, so a page's
  /// own filter box needs no operator dropdown beside it. No prefix means the filter's own `Op`.
  GridOp OpOf(string raw, GridOp fallback) {
    if (raw.StartsWith(">")) { return GridOp.GreaterThan; }
    if (raw.StartsWith("<")) { return GridOp.LessThan; }
    if (raw.StartsWith("=")) { return GridOp.Equals; }
    if (raw.StartsWith("^")) { return GridOp.StartsWith; }
    return fallback;
  }

  /// What to compare against, with any operator prefix taken off.
  string WantOf(string raw) {
    if (raw.StartsWith(">") || raw.StartsWith("<") || raw.StartsWith("=") || raw.StartsWith("^")) {
      return raw.Substring(1).Trim();
    }
    return raw.Trim();
  }

  /// ⭐ THE OPERATOR SET THE TYPE IMPLIES (krav 2.1.24). A `Number` column has no use for "contains" and a
  /// `Text` column none for "greater than" — so an operator the kind cannot mean is IGNORED rather than
  /// applied nonsensically. Typing `>` into a text filter therefore shows everything, which is the honest
  /// answer: the alternative is comparing words alphabetically and calling it a range.
  bool Allows(GridColumnKind kind, GridOp op) {
    if (kind == GridColumnKind.Text) { return op == GridOp.Contains || op == GridOp.Equals || op == GridOp.StartsWith; }
    return op == GridOp.Equals || op == GridOp.GreaterThan || op == GridOp.LessThan;
  }

  bool Compare(T r, GridColumn<T> c, GridOp op, string want) {
    if (c.Kind == GridColumnKind.Number && c.Number != null) {
      decimal got = c.Number(r);
      // A HALF-TYPED NUMBER SHOWS EVERYTHING rather than nothing. Somebody typing ">1" on the way to
      // ">1000" must not watch the grid empty itself and conclude the filter is broken.
      if (!decimal.TryParse(want, out var w)) { return true; }
      if (op == GridOp.GreaterThan) { return got > w; }
      if (op == GridOp.LessThan) { return got < w; }
      return got == w;
    }
    if (c.Kind == GridColumnKind.Date && c.Date != null) {
      DateTime gotDate = c.Date(r);
      if (!DateTime.TryParse(want, out var wd)) { return true; }
      if (op == GridOp.GreaterThan) { return gotDate > wd; }
      if (op == GridOp.LessThan) { return gotDate < wd; }
      return gotDate.Date == wd.Value.Date;
    }
    // Everything else compares the TEXT the reader can actually see, case-insensitively — including a
    // Number/Date column that declared no typed selector, where the text is all there is.
    string text = c.Value(r).ToLower();
    string wl = want.ToLower();
    if (op == GridOp.Equals) { return text == wl; }
    if (op == GridOp.StartsWith) { return text.StartsWith(wl); }
    return text.Contains(wl);
  }

  /// The operator a value carries when it names none. ⚠ NOT ALWAYS `Contains`: `Allows` rejects Contains
  /// on a Number or Date column, so a plain `GridFilter { Column = "Total", Value = "100" }` was matching
  /// EVERYTHING — the commonest filter anybody writes, silently doing nothing. On those columns the
  /// unprefixed reading is equality, which is what "100" means about a quantity.
  GridOp DefaultOp(GridColumnKind kind) {
    return kind == GridColumnKind.Text ? GridOp.Contains : GridOp.Equals;
  }

  bool MatchColumn(T r, GridColumn<T> c, string raw, GridOp fallback) {
    var want = WantOf(raw);
    if (want == "") { return true; }
    var op = OpOf(raw, fallback == GridOp.Contains ? DefaultOp(c.Kind) : fallback);
    // An operator this kind cannot mean is dropped, not applied — see `Allows`.
    if (!Allows(c.Kind, op)) { return true; }
    return Compare(r, c, op, want);
  }

  bool Match(T r, GridFilter f) {
    bool matched = true;
    foreach (var c in columns) { if (c.Name == f.Column) { matched = MatchColumn(r, c, f.Value, f.Op); } }
    return matched;   // a filter naming no column is IGNORED: a saved view outliving a rename must not blank the grid
  }

  /// Both filter models, ANDed: the `filters:` a page imposes, and the quick search a person typed here.
  /// So a page can pin a constraint the search cannot widen.
  bool Passes(T r) {
    if (!MatchesSearch(r)) { return false; }
    foreach (var f in filters) { if (!Match(r, f)) { return false; } }
    foreach (var c in columns) {
      if (!MatchColumn(r, c, typed[columns.IndexOf(c)], GridOp.Contains)) { return false; }
    }
    return true;
  }

  /// ⭐ THE VIEW, COMPUTED ONCE — sorted, then filtered. Everything downstream reads THIS: the bands, the per-band
  /// count and sums, the export, both render arms and the empty state.
  ///
  /// ⚑ IT COULD NOT BE WRITTEN UNTIL P-27. `T[]` was not a legal return for a generic component's member and a
  ///   collection of an open element was not a query SOURCE, so `sorted.Where(r => Passes(r))` had nothing to be.
  ///   The grid therefore carried `foreach (var r in sorted) { if (Passes(r)) … }` in EIGHT places, and `Passes`
  ///   walks every column and every filter — so a 500-row grid with 8 columns re-ran that per row per site, and
  ///   `SumsIn` re-ran it per row per NUMBER COLUMN per band on top. The cost was never the point though: eight
  ///   copies of "what the reader is looking at" is eight chances for them to disagree, and the export drifting
  ///   from the screen is precisely what krav 2.1.24 forbids.
  ///
  /// ⚠ A `live var`, not a helper. That is what keeps it CURRENT when the search text, a column filter or the sort
  ///   changes — a plain method would recompute on call and re-render nothing.
  live var visible = sorted.Where(r => Passes(r));

  bool AnyFilter() {
    if (search.Trim() != "") { return true; }
    if (AnyColumnFilter()) { return true; }
    foreach (var f in filters) { if (WantOf(f.Value) != "") { return true; } }
    return false;
  }

  bool AnyColumnFilter() {
    foreach (var t in typed) { if (WantOf(t) != "") { return true; } }
    return false;
  }

  /// Clears what THIS grid owns — the quick search and the filter row. A `filters:` entry belongs to the page and
  /// is deliberately untouched; the empty state only offers this button when there is something here to clear.
  action ClearFilters() { search = ""; typed = Blanks(); }

  // ── A CALM HEADER — the filter row is ASKED FOR, not standing ───────────────────────────────
  //
  // ⚑ READING IS THE COMMON CASE, so the per-column boxes (and their `contains…` / `= > <` hints) are not drawn until
  //   somebody asks to filter: the toolbar's `Filter` toggle opens the whole row, and each column header's funnel opens
  //   it with that column's box already focused. A filter that is SET stays in view while the row is shut — as a chip
  //   saying what it is, with a × that removes it — because a constraint you can no longer see is a page that looks
  //   broken ("where did half my accounts go?").
  bool filtersOpen = false;
  /// The column whose box takes the keyboard when the row opens from its header ("" = none, the toolbar's toggle).
  string focusFilter = "";

  action ToggleFilters() { filtersOpen = !filtersOpen; focusFilter = ""; }
  action FilterColumn(string name) { filtersOpen = true; focusFilter = name; }
  /// One chip's ×: that column's filter, gone. A whole new list — see `typed`.
  action ClearColumnFilter(string name) {
    var next = new List<string>();
    foreach (var c in columns) { next.Add(c.Name == name ? "" : typed[columns.IndexOf(c)]); }
    typed = next;
  }

  int ColumnFilterCount() {
    var n = 0;
    foreach (var t in typed) { if (WantOf(t) != "") { n = n + 1; } }
    return n;
  }

  /// What a chip says: the column, the comparison in words, the value — `Annual value over 100000`, never `> 100000`.
  string ChipText(GridColumn<T> c, string raw) {
    var op = OpOf(raw, DefaultOp(c.Kind));
    var want = WantOf(raw);
    if (op == GridOp.GreaterThan) { return c.Label + " over " + want; }
    if (op == GridOp.LessThan) { return c.Label + " under " + want; }
    if (op == GridOp.StartsWith) { return c.Label + " starts with " + want; }
    if (op == GridOp.Equals) { return c.Label + " is " + want; }
    return c.Label + " contains " + want;
  }

  // ── SELECTION — a toolbar that knows what is picked ─────────────────────────────────────────
  //
  // ⚑ THE GRID HOLDS THE PICK, THE APP HOLDS THE VERBS. `selectable: true` puts a check at the head of every row; while
  //   anything is picked the toolbar BECOMES the selection's — "3 selected", the app's `slot selection { picked => … }`
  //   buttons, and Clear — so the actions a reader can take are the ones that apply to what they picked, where they
  //   are looking. `onSelectionChange` hands the pick to a page that wants it outside the grid as well.
  // ⚠ ROWS, NOT KEYS: a row is compared by identity, so a pick survives sorting and filtering (a row filtered out of
  //   view stays picked — the count says so, which is the honest answer to "what will Archive act on?").
  List<T> picked = [];

  bool IsPicked(T r) { return picked.Contains(r); }
  /// What a row's check is called — "Select Kestrel Freight": the row's TITLE column (the first, when none claims it),
  /// so a screen reader hears which row, and a test presses `Ui.Click("Select Kestrel Freight")`.
  string PickName(T r) {
    foreach (var c in columns) { if (c.Title) { return c.Value(r); } }
    return columns[0].Value(r);
  }
  bool AllVisiblePicked() {
    if (visible.Count == 0) { return false; }
    foreach (var r in visible) { if (!picked.Contains(r)) { return false; } }
    return true;
  }

  action TogglePick(T r) {
    var next = new List<T>();
    foreach (var p in picked) { if (p != r) { next.Add(p); } }
    if (!picked.Contains(r)) { next.Add(r); }
    picked = next;
    Picked();
  }
  /// The head check: everything in view, or — when everything in view is already picked — nothing.
  action TogglePickAll() {
    var next = new List<T>();
    if (!AllVisiblePicked()) {
      foreach (var p in picked) { next.Add(p); }
      foreach (var r in visible) { if (!next.Contains(r)) { next.Add(r); } }
    }
    picked = next;
    Picked();
  }
  action ClearPick() { picked = []; Picked(); }
  action Picked() { if (onSelectionChange != null) { onSelectionChange(picked.ToArray()); } }

  // ── P-07 · GROUPING ─────────────────────────────────────────────────────────────────────────
  // One BAND per distinct value of the grouping column, and a band HOLDS ITS ROWS.
  //
  // ⚑ IT USED TO HOLD ONLY A KEY, and that was forced: a generic component's member could not return `T[]`
  //   (P-27), so a list of row GROUPS had nothing to be. Every row loop therefore re-tested `KeyOf(r) == band`,
  //   and `CountIn`/`SumsIn` each walked the whole view again per band.
  //
  // ⛔ AND THE KEY-ONLY SHAPE BROKE TESTING, which is the half nobody would predict. `Bands()` returned a
  //   `List<string>`, and a `foreach` over STRINGS stamps each string as a rendered ITEM — a bare string is its
  //   own identity. So a grouped grid reported the BAND count to `Assert.Items` (measured: 2, over 4 rows) and
  //   `Assert.Before` could not reach a data row at all, reporting `Rendered rows: [1] ▼ Ada [2] ▼ Grace`. A
  //   grouped grid silently stopped being testable at the text tier — the exact trap this file already documents
  //   for `order`, one loop away. A CLASS instance carries no identity and stamps nothing, so the rows inside are
  //   what get counted, which is what a reader means by "how many rows is it showing".
  bool Grouped() { return groupBy != ""; }

  string KeyOf(T r) {
    foreach (var c in columns) { if (c.Name == groupBy) { return c.Value(r); } }
    return "";
  }

  /// The bands, in the order the rows already sort in — so grouping REORDERS NOTHING WITHIN a band, and
  /// the bands themselves appear in the order their first row does. A band list built by sorting the keys
  /// would silently override the column the reader chose to sort by.
  List<GridBand<T>> Bands() {
    var bands = new List<GridBand<T>>();
    foreach (var r in visible) {
      var k = KeyOf(r);
      bool seen = false;
      foreach (var b in bands) { if (b.Key == k) { seen = true; } }
      // The band takes its rows in ONE go — `visible` is already sorted and filtered, so the slice is the band.
      if (!seen) { bands.Add(new GridBand<T> { Key = k, Rows = visible.Where(x => KeyOf(x) == k) }); }
    }
    return bands;
  }

  /// The band's aggregates: every `Number` column that declared its selector, totalled. A column with no
  /// selector is skipped rather than guessed at — its text cannot be added up.
  string SumsIn(GridBand<T> band) {
    var parts = "";
    foreach (var c in columns) {
      if (c.Kind == GridColumnKind.Number && c.Number != null) {
        decimal total = 0;
        foreach (var r in band.Rows) { total = total + c.Number(r); }
        parts = parts + (parts == "" ? "" : "  ·  ") + c.Label + " " + total.ToString("N0");
      }
    }
    return parts;
  }

  List<string> collapsed = [];
  action ToggleBand(string band) {
    var next = new List<string>();
    bool wasOpen = !collapsed.Contains(band);
    foreach (var k in collapsed) { if (k != band) { next.Add(k); } }
    if (wasOpen) { next.Add(band); }
    collapsed = next;
  }
  bool IsCollapsed(string band) { return collapsed.Contains(band); }

  // ── P-08 · EXPORT ───────────────────────────────────────────────────────────────────────────
  //
  // ⚑ THE GRID PRODUCES TEXT; THE APP DECIDES WHAT TO DO WITH IT. A control cannot write a file, and the
  //   platform's CSV writer (P-05) is not built — but neither is in the way of the part that is actually the
  //   grid's: what the CURRENT VIEW contains, in the order it is on screen. `onExport` is the seam, and when
  //   P-05 lands it replaces the quoting below and nothing else.
  //
  // ⚠ IT EXPORTS THE VIEW, NOT THE ROWS. Filter, sort, grouping and the column set all apply — a button labelled
  //   Export that hands back everything would be lying about what the person is looking at, which is the whole
  //   requirement (krav 2.1.24).

  /// RFC 4180: a field containing a comma, a quote or a newline is wrapped in quotes, and an inner quote is
  /// doubled. Without this a single "Lovelace, Ada" silently becomes two columns for every reader downstream.
  string Csv(string field) {
    if (!field.Contains(",") && !field.Contains("\"") && !field.Contains("\n")) { return field; }
    return "\"" + field.Replace("\"", "\"\"") + "\"";
  }

  // ⚠ THE READER'S ORDER AND THE READER'S COLUMNS. Exporting the caller's array would hand back a file whose
  //   columns are in a different order from the screen, with the hidden ones back — which is the same lie as
  //   exporting the unfiltered rows, one dimension over.
  string CsvRow(T r) {
    var line = "";
    foreach (var name in order) {
      if (Shown(name)) {
        foreach (var c in columns) { if (c.Name == name) { line = line + (line == "" ? "" : ",") + Csv(c.Value(r)); } }
      }
    }
    return line;
  }

  string ExportText() {
    var head = "";
    foreach (var name in order) {
      if (Shown(name)) {
        foreach (var c in columns) { if (c.Name == name) { head = head + (head == "" ? "" : ",") + Csv(c.Label); } }
      }
    }
    var body = "";
    if (Grouped()) {
      // Band by band, so the file reads in the order the screen does.
      foreach (var band in Bands()) {
        foreach (var r in band.Rows) { body = body + "\n" + CsvRow(r); }
      }
    } else {
      foreach (var r in visible) { body = body + "\n" + CsvRow(r); }
    }
    return head + body;
  }

  action Export() { onExport(ExportText()); }

  bool showColumnMenu = false;
  action ToggleColumnMenu() { showColumnMenu = !showColumnMenu; }

  // ── P-09 · THE READER'S VIEW, AS A STRING ───────────────────────────────────────────────────
  //
  // ⚑ THE GRID OWNS THE STATE; THE APP OWNS THE STORAGE — the same seam as `onExport`, and for the same
  //   reason. Naming views, listing them and deciding who may see whose is an application's job with an
  //   application's security block; what only the grid can do is say what the current view IS and take one
  //   back. So it serializes to a string, and an app persists that string against a name and a user.
  //
  // ⚠ APPLIED AT MOUNT, AND ONLY AT MOUNT. A grid that re-applied `view` whenever the prop changed would be
  //   one assignment away from the loop that killed the client in P-26: report a change, the app stores it,
  //   the prop comes back, the grid re-applies, which reports a change. Restoring a DIFFERENT saved view is
  //   therefore a remount — which a route change already gives an app for free — and that is a limit worth
  //   stating rather than a hazard worth risking.

  /// `;` separates fields and `|` list items, so a filter someone typed with either in it would corrupt the
  /// rest of the view. Escaped rather than stripped: a saved view must round-trip what was actually typed.
  string Esc(string v) { return v.Replace("~", "~0").Replace(";", "~1").Replace("|", "~2"); }
  string Unesc(string v) { return v.Replace("~2", "|").Replace("~1", ";").Replace("~0", "~"); }

  string EscList(List<string> xs) {
    var out = "";
    foreach (var x in xs) { out = out + (out == "" ? "" : "|") + Esc(x); }
    return out;
  }

  /// Every choice the READER made — and nothing the author did, which is why it survives a recompile that
  /// adds or renames a column: an unknown name is simply ignored on the way back in.
  string ViewState() {
    var widths = "";
    foreach (var c in columns) { widths = widths + (widths == "" ? "" : "|") + c.Width.ToString(); }
    return "o=" + EscList(order)
         + ";h=" + EscList(hidden)
         + ";g=" + Esc(groupBy)
         + ";s=" + Esc(sortBy.Name)
         + ";d=" + (descending ? "1" : "0")
         + ";q=" + Esc(search)
         + ";f=" + EscList(typed)
         + ";w=" + widths;
  }

  List<string> SplitList(string v) {
    var out = new List<string>();
    if (v == "") { return out; }
    foreach (var part in v.Split('|')) { out.Add(Unesc(part)); }
    return out;
  }

  /// ⚠ TOLERANT BY DESIGN. A view saved before a column was renamed names something that no longer exists,
  /// and the answer to that is to ignore it — not to refuse, and not to blank the grid. A stored string is
  /// older than the code reading it by construction.
  action ApplyView(string state) {
    foreach (var field in state.Split(';')) {
      if (field.StartsWith("o=")) {
        var wanted = SplitList(field.Substring(2));
        var next = new List<string>();
        foreach (var n in wanted) { if (order.Contains(n)) { next.Add(n); } }
        foreach (var n in order) { if (!next.Contains(n)) { next.Add(n); } }   // columns added since
        order = next;
      }
      if (field.StartsWith("h=")) {
        var next = new List<string>();
        foreach (var n in SplitList(field.Substring(2))) { if (order.Contains(n)) { next.Add(n); } }
        hidden = next;
      }
      if (field.StartsWith("g=")) { var g = Unesc(field.Substring(2)); groupBy = order.Contains(g) ? g : ""; }
      if (field.StartsWith("s=")) {
        var want = Unesc(field.Substring(2));
        foreach (var c in columns) { if (c.Name == want) { sortBy = c; } }
      }
      if (field.StartsWith("d=")) { descending = field.Substring(2) == "1"; }
      if (field.StartsWith("q=")) { search = Unesc(field.Substring(2)); }
      if (field.StartsWith("f=")) {
        var vals = SplitList(field.Substring(2));
        var next = new List<string>();
        for (int i = 0; i < columns.Length; i = i + 1) { next.Add(i < vals.Count ? vals[i] : ""); }
        typed = next;
      }
      if (field.StartsWith("w=")) {
        var ws = SplitList(field.Substring(2));
        for (int i = 0; i < columns.Length; i = i + 1) {
          if (i < ws.Count) { if (int.TryParse(ws[i], out var px)) { columns[i].Width = px; } }
        }
      }
    }
  }

  on mount { if (view != "") { ApplyView(view); } }

  /// Report the view after a change the READER made. From an ACTION, never from `on change` — see P-26.
  action Changed() { if (onViewChange != null) { onViewChange(ViewState()); } }

  slots from columns.Name

  render {
    // ⚑ THE TABLE FROM `Phone` UP, NOT `Tablet`. `Layout.AtLeast` measures the grid's CONTAINER, and a grid beside a
    //   docked drawer or an explorer lives in a 600-760px column on a wide screen — measured on the workbench
    //   archetype (looks round 2): a 1440px console with its inspector open turned its incident table into cards,
    //   which is a phone's answer given to a desk. A table that scrolls sideways is right for any column a table fits
    //   in; the card list is for a phone's width, and a phone in portrait is below `Phone`.
    if (Layout.AtLeast(Phone)) {
      // ⚑ THREE BOXES, AND EACH ONE IS DOING A JOB THE OTHER TWO CANNOT.
      //
      //  1. THE OUTER STACK holds the toolbar, the filter chips and the column chooser — the controls that operate ON
      //     the table. They are deliberately OUTSIDE the scroll region below: a search box that slid off to the left as
      //     you scrolled to the seventh column would be a control you have to scroll back to find, and the reader who
      //     needs it most is the one who has just scrolled. It is also why they are not inside `role=grid`, where a
      //     screen reader counted a text field among the table's rows.
      //  2. THE SCROLL CONTAINER (`overflowX: Auto`) is the only thing that makes a table wider than its column
      //     REACHABLE. `Hidden` would tidy the ragged edge and lose the columns; `Auto` gives them back.
      //     ⚠ `overflowX` alone would not be enough — a scroll container whose child is capped at its own width
      //       has nothing to scroll TO, which is why (3) exists.
      //  3. THE TABLE, at `TableW()`. One box holding the header row, the filter row and every data row, so they
      //     share ONE horizontal offset by construction. A design that scrolled the body under a fixed header
      //     would be worse than the clip: the columns would then LIE about which data they label.
      Stack(gap: 0) {
        if (filterable || onExport != null || selectable) {
          if (picked.Count > 0) {
            // THE SELECTION'S TOOLBAR, in the same place as the reading one — the verbs move to where the eye already is.
            SelectionBar(picked.Count, ClearPick) { Slot("selection", picked.ToArray()); }
          } else {
            Row(px: 3, py: 1, gap: 2, align: Align.Center, wrap: Wrapping.Wrap) {
              if (filterable) {
                Box(grow: 1, minW: "12rem", maxW: "22rem") { SearchField("Search all columns", search); }
                GridToolButton(ColumnFilterCount() > 0 ? "Filter · " + ColumnFilterCount().ToString() : "Filter",
                               ToggleFilters, Icons.Filter, on: filtersOpen);
              }
              Spacer();
              GridToolButton("Columns", ToggleColumnMenu, Icons.Columns, on: showColumnMenu);
              if (onExport != null) { GridToolButton("Export", Export, Icons.Download, discloses: false); }
            }
          }
        }
        // THE FILTERS THAT ARE SET, while their row is shut — each says what it does in words and takes a ×.
        if (filterable && !filtersOpen && AnyColumnFilter()) {
          Row(gap: 2, px: 3, pb: 2, align: Align.Center, wrap: Wrapping.Wrap, label: "Active filters") {
            foreach (var c in columns) {
              if (WantOf(typed[columns.IndexOf(c)]) != "") {
                FilterChip(ChipText(c, typed[columns.IndexOf(c)]), "Remove filter " + c.Label, () => ClearColumnFilter(c.Name));
              }
            }
            Pressable(onClick: ClearFilters, label: "Clear all filters") {
              Text("Clear all", fontSize: FontSize.Caption, color: Colors.Primary.Text);
            }
          }
        }
        // Which columns are on screen. A Pressable per column rather than a Checkbox, because a checkbox binds
        // a `Binding<bool>` and "is this name absent from a list" is not an assignable lvalue.
        if (showColumnMenu) {
          Row(gap: 3, px: 3, py: 2, bg: Colors.Surface, borderW: 1, border: Colors.Border, wrap: Wrapping.Wrap,
              label: "Column chooser") {
            foreach (var slot in columns) {
              foreach (var h in columns) {
                if (order.IndexOf(h.Name) == columns.IndexOf(slot)) {
                  Pressable(onClick: () => ToggleColumn(h.Name), label: (Shown(h.Name) ? "Hide " : "Show ") + h.Label) {
                    Text((Shown(h.Name) ? "☑ " : "☐ ") + h.Label, fontSize: FontSize.Caption,
                         color: Shown(h.Name) ? Colors.OnSurface : Colors.TextMuted);
                  }
                }
              }
            }
          }
        }
        Stack(gap: 0, overflowX: Overflow.Auto) {
          Stack(gap: 0, role: UiRole.Grid, label: label, minW: TableW()) {
            Row(gap: 0, px: 3, py: 2, bg: Colors.Surface, borderBW: 1, border: Colors.Border, role: UiRole.GridRow) {
              if (selectable) {
                PickCell("Select all rows", AllVisiblePicked(), TogglePickAll);
              }
              // ⚑ THE READER'S ORDER, not the prop's — and iterated over COLUMNS, never over `order`.
              //
              //   `order` is a `List<string>`, and a `foreach` over STRINGS stamps each one as a rendered ITEM (a bare
              //   string is its own identity), so `Assert.Items` starts counting column names as rows. Measured: a
              //   4-row grid reported 7. A class instance carries no identity and stamps nothing — so the loop runs
              //   over `columns` once per POSITION, and renders whichever column the reader put at that position.
              foreach (var slot in columns) {
                foreach (var h in columns) {
                  if (order.IndexOf(h.Name) == columns.IndexOf(slot) && Shown(h.Name)) {
                    if (h.Fill) { FillCell(justify: h.Align) { HeaderCell(col: h, sorted: sortBy.Name == h.Name && h.Sortable, desc: descending, onSort: SortByColumn, onMove: MoveColumn, onGroup: GroupByColumn, grouping: groupBy == h.Name, onFilter: filterable && h.Filterable ? FilterColumn : null, filtered: WantOf(typed[columns.IndexOf(h)]) != ""); } }
                    else { FixedCell(px: h.Width, justify: h.Align) { HeaderCell(col: h, sorted: sortBy.Name == h.Name && h.Sortable, desc: descending, onSort: SortByColumn, onMove: MoveColumn, onGroup: GroupByColumn, grouping: groupBy == h.Name, onFilter: filterable && h.Filterable ? FilterColumn : null, filtered: WantOf(typed[columns.IndexOf(h)]) != ""); } }
                  }
                }
              }
            }
            // P-24 — ONE BOUND BOX PER COLUMN, drawn only while somebody is filtering (see `filtersOpen`). Wide arm
            // only: a row of boxes does not fit a phone, and the quick search above is what the narrow arm offers.
            if (filterable && filtersOpen) {
              Row(gap: 0, px: 3, py: 1, bg: Colors.Sunken, borderW: 1, border: Colors.Border, label: "Filter row") {
                if (selectable) { Box(w: 36, shrink: 0); }
                // The `Input` is INLINE rather than in a `FilterCell` child, because the binding targets THIS
                // component's own list — handing it down would need the indexed form to cross a component boundary
                // as a `Binding<string>`, which is a separate arm and a separate slice.
                foreach (var slot in columns) {
                  foreach (var h in columns) {
                    if (order.IndexOf(h.Name) == columns.IndexOf(slot) && Shown(h.Name)) {
                      if (h.Fill) {
                        FillCell(justify: null) {
                          if (h.Filterable) {
                            Input(value: typed[columns.IndexOf(h)], label: "Filter " + h.Label, name: "filter-" + h.Name, w: "100%",
                                  autoFocus: focusFilter == h.Name,
                                  placeholder: h.Kind == GridColumnKind.Text ? "contains…" : "e.g. > 100");
                          }
                        }
                      } else {
                        FixedCell(px: h.Width, justify: null) {
                          if (h.Filterable) {
                            Input(value: typed[columns.IndexOf(h)], label: "Filter " + h.Label, name: "filter-" + h.Name, w: "100%",
                                  autoFocus: focusFilter == h.Name,
                                  placeholder: h.Kind == GridColumnKind.Text ? "contains…" : "e.g. > 100");
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
            // ⚑ TWO SHAPES, AND THE SPLIT IS LOAD-BEARING.
            //
            //  · UNGROUPED keeps the flat row loop it always had, so the ROW is the outermost repeated
            //    region and `Assert.Items` still counts rows. Every existing grid's tests are unaffected.
            //  · GROUPED puts the BAND loop outside, which is the only way a band's rows are CONTIGUOUS
            //    and the header is its OWN item. Emitting the header inside the row loop instead fuses it with the
            //    first row of the band, so the first row of every band was not addressable at all.
            //
            // What makes `Slot(c.Name, row)` find the app's `slot Status { r => … }` is that named slot TEMPLATES flow
            // into a child component that supplies none of its own (2026-09-04) — `[Part]` is a packaging marker only.
            //
            // ⚠ A PICKABLE ROW IS NOT WRAPPED IN A PRESS: its check is a control of its own, and a button inside a
            //   button is invalid markup that a screen reader flattens. The row hands its OPEN press to its cells instead.
            if (Grouped()) {
              foreach (var band in Bands()) {
                GroupBand(label: band.Key, count: band.Rows.Count, sums: SumsIn(band),
                          collapsed: IsCollapsed(band.Key), onToggle: () => ToggleBand(band.Key));
                if (!IsCollapsed(band.Key)) {
                  foreach (var r in band.Rows) {
                    if (selectable) {
                      GridRowCells(cols: columns, order: order, hidden: hidden, row: r, pickable: true, isPicked: IsPicked(r), pickName: PickName(r),
                                   onPick: () => TogglePick(r), opens: rowSelected != null, onOpen: () => rowSelected(r));
                    } else if (rowSelected != null) {
                      Pressable(onClick: () => rowSelected(r)) { GridRowCells(cols: columns, order: order, hidden: hidden, row: r); }
                    } else { GridRowCells(cols: columns, order: order, hidden: hidden, row: r); }
                  }
                }
              }
            } else {
              foreach (var r in visible) {
                if (selectable) {
                  GridRowCells(cols: columns, order: order, hidden: hidden, row: r, pickable: true, isPicked: IsPicked(r), pickName: PickName(r),
                               onPick: () => TogglePick(r), opens: rowSelected != null, onOpen: () => rowSelected(r));
                } else if (rowSelected != null) {
                  Pressable(onClick: () => rowSelected(r)) { GridRowCells(cols: columns, order: order, hidden: hidden, row: r); }
                } else { GridRowCells(cols: columns, order: order, hidden: hidden, row: r); }
              }
            }
            // EVERY ROW FILTERED OUT is not the same as an empty table, and saying so is the difference between
            // "there is nothing" and "you cannot see it from here". The clear is beside the sentence, because
            // that is where somebody who has just lost their rows is looking.
            if (visible.Count == 0 && AnyFilter()) {
              Row(gap: 2, px: 3, py: 3, align: Align.Center) {
                Text("No rows match the filter.", color: Colors.TextMuted);
                // ⚠ ONLY when there is something HERE to clear. A `filters:` entry belongs to the page, and
                //   this button cannot touch it — offering it anyway is a control that takes the click and
                //   leaves the screen exactly as it was.
                if (search.Trim() != "" || AnyColumnFilter()) {
                  Pressable(onClick: ClearFilters) { Text("Clear", color: Colors.Primary.Text); }
                }
              }
            }
          }
        }
      }
    }
    else {
      Stack(gap: 2, role: UiRole.List, label: label) {
        // ⚠ THE SAME FILTER, on the arm a phone actually renders. A filter that applied only to the table
        //   would be a grid that shows different rows at two window widths, which is the one thing a
        //   responsive control must never do.
        if (picked.Count > 0) {
          SelectionBar(picked.Count, ClearPick) { Slot("selection", picked.ToArray()); }
        } else {
          if (filterable) { SearchField("Search all columns", search); }
          if (onExport != null) { Button(label: "Export", onPress: Export, tone: Tone.Ghost); }
        }
        // A column filter set on a wider screen still applies here, so it is still SAID here — with its ×.
        if (filterable && AnyColumnFilter()) {
          Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap, label: "Active filters") {
            foreach (var c in columns) {
              if (WantOf(typed[columns.IndexOf(c)]) != "") {
                FilterChip(ChipText(c, typed[columns.IndexOf(c)]), "Remove filter " + c.Label, () => ClearColumnFilter(c.Name));
              }
            }
          }
        }
        if (Grouped()) {
          foreach (var band in Bands()) {
            GroupBand(label: band.Key, count: band.Rows.Count, sums: SumsIn(band),
                      collapsed: IsCollapsed(band.Key), onToggle: () => ToggleBand(band.Key));
            if (!IsCollapsed(band.Key)) {
              foreach (var r in band.Rows) {
                if (rowSelected != null) {
                  Pressable(onClick: () => rowSelected(r)) { GridCard(cols: columns, order: order, hidden: hidden, row: r); }
                } else { GridCard(cols: columns, order: order, hidden: hidden, row: r); }
              }
            }
          }
        } else {
          foreach (var r in visible) {
            if (rowSelected != null) {
              Pressable(onClick: () => rowSelected(r)) { GridCard(cols: columns, order: order, hidden: hidden, row: r); }
            } else { GridCard(cols: columns, order: order, hidden: hidden, row: r); }
          }
        }
        if (visible.Count == 0 && AnyFilter()) {
          Row(gap: 2, py: 3, align: Align.Center) {
            Text("No rows match the filter.", color: Colors.TextMuted);
            if (search.Trim() != "" || AnyColumnFilter()) { Pressable(onClick: ClearFilters) { Text("Clear", color: Colors.Primary.Text); } }
          }
        }
      }
    }
  }
}

/// ONE cell — header or body — carrying this column's SIZING, so the header and the rows cannot disagree about it.
[Composable][Part] component HeaderCell<T>(GridColumn<T> col, bool sorted, bool desc, Action<GridColumn<T>> onSort,
                                     Action<string, int> onMove, Action<string> onGroup, bool grouping,
                                     Action<string>? onFilter = null, bool filtered = false) {
  render {
    Row(role: UiRole.ColumnHeader, sort: col.Sortable ? (sorted ? (desc ? UiSort.Descending : UiSort.Ascending) : UiSort.None) : UiSort.None,
        gap: 1, align: Align.Center, w: "100%", position: Position.Relative) {
      // A right-aligned column's NAME sits over its figures, at the right — the header says where to look.
      if (col.Align == "right") { Spacer(); }
      if (col.Sortable) {
        // ⚑ THE SORT MARK IS PART OF THE PRESS, and it is drawn only where it says something: on the column the rows
        //   ARE sorted by, always; on any other, only while the pointer or the keyboard is on that header — so a
        //   table at rest reads as its columns' names, and the one arrow it shows is the one that is true.
        HeaderSort(col.Label, sorted, desc, () => onSort(col), filtered: filtered);
      } else {
        Text(col.Label, fontWeight: FontWeight.Medium, fontSize: FontSize.Caption, color: Colors.TextMuted);
        if (filtered) { Icon(Icons.Filter, size: 11, color: Colors.Primary.Text); }
      }
      if (col.Align != "right") { Spacer(); }
      // ⚑ MOVE AND GROUP ARE BUTTONS, NOT A DRAG — and that is the accessibility answer as well as the simple
      //   one. A drag-to-reorder is unreachable from a keyboard and invisible to a screen reader, so a control
      //   whose ONLY reordering affordance was a drag would fail krav 6.3 outright. Each carries its column's
      //   name in its label, which is also what makes it addressable in a test.
      // ⛔ EACH GETS A BOX, because a glyph does not have one. `‹` at caption size measures FIVE PIXELS WIDE, so
      //    these three shipped as 5×24 targets in every DataGrid in every app — a control a reader can see and can
      //    barely hit, and one a pointer user with any tremor cannot. Measured in real Chromium 2026-09-18 by
      //    `admin-costs.mjs`'s clickable-target floor, which is the only tier that could have seen it: happy-dom
      //    has no layout, so every existing DataGrid test passes on a 5-pixel button.
      //    ⚑ The INTERIOR grows, not the row: 22×22 is inside the 24px header line, so no grid changes height.
      // ⭐ AND THEY TAKE NO ROOM WHILE QUIET (looks round 2): the tools float over the header's far edge — the start of a
      //    right-aligned column, the end of any other — so a column's name gets its whole width at rest instead of
      //    wrapping beside four invisible boxes ("Annual value" broke over two lines in a 140px column). They keep
      //    their boxes, names and focus, so a keyboard, a screen reader and a test reach them exactly as before.
      HeaderTools(atStart: col.Align == "right") {
        // The funnel opens the filter row with THIS column's box focused. A FILTERED column is marked beside its NAME
        // (see `HeaderSort`), not here: a lit tool floating at a right-aligned column's start sat beside the column
        // before it, and read as belonging to that one.
        if (onFilter != null) { HeaderTool("Filter by " + col.Label, "⏷", () => onFilter(col.Name)); }
        HeaderTool("Move " + col.Label + " left", "‹", () => onMove(col.Name, -1));
        HeaderTool("Move " + col.Label + " right", "›", () => onMove(col.Name, 1));
        HeaderTool((grouping ? "Ungroup " : "Group by ") + col.Label, grouping ? "⊟" : "⊞", () => onGroup(col.Name), lit: grouping);
      }
      Box(drag: col.Width, dragAxis: DragAxis.Horizontal, dragStep: 8, dragMin: 72, dragMax: 640, w: "6px", cursor: "col-resize");
    }
  }
}

/// A header's tools, floating over its far edge so they take no width from the column's name.
[Composable][Part] component HeaderTools(bool atStart = false) {
  variants {
    base { Position = Position.Absolute; Top = "50%"; TranslateY = "-50%"; Right = "6px"; Display = Display.Flex; }
    atStart { Right = "auto"; Left = "0"; }
  }
  render { Row(gap: 0, align: Align.Center) { Slot; } }
}

/// A sortable column's name and its sort mark, as ONE press — so the mark is reached, named and focused with the name.
[Composable][Part] component HeaderSort(string label, bool sorted, bool desc, Action onPress, bool filtered = false) {
  render {
    Pressable(onClick: onPress, label: label) {
      Row(gap: 1, align: Align.Center) {
        Text(label, fontWeight: sorted ? FontWeight.Semibold : FontWeight.Medium, fontSize: FontSize.Caption,
             color: sorted ? Colors.OnSurface : Colors.TextSecondary);
        // The column is narrowed by a filter — said beside its name, in the accent, for as long as it is.
        if (filtered) { Icon(Icons.Filter, size: 11, color: Colors.Primary.Text); }
        SortMark(glyph: sorted ? (desc ? "↓" : "↑") : "↕", lit: sorted);
      }
    }
  }
}

/// The arrow beside a column's name — QUIET UNTIL WANTED, exactly like `HeaderTool`: shown on the sorted column, and
/// on any other only while that header is under the pointer or holds the keyboard. Its box is always there, so a
/// header never shifts as the mark comes and goes.
[Composable][Part] component SortMark(string glyph, bool lit = false) {
  variants {
    base { Opacity = "0"; Transition = Motion.Fast; Color = Colors.TextMuted;
           inside HeaderCell.Hover { Opacity = "1"; }
           inside HeaderSort.Focus { Opacity = "1"; } }
    lit { Opacity = "1"; Color = Colors.OnSurface; }
  }
  render { Text(glyph, fontSize: FontSize.Caption, decorative: true); }
}

/// One of a column header's tools — move it left or right, group by it. QUIET UNTIL WANTED: drawn only while the
/// header is under the pointer or the tool itself has the keyboard (and always while it is ON — a grouping is a state
/// the reader must see), so a table reads as its columns' names rather than as a row of glyphs between them. It keeps
/// its 22×22 box and its name the whole time, so it is exactly as reachable by a keyboard, a screen reader or a test.
[Composable][Part] component HeaderTool(string label, string glyph, Action onPress, bool lit = false) {
  variants {
    base { Opacity = "0"; Transition = Motion.Fast; Bg = Colors.Surface; Rounded = Radius.Sm;
           inside HeaderCell.Hover { Opacity = "1"; }
           Focus { Opacity = "1"; } }
    lit { Opacity = "1"; }
  }
  render {
    Pressable(onClick: onPress, label: label, w: 22, h: 22, align: Align.Center, justify: Justify.Center) {
      Text(glyph, fontSize: FontSize.Caption, color: lit ? Colors.Primary : Colors.TextMuted, decorative: true);
    }
  }
}

/// ONE DATA CELL, DECLARED — the body's answer to `HeaderCell`, and structurally its twin: the sizing wrapper
/// outside, the semantic element inside.
/// ⭐ `figure` — a NUMBER column's cell is set in the theme's figure face (`Font.Figure`) with tabular digits, so a
///    column of amounts lines up digit under digit and a look can give its figures a face of their own.
/// ⚠ `justify` IS THE COLUMN'S ALIGNMENT, and it has to reach THIS row: the cell fills its column (`w: "100%"`), so
///   the column wrapper's own `justify` has nothing to move — a `right` column's figures sat at the left edge, under a
///   header that promised otherwise, until the alignment was handed down to the row that holds them.
[Composable][Part] component BodyCell(bool figure = false, string? justify = null) {
  variants { figure { FontFamily = Font.Figure; FontFeatureSettings = "\"tnum\" 1"; } }
  render {
    Row(role: UiRole.GridCell, align: Align.Center, w: "100%",
        justify: justify == "right" ? Justify.End : (justify == "center" ? Justify.Center : Justify.Start)) { Slot; }
  }
}

/// One cell at this column's width — it neither shrinks under a long neighbour nor grows past its container.
[Composable][Part] component FixedCell(int px, string? justify) {
  // `Px`: a gutter on both sides of every cell, so a right-aligned figure never runs into the next column's first word.
  variants { base { Display = Display.Flex; Shrink = 0; Overflow = Overflow.Hidden; Px = 2; } }
  render { Row(w: px, align: Align.Center, justify: justify) { Slot; } }
}

/// The column that ABSORBS the leftover width — a long value ellipses inside it.
[Composable][Part] component FillCell(string? justify) {
  variants { base { Display = Display.Flex; Grow = 1; Basis = "0"; MinW = "0"; Overflow = Overflow.Hidden; Px = 2; } }
  render { Row(align: Align.Center, justify: justify) { Slot; } }
}

/// One card — the narrow arm's row.
[Composable][Part] component GridCard<T>(GridColumn<T>[] cols, List<string> order, List<string> hidden, T row) {
  render {
    Stack(gap: 1, p: 3, borderW: 1, border: Colors.Border, rounded: Radius.Md, bg: Colors.Surface) {
      foreach (var slot in cols) {
       foreach (var c in cols) {
        if (order.IndexOf(c.Name) == cols.IndexOf(slot) && !hidden.Contains(c.Name)) {
      if (c.Title) { CardTitleLine { Slot(c.Name, row) { Text(c.Value(row)); } } }
      else if (c.Secondary) { CardSubLine { Slot(c.Name, row) { Text(c.Value(row)); } } }
      else {
        Row(gap: 2, align: Align.Center) {
          Text(c.Label, fontSize: FontSize.Caption, color: Colors.TextMuted);
          Slot(c.Name, row) { Text(c.Value(row)); }
        }
      }
        }
       }
      }
    }
  }
}

/// The card's heading line — the weight lives here so the SLOT's own content is styled the same as the fallback.
[Composable][Part] component CardTitleLine() {
  variants { base { Display = Display.Flex; FontWeight = FontWeight.Medium; } }
  render { Row { Slot; } }
}

/// The card's muted subtitle line.
[Composable][Part] component CardSubLine() {
  variants { base { Display = Display.Flex; FontSize = FontSize.Caption; Color = Colors.TextMuted; } }
  render { Row { Slot; } }
}




/// ONE GROUP BAND — its value, how many rows it holds, its totals, and a press to fold it away.
/// Non-generic on purpose: a band knows nothing about the row type, so nothing here has to be.
[Composable][Part] component GroupBand(string label, int count, string sums, bool collapsed, Action onToggle) {
  render {
    Pressable(onClick: onToggle, label: (collapsed ? "Expand " : "Collapse ") + label) {
      Row(gap: 2, px: 3, py: 2, align: Align.Center, bg: Colors.Surface,
          borderW: 1, border: Colors.Border, expanded: !collapsed) {
        Text(collapsed ? "▶" : "▼", fontSize: FontSize.Caption, color: Colors.TextMuted, decorative: true);
        // An empty grouping value is a real group — say so, rather than rendering a blank band nobody
        // can tell from a rendering fault.
        Strong(label == "" ? "(none)" : label);
        Text("(" + count.ToString() + ")", fontSize: FontSize.Caption, color: Colors.TextMuted);
        Spacer();
        if (sums != "") { Text(sums, fontSize: FontSize.Caption, color: Colors.TextSecondary); }
      }
    }
  }
}


/// ONE TABLE ROW's cells — the wide arm's answer to `GridCard`, and extracted for the same reason:
/// the grid renders rows from two places (flat, and inside a band) and a second copy of this markup
/// would drift. A `Slot` resolves from in here exactly as it does from `GridCard`.
/// A PICKABLE row leads with its check, and — because a check cannot sit inside a press — carries the row's OPEN as a
/// press over its cells rather than being wrapped in one.
[Composable][Part] component GridRowCells<T>(GridColumn<T>[] cols, List<string> order, List<string> hidden, T row,
                                         bool pickable = false, bool isPicked = false, Action? onPick = null, string pickName = "row",
                                         bool opens = false, Action? onOpen = null) {
  render {
    Row(gap: 0, px: 3, py: 2, borderBW: 1, border: Colors.Border, role: UiRole.GridRow,
        bg: isPicked ? Colors.Primary.Subtle : Colors.Transparent) {
      if (pickable) { PickCell("Select " + pickName, isPicked, onPick); }
      if (opens) {
        Pressable(onClick: onOpen, grow: 1, minW: "0") { GridCells(cols: cols, order: order, hidden: hidden, row: row); }
      } else {
        GridCells(cols: cols, order: order, hidden: hidden, row: row);
      }
    }
  }
}

/// The cells of one row, in the reader's order — shared by a plain row and a pickable one.
[Composable][Part] component GridCells<T>(GridColumn<T>[] cols, List<string> order, List<string> hidden, T row) {
  render {
    Row(gap: 0, grow: 1, minW: "0") {
      // See DataGrid's header loop: iterate the COLUMNS, never `order` — a foreach over strings stamps items.
      foreach (var slot in cols) {
        foreach (var c in cols) {
          if (order.IndexOf(c.Name) == cols.IndexOf(slot) && !hidden.Contains(c.Name)) {
            if (c.Fill) { FillCell(justify: c.Align) { BodyCell(figure: c.Kind == GridColumnKind.Number, justify: c.Align) { Slot(c.Name, row) { Text(c.Value(row)); } } } }
            else { FixedCell(px: c.Width, justify: c.Align) { BodyCell(figure: c.Kind == GridColumnKind.Number, justify: c.Align) { Slot(c.Name, row) { Text(c.Value(row)); } } } }
          }
        }
      }
    }
  }
}

/// The pick check at the head of a row (and of the header, for every row in view) — a real checkbox to a screen
/// reader, a 36px column to the eye.
[Composable][Part] component PickCell(string label, bool picked, Action onToggle) {
  variants { base { Display = Display.Flex; Shrink = 0; W = "36px"; } }
  render {
    Row(align: Align.Center) {
      Pressable(onClick: onToggle, label: label, role: UiRole.Checkbox, checked: picked, w: 22, h: 22,
                align: Align.Center, justify: Justify.Center) {
        PickBox(on: picked) { if (picked) { Icon(Icons.Check, size: 12, color: Colors.OnPrimary); } }
      }
    }
  }
}

/// The square a pick check draws — filled with the accent while it is on.
[Composable][Part] component PickBox(bool on = false) {
  variants {
    base { Display = Display.Flex; W = "16px"; H = "16px"; Rounded = Radius.Sm; BorderW = 1; Border = Colors.Border;
           Bg = Colors.Surface; Transition = Motion.Fast; }
    on { Bg = Colors.Primary; Border = Colors.Primary; }
  }
  render { Box { Slot; } }
}

/// A toolbar button of the grid's own — quiet (no fill until pressed or hovered), an optional glyph, and `on` while
/// what it opens is open, so the toggle says its state as well as `pressed:` does.
[Composable][Part] component GridToolButton(string label, Action onPress, Icons? icon = null, bool on = false, bool discloses = true) {
  variants {
    base { Display = Display.InlineFlex; H = Length.ControlSm; Px = 2;
           Rounded = Radius.Md; Color = Colors.TextSecondary; FontSize = FontSize.Label; FontWeight = FontWeight.Medium;
           Transition = Motion.Fast; Hover { Bg = Colors.Muted; Color = Colors.OnSurface; } }
    on { Bg = Colors.Muted; Color = Colors.OnSurface; }
  }
  render {
    // A tool that OPENS something (the filter row, the column chooser) says whether it is open — `expanded:` is the
    // disclosure state a screen reader announces, and what `Assert.Expanded("Filter", false)` reads.
    if (discloses) {
      Pressable(onClick: onPress, expanded: on, label: label) {
        Row(gap: 1, align: Align.Center) {
          if (icon != null) { Icon(icon.Value, size: 14); }
          Text(label);
        }
      }
    } else {
      Pressable(onClick: onPress, label: label) {
        Row(gap: 1, align: Align.Center) {
          if (icon != null) { Icon(icon.Value, size: 14); }
          Text(label);
        }
      }
    }
  }
}
