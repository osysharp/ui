// Ui (part 2/3) — the starter theme (`using Osysharp.Ui;`).

// The `Osysharp.Ui` kit namespace — its public types enter scope only via `using Osysharp.Ui;`.
namespace Osysharp.Ui;

// ⭐ THE FLOOR IS "SWITCHBOARD" — a considered default rather than the template look (system font, indigo, grey
//    surfaces), because it is the floor under every app that does not re-theme. An app overrides the same token names.
//
// ⚑ EVERY TEXT PAIR HERE IS CONTRAST-CHECKED to WCAG AA — change a colour, check the pairs it is used in. `Primary` in particular is used as TEXT (links, the current nav row) as well
//   as a fill, so its light value is the deep line-cyan that reads as both (5.2 : 1 either way against white), and the
//   dark value is the bright one, with DARK text on it — white on a bright cyan fails.
theme Ui {
  Colors {
    Bg           = Modes.Of(light: "#F2F4F3", dark: "#0C1112");   // the page: a neutral with a faint green-cyan cast
    OnBg         = Modes.Of(light: "#0D1716", dark: "#E3ECEB");
    Border       = Modes.Of(light: "#DCE2E0", dark: "#233032");
    Muted        = Modes.Of(light: "#E6EBE9", dark: "#1B2526");   // a BACKGROUND tint — hovered rows, chips, fills
    TextMuted    = Modes.Of(light: "#5B6966", dark: "#8E9E9B");
    TextSecondary = Modes.Of(light: "#34413E", dark: "#B9C6C4");
    BorderDanger = Modes.Of(light: "#E5484D", dark: "#F2555A");
    Surface      = Modes.Of(light: "#FFFFFF", dark: "#121A1B");
    OnSurface    = Modes.Of(light: "#0D1716", dark: "#E3ECEB");
    // One step ABOVE Surface — menus, popovers, dialogs. In dark mode depth is lightness (a shadow on near-black is
    // invisible); in light mode it is the shadow, so the colour stays white.
    Elevated     = Modes.Of(light: "#FFFFFF", dark: "#172122");
    // One step BELOW Bg — a rail, a composer well, the ground a list sits in.
    Sunken       = Modes.Of(light: "#E9EDEB", dark: "#0F1516");
    // THE ONE ACCENT: live, and yours — the primary action, the current place, a lit lamp, focus.
    Primary      = Modes.Of(light: Palette.From("#087885"), dark: Palette.From("#33CAD8"));
    OnPrimary    = Modes.Of(light: "#FFFFFF", dark: "#042326");
    Danger       = Modes.Of(light: Palette.From("#C8372F"), dark: Palette.From("#F2555A"));
    Success      = Modes.Of(light: Palette.From("#1B7443"), dark: Palette.From("#3DB36D"));
    Warning      = Modes.Of(light: Palette.From("#9A5B00"), dark: Palette.From("#F5B738"));
    // Paused on somebody else — waiting on a customer, an approval, a reply. Neither good nor bad, so not green or red.
    Waiting      = Modes.Of(light: "#5E6196", dark: "#9A9DC4");
    Scrim        = Modes.Of(light: "rgba(16,24,40,.45)", dark: "rgba(0,0,0,.62)");
    Transparent  = "transparent";
    // Type set ON a photograph — an editorial header floating over a hero, a split panel's wordmark. Not moded: it is
    // read against the picture, which does not change with the reader's theme.
    OnImage      = "#FFFFFF";
    // The keyboard's place — every focus ring in the kit. The accent by default; a look whose accent is too light to
    // ring a control on white (a lime, a yellow) gives it its own.
    Focus        = Colors.Primary;

    // ⭐ THE CHROME — the app's rail and bars. A shell paints its rail with `Ground = Ground.Chrome`, which points the
    //    ordinary tokens at these for everything inside it (`Surface` there IS `Chrome`), so a look can set a dark
    //    rail beside a light page, or a tinted one, without a shell being forked. Every one defaults to the ordinary
    //    token it stands in for, so on the floor the rail is exactly what it was.
    Chrome          = Colors.Surface;     // the rail's ground
    OnChrome        = Colors.OnSurface;   // its words
    ChromeMuted     = Colors.TextSecondary;   // a nav row at rest
    ChromeFaint     = Colors.TextMuted;   // a section heading, a hint, a quiet glyph
    ChromeHover     = Colors.Muted;       // a row under the pointer
    ChromeSunken    = Colors.Bg;          // a card or a well set into the rail
    ChromeElevated  = Colors.Elevated;    // a menu or flyout the rail opens
    ChromeLine      = Colors.Border;      // its rules, and the edge between it and the page
    ChromeCurrent   = Primary.Subtle;     // the row you are on…
    OnChromeCurrent = Primary.Strong;     // …and its words
    ChromeFocus     = Colors.Focus;       // a focus ring inside it
    // A card's edge — the hairline round a `Card`. A look that sets its cards on a tinted ground rather than ruling them
    // gives it the surface colour, and the line disappears without the border's width moving anything.
    CardLine        = Colors.Border;
  }

  // ONE radius rule (floor.md §3): chips and key hints 6, controls and row highlights 8, panels, menus and dialogs 12,
  // counts and status pills round.
  Radius { Sm = "6px"; Md = "8px"; Lg = "12px"; Pill = "999px"; Circle = "50%";
           Tag = Radius.Pill; }   // a badge's corners — a look that wants square tags says so here

  // `Step` IS THE DENSITY: every spacing number in every control and page is a count of it (`P = 4` is four steps).
  // A look moves it a few hundredths of a rem and the whole app tightens or opens up together.
  Space { Step = "0.25rem"; Gutter = "1rem"; PagePad = "1.5rem"; SectionGap = "2.5rem"; FieldGap = "0.375rem"; }

  FontSize   { Caption = "12px"; Label = "13px"; Body = "14px"; Subhead = "16px"; Heading = "20px"; Title = "28px"; Code = "13px";
               StoreBrand = "24px";     // a storefront's centred wordmark (StorefrontShell)
               EditorialBrand = "26px"; // an editorial site's wordmark in the header (EditorialShell, SplitShell)
               SignOff = "clamp(4rem, 15vw, 13rem)";    // the brand set ENORMOUS across a footer (EditorialFooter)
               MarqueeBrand = "clamp(4rem, 11vw, 10rem)";  // the wordmark at poster size (MarqueeShell)
               MarqueeNav = "clamp(1.4rem, 2.4vw, 2.2rem)"; }  // its shelves in the display face (MarqueeShell)
  // A VARIABLE face sits between the usual stops, and the tools people live in use that (Linear sets text at 510,
  // Superhuman at 540): text a touch fuller than 400 reads better at 13-14px on a screen, and headings a little short
  // of a full 600 keep a dense page calm.
  FontWeight { Regular = 420; Medium = 530; Semibold = 630; Bold = 720;
               Headings = FontWeight.Semibold; }   // a page's title, a card's, a statistic — the weight a look's headings are set in
  Font {
    // ⭐ SHIPPED WITH THE PLATFORM (UiBuiltInFonts): every app can name these and they render, with no `osy font add`.
    //    A declared face costs nothing until text is set in it, so an app that names its own never downloads these.
    Sans = "\"Mona Sans\", ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, system-ui, sans-serif";
    // Ids, counts, times and key hints — with tabular figures wherever they line up in a column.
    // ⚠ The three proportional faces before `monospace` are for ARABIC only: no monospace face here carries
    //   it, and the generic `monospace` fallback sets "2 أكتوبر" as disconnected letters. Latin,
    //   digits and every glyph the faces before them have are never reached.
    Mono = "\"Martian Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Geeza Pro\", \"Noto Sans Arabic\", \"Segoe UI\", monospace";
    // The DISPLAY face — headings, a wordmark, a hero. The kit's own sans until an app gives it a face of its own,
    // which is the first thing a designed app overrides (`osy docs ui-design#type`).
    Display = Font.Sans;
    // The FIGURES face — a statistic, and the cells of a number column (set with tabular digits). The text face
    // until a look gives numbers their own: a mono for a ledger, a condensed face for a dashboard.
    Figure = Font.Sans;
  }

  // ⚑ `Length`, NOT `Size`. `Size` is the control-size ENUM (`Sm`/`Md`/`Lg`), and one spelling
  // for two different things was bearable only while every reference was bare — the qualification arc makes
  // `Size.Lg` and `Size.Column` both legal and both mean something else. The enum keeps the name; this group was
  // the badly named half, since its members are lengths, not points on a scale.
  Length {
    ControlSm = "32px"; ControlMd = "38px"; ControlLg = "46px";
    IconSm    = "16px"; IconMd    = "20px"; IconLg    = "24px";
    AvatarSm  = "24px"; AvatarMd  = "36px"; AvatarLg  = "56px";
    TextLine  = "0.75rem";   // the height of a stand-in for one line of text (a skeleton bar)
    Measure   = "68ch";      // a comfortable reading measure for prose
    RailW     = "264px";
    RailNarrowW = "60px";    // the same rail collapsed to an icon strip
    // ⭐ THE SQUARE A GLYPH SITS IN WHEN A SHELL HAS NO ROOM FOR WORDS — the brand tile at the head of the rail, and
    //    the highlight on a nav row that has lost its label. ONE token because they sit four rows apart in the SAME
    //    60px column: a tile and a highlight that merely happened to agree would drift the first time one moved, and
    //    the rail would read as a tile above a slab. 28px around an 18px glyph is the breathing room the mark tile
    //    already gave its own 16px icon.
    ShellMark = "28px";
    // …and the same rail as a PHONE DRAWER. `min()` so it never covers the whole screen: a sliver of the page
    // stays visible behind the scrim, which is what tells a reader the drawer is a layer they can dismiss rather
    // than a new screen they have navigated to.
    RailDrawerW = "min(84vw, 320px)";
    AsideW    = "340px";     // a shell's right rail — an activity feed, a timeline, a summary beside the page
    AppBarH   = "52px";
    StoreHeaderH = "68px";   // a storefront's header — taller than an app bar, because it carries a wordmark
    EditorialHeaderH = "80px";   // an editorial header — room to breathe over a hero
    DialogW   = "480px";
    MenuW     = "200px";
    NumberW   = "88px";      // the box a stepper's digits sit in — wide enough for four and a sign
    // ⭐ THE SPINNER, DRAWN RATHER THAN INHERITED (I-77). A numeric field is a text input now — so that its digits
    //    mean what the APP's culture says and not what the browser's locale does — and a text input has no arrows.
    //    Half of `ControlMd` each, so the stacked pair is exactly as tall as the box it sits beside, which is what
    //    the native pair was. A single token would be off by a rounding: 38px does not halve into two whole pixels.
    StepperHalf  = "19px";   // one arrow — half a ControlMd box
    StepperGlyph = "10px";   // the chevron inside it
    DayCell   = "34px";      // one day in a calendar month grid
    CalendarW = "252px";
    TimeColW  = "56px";      // one column of a time picker — two digits with room to tap
    TimeColH  = "168px";     // …and how tall before it scrolls     // seven day cells plus the panel's padding
    // ⭐ THE ONE LENGTH A PAGE, RATHER THAN A CONTROL, NEEDS — and the only one an app could not name until
    //    2026-09-04. Measured over this repo: 83 raw `"100vh"`/`"100dvh"` string literals across 26 apps, 89% of
    //    them on `minH:`, and `demo/auth-demo` had privately declared this exact token under this exact name
    //    (`Length { Screen = "100vh" }`) because there was no kit one to use. A closed set that does not contain
    //    the commonest value in the corpus is not a vocabulary; it is a detour to a raw CSS string.
    // ⚠ `dvh`, NOT `vh`, and the difference is a real bug rather than a preference: on a phone `vh` is the height
    //    the browser WISHES it had, so a `100vh` page is clipped by the address bar. `Apps/docket` and
    //    `Apps/recall-osy` had each worked this out and switched by hand; the markdown kit's stylesheet says the
    //    same thing in CSS. Shipping the token with the known-broken unit would have enshrined the bug in the one
    //    spelling everybody copies.
    Screen    = "100dvh";    // the full viewport — what a login card centres in, and what a page shell fills

    // ⭐ TOUCH TARGETS. `Touch` is the WCAG 2.5.5 floor (44px) for anything a finger has to hit; `TouchDense` is
    //    the 40px a toolbar or a nav row may use when its neighbours are the same control and a miss lands on
    //    something harmless. They are `Length` rather than a group of their own so `minH: Length.Touch` reads like
    //    every other size on the page — the vocabulary a prop takes is the one it already takes.
    // ⚠ A MINIMUM, not a height. Write `minH: Length.Touch` and let the content decide the rest; `h: Length.Touch`
    //    on a row whose label wraps clips the second line.
    Touch      = "44px";
    TouchDense = "40px";
  }

  Shadow {
    // Tinted with the page's own ink rather than a blue-grey, so a shadow reads as depth on this ground and not as a
    // second colour. A menu gets a soft drop PLUS a one-pixel ring, which is what separates it from a white page.
    Raised   = "0 1px 2px rgba(8,20,19,.06), 0 0 0 1px rgba(8,20,19,.04)";
    Floating = "0 12px 32px -12px rgba(8,20,19,.30), 0 2px 6px rgba(8,20,19,.06), 0 0 0 1px rgba(8,20,19,.05)";
    Deep     = "0 32px 64px -24px rgba(8,20,19,.40), 0 0 0 1px rgba(8,20,19,.06)";
    Ring     = "0 0 0 3px color-mix(in srgb, var(--colors-focus) 35%, transparent)";
  }

  // THE MOTION VOCABULARY (floor.md §5): four durations, two curves, and nothing else anywhere. Out — decelerating —
  // for anything arriving or moving into place; In — accelerating — for anything leaving. `Fast` for a hover or a
  // press, `Normal` for a menu or a toggle, `Slow` for a panel or a rail changing width.
  Motion {
    Fast   = "all 90ms cubic-bezier(.2,.8,.2,1)";
    Normal = "all 160ms cubic-bezier(.2,.8,.2,1)";
    Slow   = "all 240ms cubic-bezier(.2,.8,.2,1)";
  }

  // ⚠ `Drawer` SITS BETWEEN `Overlay` AND `Modal`, and the order is the whole point: a nav drawer and a bottom
  //    sheet each slide in OVER a `Scrim` (which is `Overlay`) and must stay UNDER a `Dialog` (`Modal`). Without a
  //    step between them a shell has to pick one of two wrong answers — a drawer under its own scrim, or a drawer
  //    over the dialog that a nav item opened.
  ZIndex { Sticky = 100; Popover = 200; Overlay = 300; Drawer = 320; Modal = 400; Notification = 500; Tooltip = 600; }

  Breakpoints { Base = 0; Phone = 480; Tablet = 768; Laptop = 1100; Desktop = 1440; }
}
