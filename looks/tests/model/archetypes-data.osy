    new LogLine { At = "10:23:58", Level = "INFO",  Source = "pager",       Text = "INC-4821 paged Daniel Kim (primary, billing)" },
    new LogLine { At = "10:23:41", Level = "ERROR", Source = "billing-api", Text = "invoice.run account=0117 seats=486 timed out after 30000ms" },
    new LogLine { At = "10:22:10", Level = "INFO",  Source = "deploys",     Text = "billing-api 4.12.0 rolled out to eu-west-2 (3/3)" },
    new LogLine { At = "10:19:33", Level = "INFO",  Source = "exports",     Text = "customs.export batch 7 of 12 written (1,204 rows)" },
