// ── Studio — people and companies ───────────────────────────────────────────────────────────────────────────────────

enum Relationship {
  [Tone(Tone.Primary)] Customer,
  [Tone(Tone.Success)] Champion,
  [Tone(Tone.Warning)] Prospect,
  [Label("At risk"), Tone(Tone.Danger)] AtRisk,
}

class PersonRow {
  public string Name;
  public string Initials;
  public string Role;
  public string Company;
  public Relationship Relationship;
  public string LastTouch;
  public decimal Pipeline;
  public string City;
}

