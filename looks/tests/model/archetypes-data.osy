// The rows the five ARCHETYPES are built over — each look's default arrangement of a whole app (round 2). Fixed and in
// memory like the rest of the specimen, except one stored row per editing page: a save pattern is only honest over a
// real unit of work, so what each page edits is a `Draft` the tests write first.

using Osysharp.Ui;

/// What an archetype's page EDITS — one stored row per page, keyed by the page, so its Save / Discard / Undo (or its
/// auto-save) drive the route's real unit of work.
entity Draft {
  [Required, MaxLength(60)] string Key;
  [MaxLength(200)] string? Title;
  [MaxLength(200)] string? Owner;
  [MaxLength(600)] string? Note;
  int Days;
  bool Flag;
  security { allow read, create, update when IsAnonymous || IsAuthenticated; }
}

// ── Relay — an incident console ─────────────────────────────────────────────────────────────────────────────────────

enum Severity {
  [Label("SEV-1"), Tone(Tone.Danger)] Critical,
  [Label("SEV-2"), Tone(Tone.Warning)] Major,
  [Label("SEV-3"), Tone(Tone.Default)] Minor,
}

enum IncidentState {
  [Tone(Tone.Danger)] Investigating,
  [Tone(Tone.Warning)] Identified,
  [Tone(Tone.Primary)] Monitoring,
  [Tone(Tone.Success)] Resolved,
}

class IncidentRow {
  public string Id;
  public Severity Severity;
  public string Service;
  public string Title;
  public IncidentState State;
  public int Minutes;
  public string Owner;
  public string Region;
}

List<IncidentRow> Incidents() {
  return [
    new IncidentRow { Id = "INC-4821", Severity = Severity.Critical, Service = "billing-api", Title = "Invoice runs time out for accounts over 300 seats", State = IncidentState.Investigating, Minutes = 36, Owner = "Daniel Kim", Region = "eu-west-2" },
    new IncidentRow { Id = "INC-4820", Severity = Severity.Major, Service = "exports", Title = "Customs portal export stops at row 1,204", State = IncidentState.Identified, Minutes = 94, Owner = "Hannah Lowe", Region = "eu-west-2" },
    new IncidentRow { Id = "INC-4819", Severity = Severity.Major, Service = "mail-out", Title = "Payment reminders queued but not sent", State = IncidentState.Monitoring, Minutes = 132, Owner = "Priya Nair", Region = "us-east-1" },
    new IncidentRow { Id = "INC-4817", Severity = Severity.Minor, Service = "search", Title = "Account search slow for names with accents", State = IncidentState.Investigating, Minutes = 241, Owner = "Jonas Berg", Region = "eu-west-2" },
    new IncidentRow { Id = "INC-4816", Severity = Severity.Minor, Service = "web", Title = "Seat count wraps on the plan card in Safari", State = IncidentState.Identified, Minutes = 310, Owner = "Maya Okafor", Region = "global" },
    new IncidentRow { Id = "INC-4812", Severity = Severity.Major, Service = "ledger-sync", Title = "Bank feed duplicates two September payments", State = IncidentState.Monitoring, Minutes = 525, Owner = "Tomás Reyes", Region = "eu-west-2" },
    new IncidentRow { Id = "INC-4809", Severity = Severity.Minor, Service = "auth", Title = "Single sign-on certificate expires in 9 days", State = IncidentState.Identified, Minutes = 1440, Owner = "Ravi Shah", Region = "global" },
    new IncidentRow { Id = "INC-4801", Severity = Severity.Critical, Service = "billing-api", Title = "Card payments declined for 11 minutes", State = IncidentState.Resolved, Minutes = 2880, Owner = "Daniel Kim", Region = "us-east-1" },
  ];
}

string Age(int minutes) {
  if (minutes < 60) { return minutes.ToString() + "m"; }
  if (minutes < 1440) { return (minutes / 60).ToString() + "h " + (minutes % 60).ToString() + "m"; }
  return (minutes / 1440).ToString() + "d";
}

class LogLine {
  public string At;
  public string Level;
  public string Source;
  public string Text;
}

List<LogLine> EventLog() {
  return [
    new LogLine { At = "10:24:07", Level = "ERROR", Source = "billing-api", Text = "invoice.run account=0042 seats=310 timed out after 30000ms" },
