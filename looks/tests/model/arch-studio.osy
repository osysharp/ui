component StudioRenewalsPage() { render { EmptyState("Renewals this quarter", body: "Contracts ending before December."); } }

[Route("/studio/champions")] [Layout(StudioFrame)] [Title("Champions")] [Render(CSR)] [AllowAnonymous]
component StudioChampionsPage() { render { EmptyState("Champions", body: "The people who speak for you."); } }
