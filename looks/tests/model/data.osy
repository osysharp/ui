enum Stage { Lead, Qualified, Proposal, Won }

class DealCard {
  public string Title;
  public string Account;
  public decimal Value;
  public string Owner;
  public Stage Stage;
  public string Due;
  public bool Late;
}

List<DealCard> Deals() {
  return [
    new DealCard { Title = "Fleet tracking pilot", Account = "Kestrel Freight", Value = 24000m, Owner = "MO", Stage = Stage.Lead, Due = "18 Oct" },
    new DealCard { Title = "Second site", Account = "Linden Veterinary", Value = 4800m, Owner = "PN", Stage = Stage.Lead, Due = "22 Oct" },
    new DealCard { Title = "Records migration", Account = "Pemberton Clinics", Value = 61000m, Owner = "JB", Stage = Stage.Lead, Due = "3 Nov" },
    new DealCard { Title = "Upgrade to Business", Account = "Marlow Print Works", Value = 7200m, Owner = "JB", Stage = Stage.Qualified, Due = "14 Oct", Late = true },
    new DealCard { Title = "Regional rollout", Account = "Sable Logistics", Value = 38500m, Owner = "PN", Stage = Stage.Qualified, Due = "29 Oct" },
    new DealCard { Title = "Renewal, three years", Account = "Brightwater Dental Group", Value = 145800m, Owner = "MO", Stage = Stage.Proposal, Due = "20 Oct" },
