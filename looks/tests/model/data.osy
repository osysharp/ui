class ConversationRow {
  public string From;
  public string Initials;
  public string Company;
  public string Subject;
  public string Snippet;
  public string When;
  public bool Unread;
  public string Tag;
  public Tone TagTone;
}

List<ConversationRow> Conversations() {
  return [
    new ConversationRow { From = "Hannah Lowe", Initials = "HL", Company = "Kestrel Freight", Subject = "Export to the customs portal fails at row 1,204", Snippet = "We tried again this morning and it stops at the same row. The file is attached.", When = "09:41", Unread = true, Tag = "Urgent", TagTone = Tone.Danger },
    new ConversationRow { From = "Daniel Osei", Initials = "DO", Company = "Pemberton Clinics", Subject = "Can we add twelve seats before Monday?", Snippet = "Our new intake starts on Monday and they will need access from the first day.", When = "09:12", Unread = true, Tag = "Billing", TagTone = Tone.Primary },
    new ConversationRow { From = "Sofia Marin", Initials = "SM", Company = "Brightwater Dental Group", Subject = "Renewal paperwork", Snippet = "Thanks for the proposal. Legal has two small questions about clause 7.", When = "08:55", Unread = false, Tag = "Sales", TagTone = Tone.Success },
    new ConversationRow { From = "Ravi Shah", Initials = "RS", Company = "Sable Logistics", Subject = "Single sign-on for the Glasgow office", Snippet = "Our identity team is ready to set it up. Which certificate do you need?", When = "Yesterday", Unread = false, Tag = "Setup", TagTone = Tone.Default },
    new ConversationRow { From = "Ellen Price", Initials = "EP", Company = "Northgate Property Services", Subject = "Invoice INV-20311 is not what we agreed", Snippet = "The September invoice charges for 40 seats, but we reduced to 36 in August.", When = "Yesterday", Unread = false, Tag = "Billing", TagTone = Tone.Primary },
    new ConversationRow { From = "Marcus Webb", Initials = "MW", Company = "Marlow Print Works", Subject = "Thank you", Snippet = "Just a note to say the new scheduling view has saved us an hour a day.", When = "Tue", Unread = false, Tag = "", TagTone = Tone.Default },
    new ConversationRow { From = "Aiko Tanaka", Initials = "AT", Company = "Linden Veterinary", Subject = "Trial ends on Friday", Snippet = "We would like to continue. Can the trial be extended until our board meets?", When = "Mon", Unread = false, Tag = "Sales", TagTone = Tone.Success },
    new ConversationRow { From = "Lucas Moreau", Initials = "LM", Company = "Fenwick & Hale Architects", Subject = "Payment reminder received", Snippet = "Our accounts team paid this on the 3rd. Could you check the remittance?", When = "Mon", Unread = false, Tag = "Billing", TagTone = Tone.Primary },
  ];
}

class ActivityRow {
  public string Who;
  public string Initials;
  public string What;
  public string When;
}

List<ActivityRow> AccountActivity() {
  return [
    new ActivityRow { Who = "Maya Okafor", Initials = "MO", What = "logged a call: agreed the renewal terms in principle", When = "Today, 11:20" },
    new ActivityRow { Who = "System", Initials = "··", What = "issued invoice INV-20418 for £15,500.00", When = "1 Oct" },
    new ActivityRow { Who = "Sofia Marin", Initials = "SM", What = "opened the renewal proposal (3rd time)", When = "29 Sep" },
    new ActivityRow { Who = "Jonas Berg", Initials = "JB", What = "added 20 seats for the Pemberton contract", When = "28 Sep" },
  ];
}

