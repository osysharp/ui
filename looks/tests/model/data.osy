// The specimen's rows — fixed, in memory, built by plain functions. Nothing is stored: a look is judged on the same
// words and numbers every time, so two photographs differ only in the look.

using Osysharp.Ui;

app.DefaultCulture = "en-GB";

enum AccountStatus {
  [Tone(Tone.Success)] Active,
  [Tone(Tone.Primary)] Trial,
  [Tone(Tone.Warning)] Overdue,
  [Label("On hold"), Tone(Tone.Ghost)] OnHold,
  [Tone(Tone.Danger)] Cancelled,
}

enum Plan { Starter, Team, Business, Enterprise }

class AccountRow {
  public string Key;
  public string Name;
  public string Owner;
  public string OwnerInitials;
  public string City;
  public Plan Plan;
  public AccountStatus Status;
  public decimal Annual;
  public decimal Balance;
  public int Seats;
  public string LastActivity;
}

