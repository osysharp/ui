class InvoiceRow {
  public string Number;
  public string Issued;
  public string Due;
  public decimal Amount;
  public AccountStatus Status;
}

List<InvoiceRow> Invoices() {
  return [
    new InvoiceRow { Number = "INV-20418", Issued = "1 Oct 2026", Due = "31 Oct 2026", Amount = 15500m, Status = AccountStatus.Trial },
    new InvoiceRow { Number = "INV-20307", Issued = "1 Sep 2026", Due = "1 Oct 2026", Amount = 15500m, Status = AccountStatus.Active },
    new InvoiceRow { Number = "INV-20196", Issued = "1 Aug 2026", Due = "31 Aug 2026", Amount = 15500m, Status = AccountStatus.Active },
