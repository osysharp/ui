  return [
    new AccountRow { Key = "brightwater", Name = "Brightwater Dental Group", Owner = "Maya Okafor", OwnerInitials = "MO", City = "Leeds", Plan = Plan.Business, Status = AccountStatus.Active, Annual = 48600m, Balance = 0m, Seats = 42, LastActivity = "2 hours ago" },
