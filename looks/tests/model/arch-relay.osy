component RelayResolvedPage() { render { Stack(p: 4) { EmptyState("Resolved incidents", body: "The last ninety days."); } } }

[Route("/relay/deploys")] [Layout(RelayFrame)] [Title("Deploys")] [Render(CSR)] [AllowAnonymous]
component RelayDeploysPage() { render { Stack(p: 4) { EmptyState("Deploys", body: "Every rollout, region by region."); } } }

[Route("/relay/services")] [Layout(RelayFrame)] [Title("Services")] [Render(CSR)] [AllowAnonymous]
component RelayServicesPage() { render { Stack(p: 4) { EmptyState("Services", body: "What runs, where, and who owns it."); } } }

[Route("/relay/logs")] [Layout(RelayFrame)] [Title("Logs")] [Render(CSR)] [AllowAnonymous]
component RelayLogsPage() { render { Stack(p: 4) { EmptyState("Logs", body: "Search every line from every service."); } } }
