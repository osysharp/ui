  Ui.Shot("inbox · wide · light");
  Ui.Theme("dark");
  Ui.Visit("/inbox");
  Assert.Readable("Daniel Osei");
  Ui.Shot("inbox · wide · dark");
  Ui.Theme("light");
  Ui.Viewport(390, 844);
  Ui.Visit("/inbox");
  Ui.Shot("inbox · phone · light");
}

[Test]
void form_in_every_state() {
  Ui.Viewport(1440, 960);
  Ui.Visit("/accounts/new");
  Assert.Visible("Required for companies in the UK.");
  Assert.Readable("Required for companies in the UK.");
  Ui.Shot("form · wide · light");
  Ui.Theme("dark");
  Ui.Visit("/accounts/new");
  Assert.Readable("Required for companies in the UK.");
  Ui.Shot("form · wide · dark");
  Ui.Theme("light");
  Ui.Viewport(390, 844);
  Ui.Visit("/accounts/new");
  Ui.Shot("form · phone · light");
}

[Test]
void settings() {
  Ui.Viewport(1440, 960);
  Ui.Visit("/settings");
  Assert.Visible("Send payment reminders");
  Ui.Shot("settings · wide · light");
  Ui.Theme("dark");
  Ui.Visit("/settings");
  Ui.Shot("settings · wide · dark");
}

[Test]
void empty_states_dialog_and_toast() {
  Ui.Viewport(1440, 960);
  Ui.Visit("/imports");
  Assert.Dialog("Replace existing accounts?");
  Ui.Shot("imports · dialog · wide · light");
  Ui.Click("Keep existing");
  Assert.Visible("No imports yet");
  Ui.Shot("imports · empty · wide · light");
  Ui.Theme("dark");
  Ui.Visit("/imports");
  Ui.Shot("imports · dialog · wide · dark");
  Ui.Theme("light");
  Ui.Viewport(390, 844);
  Ui.Visit("/imports");
  Ui.Shot("imports · dialog · phone · light");
}
