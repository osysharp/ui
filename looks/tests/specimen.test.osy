  Ui.Shot("board · wide · light");
  Ui.Theme("dark");
  Ui.Visit("/pipeline");
  Ui.Shot("board · wide · dark");
}

[Test]
void inbox() {
  Ui.Viewport(1440, 960);
  Ui.Visit("/inbox");
  Assert.Visible("Export to the customs portal fails at row 1,204");
