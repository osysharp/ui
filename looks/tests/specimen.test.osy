// The specimen, photographed. `osy test --pixels` writes every shot below — each page wide and on a phone, light and
// dark — for whichever look the run wears (`--theme looks/<look>.osy`). The assertions only make sure the page being
// photographed is the one meant, and that its words can be read on the ground the look painted.

[Test]
void overview() {
  Ui.Viewport(1440, 960);
  Ui.Visit("/");
  Assert.Visible("Revenue against plan");
  Assert.Readable("Good morning, Maya");
  Assert.Readable("recurring revenue");
  Ui.Shot("overview · wide · light");
  Ui.Theme("dark");
  Ui.Visit("/");
  Assert.Readable("Good morning, Maya");
  Ui.Shot("overview · wide · dark");
  Ui.Theme("light");
  Ui.Viewport(390, 844);
  Ui.Visit("/");
  Ui.Shot("overview · phone · light");
}

[Test]
void accounts_table() {
  Ui.Viewport(1440, 960);
  Ui.Visit("/accounts");
  Assert.Visible("Kestrel Freight");
  Assert.Readable("Northgate Property Services");
  Ui.Shot("accounts · wide · light");
  Ui.Theme("dark");
  Ui.Visit("/accounts");
  Assert.Readable("Northgate Property Services");
  Ui.Shot("accounts · wide · dark");
  Ui.Theme("light");
  Ui.Viewport(390, 844);
  Ui.Visit("/accounts");
  Ui.Shot("accounts · phone · light");
}

[Test]
void record() {
  Ui.Viewport(1440, 960);
  Ui.Visit("/accounts/kestrel");
  Assert.Visible("INV-20418");
  Assert.Readable("Account owner");
  Ui.Shot("record · wide · light");
  Ui.Theme("dark");
  Ui.Visit("/accounts/kestrel");
  Assert.Readable("Account owner");
  Ui.Shot("record · wide · dark");
}

[Test]
void board() {
  Ui.Viewport(1440, 960);
