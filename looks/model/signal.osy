// Signal — for the numbers that run a business: analytics, reporting, dashboards, growth and marketing tools.
//
// The idea: an instrument panel. The chrome is ink — a dark rail beside a light, cool page, in both modes — so the
// eye goes to the data, and every figure is set tall in a condensed face that fits a big number in a small card. Cards
// sit on the page without an outline; colour belongs to the charts, and the one accent is an ultraviolet kept for what
// to press and where you are.
//
// Taken from: Stripe's dashboard (a calm cool-grey page, figures as headlines, cards without heavy rules); Amplitude
// and Mixpanel (a dark navigation rail beside a light analysis canvas, a violet accent); Plausible (one figure per
// tile, the change beside it, nothing else in the card).

namespace Osysharp.Ui.Looks;

/// Signal — the instrument panel: an ink rail beside a light page, figures set tall in Sofia Sans Condensed, cards
/// without an outline, an ultraviolet accent. For analytics, reporting and dashboards.
/// Arranged as: the command centre — an ink rail of marks, the time range above the numbers, a workspace of cards a
/// person arranges for themselves, and an assistant to ask about them — `RailShell`, `WidgetGrid`, `Widget`, `AssistantPanel`.
public abstract theme Signal {
  Colors {
    Bg            = Modes.Of(light: "#F2F3F7", dark: "#0C0D12");
    OnBg          = Modes.Of(light: "#14151C", dark: "#E9E9F0");
    Surface       = Modes.Of(light: "#FFFFFF", dark: "#15161D");
    OnSurface     = Modes.Of(light: "#14151C", dark: "#E9E9F0");
    Elevated      = Modes.Of(light: "#FFFFFF", dark: "#1C1D26");
    Sunken        = Modes.Of(light: "#EAECF1", dark: "#09090D");
    Muted         = Modes.Of(light: "#EDEEF3", dark: "#22232D");
    Border        = Modes.Of(light: "#DADCE4", dark: "#2A2B36");
    // Cards are not outlined: the edge is the card's own colour, and the page around it does the separating.
    CardLine      = Modes.Of(light: "#FFFFFF", dark: "#15161D");
    TextSecondary = Modes.Of(light: "#383A47", dark: "#BDBECC");
    TextMuted     = Modes.Of(light: "#5C5F70", dark: "#9093A5");
    BorderDanger  = Modes.Of(light: "#D0263C", dark: "#FF6B81");
    // THE ACCENT: an ultraviolet — a purple deep enough to carry white words, and a light lavender at night.
    Primary       = Modes.Of(light: Palette.From("#6A3BE4"), dark: Palette.From("#A889FF"));
    OnPrimary     = Modes.Of(light: "#FFFFFF", dark: "#170A3A");
    Focus         = Modes.Of(light: "#6A3BE4", dark: "#B9A0FF");
    Success       = Modes.Of(light: Palette.From("#0A7D55"), dark: Palette.From("#3CCB93"));
    Danger        = Modes.Of(light: Palette.From("#D0263C"), dark: Palette.From("#FF6B81"));
    Warning       = Modes.Of(light: Palette.From("#9A6200"), dark: Palette.From("#F5C04F"));
    Waiting       = Modes.Of(light: "#4F6890", dark: "#9AB0D6");
    Scrim         = Modes.Of(light: "rgba(12,13,18,.45)", dark: "rgba(0,0,0,.66)");
    // THE INK RAIL — the same near-black in both modes, with its own words, its own lines and a violet current row.
    Chrome          = Modes.Of(light: "#14151C", dark: "#08080B");
    OnChrome        = Modes.Of(light: "#F1F1F6", dark: "#F1F1F6");
    ChromeMuted     = Modes.Of(light: "#B7B9C8", dark: "#B0B2C1");
    ChromeFaint     = Modes.Of(light: "#9497AA", dark: "#8F92A5");
    ChromeHover     = Modes.Of(light: "#22232D", dark: "#16171E");
    ChromeSunken    = Modes.Of(light: "#1C1D26", dark: "#121319");
    ChromeElevated  = Modes.Of(light: "#1C1D26", dark: "#16171E");
    ChromeLine      = Modes.Of(light: "#272834", dark: "#1A1B23");
    ChromeCurrent   = Modes.Of(light: "#2E2552", dark: "#251D47");
    OnChromeCurrent = Modes.Of(light: "#FFFFFF", dark: "#FFFFFF");
    ChromeFocus     = Modes.Of(light: "#C2ACFF", dark: "#C2ACFF");
    // The data carries the colour here: ultraviolet for the figure, a sea-green for what it is measured against.
  }
  Font {
    Sans    = "\"Sofia Sans\", ui-sans-serif, system-ui, sans-serif";
    Display = "\"Sofia Sans Condensed\", \"Sofia Sans\", ui-sans-serif, system-ui, sans-serif";
    Mono    = "\"Spline Sans Mono\", ui-monospace, SFMono-Regular, Menlo, monospace";
    // Figures tall and condensed: a big number in a small tile.
    Figure  = "\"Sofia Sans Condensed\", \"Sofia Sans\", ui-sans-serif, system-ui, sans-serif";
  }
  FontSize   { Caption = "12.5px"; Label = "13.5px"; Body = "14.5px"; Subhead = "17px"; Heading = "22px"; Title = "34px"; Code = "13px"; }
  FontWeight { Regular = 400; Medium = 540; Semibold = 660; Bold = 760; Headings = 700; }
  Radius     { Sm = "6px"; Md = "8px"; Lg = "12px"; Pill = "999px"; Tag = "5px"; }
  Space      { Step = "0.25rem"; Gutter = "1rem"; PagePad = "1.75rem"; SectionGap = "2.5rem"; FieldGap = "0.375rem"; }
  Length     { ControlSm = "32px"; ControlMd = "36px"; ControlLg = "44px"; Touch = "40px"; TouchDense = "36px"; RailW = "236px"; AppBarH = "56px"; }
  // A card is lifted off the page by a soft, low shadow instead of a rule.
  Shadow {
    Raised   = "0 1px 2px rgba(20,21,28,.06), 0 4px 14px -6px rgba(20,21,28,.10)";
    Floating = "0 14px 36px -12px rgba(20,21,28,.30), 0 0 0 1px rgba(20,21,28,.06)";
    Deep     = "0 30px 70px -24px rgba(20,21,28,.42), 0 0 0 1px rgba(20,21,28,.06)";
  }
}
