// Studio — for work about people and projects: CRM, agencies, recruiting, project tools, anything whose rows are
// relationships.
//
// The idea: the workbench. A friendly, open grotesk; ink-black for what you press; soft surfaces with generous corners;
// and colour where the people and their states are — tags and avatars — rather than in the chrome. It should feel like
// a well-made tool somebody chose, not a back office.
//
// Taken from: Attio (ink-black primary buttons, a white page and a soft grey rail, colour only in objects and tags);
// Twenty (records as quiet tables of chips); Notion and Folk (soft corners, an unhurried density, labels in sentence
// case).

namespace Osysharp.Ui.Looks;

/// Studio — the workbench: Figtree, ink-black actions, soft grey chrome, round corners and pill tags, colour kept for
/// people and states. For CRM, agencies and project tools.
public abstract theme Studio {
  Colors {
    Bg            = Modes.Of(light: "#FFFFFF", dark: "#141416");
    OnBg          = Modes.Of(light: "#18181B", dark: "#ECECEE");
    Surface       = Modes.Of(light: "#FFFFFF", dark: "#1B1B1E");
    OnSurface     = Modes.Of(light: "#18181B", dark: "#ECECEE");
    Elevated      = Modes.Of(light: "#FFFFFF", dark: "#232327");
    Sunken        = Modes.Of(light: "#F6F6F7", dark: "#101012");
    Muted         = Modes.Of(light: "#F1F1F3", dark: "#28282D");
    Border        = Modes.Of(light: "#E4E4E8", dark: "#2E2E34");
    CardLine      = Modes.Of(light: "#EAEAEE", dark: "#2A2A30");
    TextSecondary = Modes.Of(light: "#3F3F46", dark: "#C4C4CB");
    TextMuted     = Modes.Of(light: "#63636D", dark: "#9696A0");
    BorderDanger  = Modes.Of(light: "#D92D20", dark: "#F97066");
    // THE ACTION IS INK: black on white, white on black. Colour is for the things on the bench, not the tools.
    Primary       = Modes.Of(light: Palette.From("#18181B"), dark: Palette.From("#F4F4F5"));
    OnPrimary     = Modes.Of(light: "#FFFFFF", dark: "#18181B");
    // …so focus gets a colour of its own, a cobalt that is seen against ink and paper alike.
    Focus         = Modes.Of(light: "#2F5BEA", dark: "#7C9BFF");
    Success       = Modes.Of(light: Palette.From("#14804A"), dark: Palette.From("#4ADE80"));
    Danger        = Modes.Of(light: Palette.From("#D92D20"), dark: Palette.From("#F97066"));
    Warning       = Modes.Of(light: Palette.From("#B54708"), dark: Palette.From("#FDB022"));
    Waiting       = Modes.Of(light: "#6941C6", dark: "#B692F6");
    Scrim         = Modes.Of(light: "rgba(24,24,27,.32)", dark: "rgba(0,0,0,.6)");
    // A soft grey rail beside a white page; the row you are on is lifted white, as on a real bench.
    Chrome          = Modes.Of(light: "#F7F7F8", dark: "#111113");
    OnChrome        = Modes.Of(light: "#18181B", dark: "#ECECEE");
    ChromeMuted     = Modes.Of(light: "#3F3F46", dark: "#C4C4CB");
    ChromeFaint     = Modes.Of(light: "#63636D", dark: "#9696A0");
    ChromeHover     = Modes.Of(light: "#EDEDF0", dark: "#1C1C20");
    ChromeSunken    = Modes.Of(light: "#FFFFFF", dark: "#1B1B1E");
    ChromeElevated  = Modes.Of(light: "#FFFFFF", dark: "#232327");
    ChromeLine      = Modes.Of(light: "#EBEBEE", dark: "#222226");
    ChromeCurrent   = Modes.Of(light: "#FFFFFF", dark: "#26262B");
    OnChromeCurrent = Modes.Of(light: "#18181B", dark: "#FFFFFF");
    ChromeFocus     = Colors.Focus;
    // A chart in ink, against the cobalt focus colour — the bench's two tools.
    Series1       = Modes.Of(light: Palette.From("#27272A"), dark: Palette.From("#E4E4E7"));
    Series2       = Modes.Of(light: Palette.From("#2F5BEA"), dark: Palette.From("#7C9BFF"));
    ChartSurface  = Colors.Surface;
    ChartBorder   = Colors.CardLine;
    ChartGrid     = Colors.Muted;
    ChartInk      = Colors.OnSurface;
    ChartMuted    = Colors.TextMuted;
    ChartTipBg    = Colors.OnSurface;
    ChartTipInk   = Colors.Surface;
  }
  Font {
    Sans    = "\"Figtree\", ui-sans-serif, system-ui, sans-serif";
    Display = "\"Figtree\", ui-sans-serif, system-ui, sans-serif";
    Mono    = "\"Fragment Mono\", ui-monospace, SFMono-Regular, Menlo, monospace";
    Figure  = "\"Figtree\", ui-sans-serif, system-ui, sans-serif";
  }
  FontSize   { Caption = "12px"; Label = "13px"; Body = "14px"; Subhead = "16px"; Heading = "20px"; Title = "26px"; Code = "13px"; }
  FontWeight { Regular = 420; Medium = 540; Semibold = 650; Bold = 750; Headings = 650; }
  Radius     { Sm = "6px"; Md = "9px"; Lg = "14px"; Pill = "999px"; Tag = "999px"; }
  Space      { Step = "0.25rem"; Gutter = "1rem"; PagePad = "1.75rem"; SectionGap = "2.5rem"; FieldGap = "0.4rem"; }
  Length     { ControlSm = "32px"; ControlMd = "38px"; ControlLg = "46px"; Touch = "42px"; TouchDense = "36px"; RailW = "252px"; AppBarH = "54px"; }
  // Soft, close shadows: a card sits on the bench rather than floating above it.
  Shadow {
    Raised   = "0 1px 2px rgba(24,24,27,.05), 0 1px 1px rgba(24,24,27,.03)";
    Floating = "0 12px 32px -10px rgba(24,24,27,.22), 0 2px 6px rgba(24,24,27,.06), 0 0 0 1px rgba(24,24,27,.06)";
    Deep     = "0 30px 64px -20px rgba(24,24,27,.32), 0 0 0 1px rgba(24,24,27,.06)";
  }
}
