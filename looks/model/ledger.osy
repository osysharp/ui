// Ledger — for the books: finance, billing, accounting, procurement, anything people read in columns of figures.
//
// The idea: a statement you trust. White paper, hairline rules instead of shadows, headings at an ordinary weight so
// the figures carry the weight, and every number in a mono whose digits line up under each other. One accent — a
// Prussian navy, the ink a ledger is signed in — on what to press and where you are. Green and red keep their one job:
// money in, money out.
//
// Taken from: Mercury's dashboard (headings at a regular weight, money as the largest thing on the page, cards that are
// a hairline rather than a shadow); IBM's Carbon data table (rectangular controls, a compact row, structure from
// rules); Ramp (one accent, used only on the action, and figures set in their own face).

namespace Osysharp.Ui.Looks;

/// Ledger — white paper, hairline rules, figures in a mono that lines up, a Prussian-navy accent. For finance,
/// billing and accounting, and anything read in columns of numbers.
public abstract theme Ledger {
  Colors {
    Bg            = Modes.Of(light: "#FFFFFF", dark: "#0D1015");
    OnBg          = Modes.Of(light: "#121821", dark: "#E3E8EF");
    Surface       = Modes.Of(light: "#FFFFFF", dark: "#12161D");
    OnSurface     = Modes.Of(light: "#121821", dark: "#E3E8EF");
    Elevated      = Modes.Of(light: "#FFFFFF", dark: "#181D26");
    Sunken        = Modes.Of(light: "#F6F7F9", dark: "#0A0D11");
    Muted         = Modes.Of(light: "#EFF2F5", dark: "#1B212B");
    Border        = Modes.Of(light: "#DCE1E7", dark: "#252C37");
    CardLine      = Modes.Of(light: "#DCE1E7", dark: "#252C37");
    TextSecondary = Modes.Of(light: "#353F4C", dark: "#BAC3CF");
    TextMuted     = Modes.Of(light: "#5A6575", dark: "#8E99A8");
    BorderDanger  = Modes.Of(light: "#C4321F", dark: "#F0705E");
    // THE ACCENT: a Prussian navy on paper; on the dark ground a clear sky-ink, since navy would vanish there.
    Primary       = Modes.Of(light: Palette.From("#1F4E89"), dark: Palette.From("#86B6F2"));
    OnPrimary     = Modes.Of(light: "#FFFFFF", dark: "#0A1830");
    Focus         = Modes.Of(light: "#1F4E89", dark: "#86B6F2");
    // Money in and money out — the two colours an accountant reads before the number.
    Success       = Modes.Of(light: Palette.From("#0F7049"), dark: Palette.From("#4CC38F"));
    Danger        = Modes.Of(light: Palette.From("#B3261E"), dark: Palette.From("#F2756C"));
    Warning       = Modes.Of(light: Palette.From("#8A5A00"), dark: Palette.From("#E5B451"));
    Waiting       = Modes.Of(light: "#5A5D8C", dark: "#A6A9D2");
    Scrim         = Modes.Of(light: "rgba(14,20,28,.40)", dark: "rgba(0,0,0,.64)");
    // The chrome sits on the same paper as the page, a shade cooler, and divided from it by a rule.
    Chrome          = Modes.Of(light: "#F8F9FB", dark: "#0F131A");
    OnChrome        = Modes.Of(light: "#121821", dark: "#E3E8EF");
    ChromeMuted     = Modes.Of(light: "#3F4957", dark: "#B3BCC8");
    ChromeFaint     = Modes.Of(light: "#5A6575", dark: "#8E99A8");
    ChromeHover     = Modes.Of(light: "#EDF0F4", dark: "#1A2029");
    ChromeSunken    = Modes.Of(light: "#FFFFFF", dark: "#141920");
    ChromeElevated  = Modes.Of(light: "#FFFFFF", dark: "#181D26");
    ChromeLine      = Modes.Of(light: "#E2E6EB", dark: "#212833");
    ChromeCurrent   = Modes.Of(light: "#E5ECF6", dark: "#1A2A40");
    OnChromeCurrent = Modes.Of(light: "#173C6B", dark: "#B9D5F7");
    ChromeFocus     = Colors.Focus;
  }
  Font {
    Sans    = "\"Wix Madefor Text\", ui-sans-serif, system-ui, sans-serif";
    Display = "\"Wix Madefor Display\", \"Wix Madefor Text\", ui-sans-serif, system-ui, sans-serif";
    Mono    = "\"DM Mono\", ui-monospace, SFMono-Regular, Menlo, monospace";
    // Every statistic and every number column in the mono: a ledger's figures line up digit under digit.
    Figure  = "\"DM Mono\", ui-monospace, SFMono-Regular, Menlo, monospace";
  }
  FontSize   { Caption = "12px"; Label = "13px"; Body = "14px"; Subhead = "15px"; Heading = "19px"; Title = "28px"; Code = "13px"; }
  // Headings are NOT heavy here: the figure on the page is the heaviest thing on it.
  FontWeight { Regular = 400; Medium = 500; Semibold = 600; Bold = 680; Headings = 500; }
  Radius     { Sm = "3px"; Md = "4px"; Lg = "6px"; Pill = "999px"; Tag = "3px"; }
  Space      { Step = "0.235rem"; Gutter = "1rem"; PagePad = "1.75rem"; SectionGap = "2.25rem"; FieldGap = "0.375rem"; }
  Length     { ControlSm = "30px"; ControlMd = "36px"; ControlLg = "44px"; Touch = "40px"; TouchDense = "34px"; RailW = "244px"; AppBarH = "52px"; }
  // A hairline does the work a shadow does elsewhere — only what floats over the page casts one.
  Shadow {
    Raised   = "none";
    Floating = "0 10px 30px -12px rgba(16,24,40,.28), 0 0 0 1px rgba(16,24,40,.08)";
    Deep     = "0 28px 60px -24px rgba(16,24,40,.38), 0 0 0 1px rgba(16,24,40,.08)";
  }
}
